              Directions
            </span>
            <span class="text-zinc-700 line-through flex items-center">
              <svg class="w-3.5 h-3.5 inline mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21V9.75M3.284 14.253A8.996 8.996 0 0 1 12 3.75c3.55 0 6.64 2.06 8.116 5.076M3.284 14.253a8.996 8.996 0 0 0 8.716 6.497m-8.716-6.497h17.432M21 9.75H3" /></svg>
              Website (Not Available)
            </span>
          </div>
        </div>
      </div>
      
      <div class="flex flex-col justify-between p-8 rounded-3xl border-2 border-brand-primary bg-brand-primary/5 shadow-xl shadow-brand-primary/5 relative with-col z-10">
        <div class="absolute top-0 right-8 -translate-y-1/2 bg-brand-primary text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider z-10">
          Winning Path
        </div>
        
        <div>
          <span class="trust-reveal inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold bg-brand-accent/10 text-brand-accent border border-brand-accent/20 mb-6">
            <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            With a Professional Website
          </span>
          <h3 class="trust-reveal text-xl font-bold text-white mb-6">Found, understood, and booked</h3>
          
          <ul class="trust-reveal space-y-4 text-sm text-zinc-200">
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-brand-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Services, galleries, and pricing are visible instantly. Friction is zero.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-brand-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>WhatsApp and call buttons are one tap away, allowing immediate bookings.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-brand-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Highlights your best Google reviews and displays active customer testimonials.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-brand-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Fully responsive and loads in under 100ms so visitors never get frustrated.</span>
            </li>
          </ul>
        </div>
        
        <div class="trust-reveal mt-8 p-4 rounded-2xl bg-zinc-900 border border-zinc-700/50 text-[11px] font-sans space-y-2 select-none relative bg-ink-950">
          <div class="font-bold text-white">Dental Clinic Near Noida Sec 62</div>
          <div class="flex items-center gap-1.5 text-zinc-300">
            <span class="text-amber-400 text-xs">★★★★★</span>
            <span>4.9 (480 reviews) · Open 24/7</span>
          </div>
          <div class="w-full h-px bg-zinc-800 my-1"></div>
          <div class="flex gap-4">
            <span class="text-brand-primary font-semibold flex items-center">
              <svg class="w-3.5 h-3.5 inline mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
              Call
            </span>
            <span class="text-brand-primary font-semibold flex items-center">
              <svg class="w-3.5 h-3.5 inline mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.82c-.317-.159-.69-.159-1.006 0L3.622 6.32c-.381.19-.622.58-.622 1.006v12.78c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.159.69.159 1.006 0Z" /></svg>
              Directions
            </span>
            <span class="text-brand-accent font-bold cursor-pointer flex items-center">
              <svg class="w-3.5 h-3.5 inline mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21V9.75M3.284 14.253A8.996 8.996 0 0 1 12 3.75c3.55 0 6.64 2.06 8.116 5.076M3.284 14.253a8.996 8.996 0 0 0 8.716 6.497m-8.716-6.497h17.432M21 9.75H3" /></svg>
              Website (Ready)
            </span>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  let ctx;

  function initTrustGap() {
    gsap.registerPlugin(ScrollTrigger);
    
    const section = document.querySelector('.trust-gap');
    if (!section) return;

    
    ctx = gsap.context(() => {
      
      const mm = gsap.matchMedia();
      
      mm.add("(min-width: 768px)", () => {
        
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "center center", 
            end: "+=800",           
            pin: true,              
            scrub: 1,               
          }
        });

        
        tl.from(".trust-reveal", {
          y: 60,
          opacity: 0,
          stagger: 0.15,
          duration: 1,
          ease: "power2.out"
        });
      });

    }, section);
  }

  
  document.addEventListener('astro:page-load', initTrustGap);
  
  document.addEventListener('astro:before-swap', () => {
    
    if (ctx) ctx.revert(); 
  });
</script>