---
/**
 * PatientJourney.astro — Dentist Premium tier
 * Step-by-step patient experience narrative
 */
---

<section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-teal-500/10 text-teal-600 border border-teal-500/20 uppercase tracking-wider mb-4">Your Experience</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">What to Expect</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4 max-w-lg mx-auto">From the moment you walk in to post-treatment care, we prioritize your comfort.</p>
    </div>

    <div class="space-y-6">
      {[
        { title: 'Arrival & Welcome', desc: 'Our reception team greets you, handles paperwork digitally, and offers refreshments in our comfortable lounge.', time: '10 mins' },
        { title: 'Consultation & Scanning', desc: 'Meet your dentist, discuss concerns, and undergo comprehensive digital scans for accurate diagnosis.', time: '20 mins' },
        { title: 'Treatment Plan', desc: 'Receive a clear treatment plan with costs, timelines, and payment options. No surprises.', time: '10 mins' },
        { title: 'Treatment', desc: 'Comfortable treatment with modern equipment, gentle techniques, and in-chair entertainment options.', time: 'Varies' },
        { title: 'Post-Care & Follow-up', desc: 'Detailed care instructions, medication if needed, and follow-up scheduling before you leave.', time: '5 mins' },
      ].map((item, i) => (
        <div class="flex gap-6 items-start">
          <div class="w-10 h-10 rounded-full bg-teal-500/10 border border-teal-500/20 flex items-center justify-center flex-shrink-0">
            <span class="text-sm font-bold text-teal-600">{i + 1}</span>
          </div>
          <div class="flex-grow pb-6 border-b border-[var(--border-color)]">
            <div class="flex justify-between items-start">
              <h4 class="text-sm font-bold text-[var(--text-color)] font-display">{item.title}</h4>
              <span class="text-[10px] font-bold text-teal-600 bg-teal-500/10 px-2 py-0.5 rounded-full">{item.time}</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] mt-1">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
