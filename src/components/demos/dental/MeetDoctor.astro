---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center max-w-5xl mx-auto">
      
      <!-- Doctor Portrait -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative w-72 aspect-[4/5] rounded-[32px] overflow-hidden shadow-xl border border-ink-border group bg-ink-900">
          <img 
            src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=500&q=80" 
            alt="Dr. Neha Sen - MDS Endodontist Noida" 
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 inset-x-6 p-3 rounded-xl bg-ink-950/60 backdrop-blur-md border border-ink-border text-center">
            <span class="text-xs font-bold text-white block">Dr. Neha Sen, MDS</span>
            <span class="text-[9px] text-brand-accent font-semibold block mt-0.5">Senior Endodontist & Oral Surgeon</span>
          </div>
        </div>
      </div>

      <!-- Doctor Bio -->
      <div class="lg:col-span-7 space-y-6">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block font-sans">
          Our Specialist
        </span>
        <h3 class="text-2xl lg:text-3xl font-extrabold text-themeText tracking-tight font-display">
          Meet Dr. Neha Sen
        </h3>
        <p class="text-xs sm:text-sm text-themeTextMuted leading-relaxed">
          Dr. Neha Sen completed her Master of Dental Surgery (MDS) from King George's Medical University (KGMU) and has spent over 9 years performing specialized microscopic root canal treatments and smile styling surgeries. 
        </p>
        <p class="text-xs sm:text-sm text-themeTextMuted leading-relaxed">
          She is a registered member of the Indian Dental Association (IDA) and focuses on digital clinic techniques, ensuring that every crown, filling, and cosmetic aligner is customized under high precision for optimal dental health.
        </p>
        
        <!-- Credential lists -->
        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-ink-border/50 text-[10px] text-themeTextMuted font-sans">
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span>BDS, MDS (Endodontics)</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span>9+ Years Clinical Practice</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span>Microscopic RCT Specialist</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span>IDA Active Dental Member</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
