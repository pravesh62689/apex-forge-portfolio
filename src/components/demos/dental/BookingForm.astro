---
---

<section id="booking" class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-xl mx-auto px-4">
    <div class="bg-ink-900 border border-ink-border rounded-3xl p-8 lg:p-10 shadow-xl space-y-6">
      <div class="text-center space-y-2">
        <h3 class="text-xl lg:text-2xl font-bold text-themeText font-display">Schedule a Consultation</h3>
        <p class="text-xs text-themeTextMuted">Select your preferred date for a professional checkup at Noida Dental Care.</p>
      </div>

      <!-- Booking Form -->
      <form id="mock-booking-form" class="space-y-4 text-xs font-sans" onsubmit="event.preventDefault(); document.getElementById('booking-success-msg').classList.remove('hidden'); document.getElementById('mock-booking-form').classList.add('hidden');">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="dental-book-date" class="text-themeTextMuted block font-medium">Preferred Date</label>
            <input id="dental-book-date" type="date" required class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="dental-book-treatment" class="text-themeTextMuted block font-medium">Treatment Needed</label>
            <select id="dental-book-treatment" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary">
              <option>General Checkup / Cleaning</option>
              <option>Root Canal Treatment</option>
              <option>Cosmetic Smile Makeover</option>
              <option>Clear Aligners / Braces</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="dental-book-name" class="text-themeTextMuted block font-medium">Your Name</label>
            <input id="dental-book-name" type="text" required placeholder="Aarav Sharma" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="dental-book-phone" class="text-themeTextMuted block font-medium">Your Phone</label>
            <input id="dental-book-phone" type="tel" required placeholder="+91 99999 99999" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
        </div>

        <button type="submit" class="btn-magnetic w-full py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary/95 text-white font-bold transition-all shadow-md shadow-brand-primary/20">
          Book Consultation Slot
        </button>
      </form>

      <!-- Success Screen -->
      <div id="booking-success-msg" class="hidden text-center p-6 rounded-2xl bg-brand-primary/10 border border-brand-primary/20 space-y-2">
        <svg class="w-8 h-8 text-brand-primary mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
        <span class="text-sm font-bold text-brand-primary block font-display">Appointment Requested!</span>
        <span class="text-[10px] text-themeTextMuted block">We have received your slot request. In a live production build, this routes directly into their medical receptionist database.</span>
        <button onclick="document.getElementById('booking-success-msg').classList.add('hidden'); document.getElementById('mock-booking-form').classList.remove('hidden');" class="mt-4 text-[10px] text-brand-primary font-bold hover:underline">
          Book another appointment
        </button>
      </div>

    </div>
  </div>
</section>
