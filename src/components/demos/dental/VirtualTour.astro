---
const slides = [
  {
    name: "Consultation & Diagnostics Suite",
    desc: "Equipped with state-of-the-art diagnostic screens and digital imaging sensors.",
    img: "/images/dentist-clinic.png",
    hotspots: [
      { x: 30, y: 35, title: "3D Intraoral Scanner", text: "Replaces traditional gooey impressions with a 6,000-shots-per-minute high-definition color digital scan of your teeth." },
      { x: 65, y: 55, title: "Ergonomic Patient Chair", text: "Fully adjustable orthopedic memory-foam upholstery designed to minimize back strain during treatments." }
    ]
  },
  {
    name: "Sterilization & Hygiene Zone",
    desc: "Hospital-grade safety hub executing triple autoclave sanitization loops.",
    img: "/images/dentist-treatment.png",
    hotspots: [
      { x: 25, y: 25, title: "Low-Dose Digital X-Ray", text: "Emits 90% less radiation than film X-rays and delivers instant diagnostic scans onto our chairside screens." },
      { x: 75, y: 40, title: "Class B Autoclave", text: "Provides fractional pre-vacuum steam sterilization conforming to strict European ISO health guidelines." }
    ]
  }
];
---

<div class="virtual-tour-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6 relative overflow-hidden select-none">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="space-y-1">
      <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2">
        <svg class="w-5 h-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5m3-16.5h1.5a2.25 2.25 0 0 1 2.25 2.25V21a2.25 2.25 0 0 1-2.25 2.25h-1.5A2.25 2.25 0 0 1 9 21V3.75A2.25 2.25 0 0 1 11.25 1.5Zm-4.5 3h1.5A2.25 2.25 0 0 1 10.5 6.75V21a2.25 2.25 0 0 1-2.25 2.25h-1.5A2.25 2.25 0 0 1 4.5 21V6.75A2.25 2.25 0 0 1 6.75 4.5Zm10.5 3h1.5a2.25 2.25 0 0 1 2.25 2.25V21a2.25 2.25 0 0 1-2.25 2.25h-1.5a2.25 2.25 0 0 1-2.25-2.25V9.75a2.25 2.25 0 0 1 2.25-2.25Z" />
        </svg>
        Clinic Virtual Hotspot Tour
      </h4>
      <p class="text-xs text-[var(--text-muted)]">Click on the glowing plus (+) hotspots on the images to inspect our advanced medical hardware specs.</p>
    </div>
    <!-- Slider selectors -->
    <div class="flex gap-2 self-end sm:self-auto">
      <button id="tour-prev-btn" class="p-2.5 rounded-xl bg-zinc-900 border border-[var(--border-color)] text-[var(--text-color)] hover:bg-zinc-800 transition-colors" aria-label="Previous Chamber">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      </button>
      <button id="tour-next-btn" class="p-2.5 rounded-xl bg-zinc-900 border border-[var(--border-color)] text-[var(--text-color)] hover:bg-zinc-800 transition-colors" aria-label="Next Chamber">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </button>
    </div>
  </div>

  <!-- Tour slides carousel frame -->
  <div class="relative overflow-hidden rounded-2xl aspect-[16/10] sm:aspect-[16/8] border border-[var(--border-color)]">
    <div id="tour-carousel" class="flex h-full absolute inset-y-0 transition-transform duration-500 ease-out" style="width: 200%; transform: translateX(0%);">
      {slides.map((slide, idx) => (
        <div class="w-1/2 h-full flex-shrink-0 relative group">
          <img src={slide.img} alt={slide.name} class="w-full h-full object-cover select-none" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30"></div>
          
          <!-- Title Overlay -->
          <div class="absolute bottom-4 left-4 right-4 bg-zinc-900/60 backdrop-blur-md border border-white/5 p-4 rounded-xl space-y-1">
            <span class="text-[9px] font-bold text-teal-400 uppercase tracking-widest block">Room Tour 0{idx+1}</span>
            <h5 class="text-xs sm:text-sm font-bold text-white font-display">{slide.name}</h5>
            <p class="text-[10px] text-zinc-400 leading-relaxed font-sans">{slide.desc}</p>
          </div>

          <!-- Hotspots -->
          {slide.hotspots.map((spot, spotIdx) => (
            <div 
              class="absolute group/spot cursor-pointer select-none" 
              style={`left: ${spot.x}%; top: ${spot.y}%;`}
            >
              <!-- Glowing Pulsing Dot -->
              <span class="absolute w-6 h-6 -left-3 -top-3 rounded-full bg-teal-500/30 animate-ping"></span>
              <div class="relative w-6 h-6 -left-3 -top-3 rounded-full bg-teal-600 border border-white/80 shadow flex items-center justify-center font-sans text-xs font-bold text-white transition-all group-hover/spot:scale-110">
                +
              </div>

              <!-- Hotspot Info card popover -->
              <div class="absolute bottom-8 -left-32 w-64 bg-zinc-900/98 backdrop-blur-md border border-teal-500/20 p-4 rounded-xl shadow-xl space-y-1 opacity-0 pointer-events-none transition-all duration-300 transform translate-y-2 group-hover/spot:opacity-100 group-hover/spot:translate-y-0 group-hover/spot:pointer-events-auto z-30">
                <span class="text-[9px] font-bold text-teal-400 uppercase tracking-widest block">Hardware Spec</span>
                <h6 class="text-xs font-bold text-white font-display">{spot.title}</h6>
                <p class="text-[10px] text-zinc-400 leading-normal font-sans font-medium">{spot.text}</p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initTourCarousel() {
    const prevBtn = document.getElementById('tour-prev-btn');
    const nextBtn = document.getElementById('tour-next-btn');
    const carousel = document.getElementById('tour-carousel');
    if (!prevBtn || !nextBtn || !carousel) return;

    let index = 0;
    const maxIndex = 1; // 2 slides

    function updateSlide() {
      carousel.style.transform = `translateX(-${index * 50}%)`;
    }

    prevBtn.addEventListener('click', () => {
      index = index > 0 ? index - 1 : maxIndex;
      updateSlide();
    });

    nextBtn.addEventListener('click', () => {
      index = index < maxIndex ? index + 1 : 0;
      updateSlide();
    });
  }

  // Support page loads transitions
  initTourCarousel();
  document.addEventListener('astro:page-load', initTourCarousel);
</script>
