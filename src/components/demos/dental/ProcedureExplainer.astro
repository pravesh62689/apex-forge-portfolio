---
/**
 * ProcedureExplainer.astro — Dentist Standard tier
 * Explains common procedures with duration, steps, and recovery
 */
---

<section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-teal-500/10 text-teal-600 border border-teal-500/20 uppercase tracking-wider mb-4">Know Your Treatment</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Common Procedures Explained</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4 max-w-lg mx-auto">Understanding your treatment helps reduce anxiety. Here's what to expect.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        { 
          name: 'Root Canal Treatment', 
          duration: '60-90 mins', 
          steps: 'Local anesthesia → Access opening → Cleaning canals → Filling → Crown placement', 
          recovery: 'Mild soreness for 2-3 days' 
        },
        { 
          name: 'Teeth Whitening', 
          duration: '45-60 mins', 
          steps: 'Teeth cleaning → Gel application → LED activation → Rinse → Polish', 
          recovery: 'Slight sensitivity for 24 hours' 
        },
        { 
          name: 'Dental Implant', 
          duration: '2-3 visits over 3 months', 
          steps: 'Assessment → Implant placement → Healing → Abutment → Crown', 
          recovery: '3-6 months total healing' 
        },
        { 
          name: 'Clear Aligners', 
          duration: '6-18 months', 
          steps: 'Scanning → Treatment plan → Custom aligners → Regular checkups', 
          recovery: 'No downtime, change aligners every 2 weeks' 
        },
      ].map(item => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-3">
          <h4 class="text-sm font-bold text-[var(--text-color)] font-display">{item.name}</h4>
          <div class="flex gap-4 text-xs text-[var(--text-muted)]">
            <span class="flex items-center gap-1">
              <svg class="w-3 h-3 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              {item.duration}
            </span>
          </div>
          <p class="text-xs text-[var(--text-muted)]"><strong class="text-[var(--text-color)]">Steps:</strong> {item.steps}</p>
          <p class="text-xs text-[var(--text-muted)]"><strong class="text-[var(--text-color)]">Recovery:</strong> {item.recovery}</p>
        </div>
      ))}
    </div>
  </div>
</section>
