---
---

<div class="doctor-tab-selector-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6">
  <div class="text-center md:text-left space-y-2">
    <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2 justify-center md:justify-start">
      <svg class="w-5 h-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
      </svg>
      Meet Our Dental Specialists
    </h4>
    <p class="text-xs text-[var(--text-muted)]">Click a specialist's tab below to review their credentials, clinical research specialties, and schedule availability.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <!-- Doc 1 Tab -->
    <button class="doc-tab-btn p-4 rounded-2xl border text-left bg-zinc-900/50 border-teal-500/30 text-[var(--text-color)] shadow-lg shadow-teal-500/5" data-doc="neha">
      <span class="text-xs font-bold block">Dr. Neha Sen</span>
      <span class="text-[10px] text-teal-600 font-semibold block mt-0.5">Endodontics (RCT) Specialist</span>
    </button>
    
    <!-- Doc 2 Tab -->
    <button class="doc-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]" data-doc="rohan">
      <span class="text-xs font-bold block">Dr. Rohan Mehta</span>
      <span class="text-[10px] text-zinc-500 font-semibold block mt-0.5">Orthodontist & Aligners Expert</span>
    </button>

    <!-- Doc 3 Tab -->
    <button class="doc-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]" data-doc="priya">
      <span class="text-xs font-bold block">Dr. Priya Verma</span>
      <span class="text-[10px] text-zinc-500 font-semibold block mt-0.5">Cosmetic & Laser Dentist</span>
    </button>
  </div>

  <!-- Doc 1 (Neha) Details -->
  <div id="doc-details-neha" class="doc-details-block block p-6 rounded-2xl border border-[var(--border-color)] bg-black/20">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
      <div class="sm:col-span-4 flex justify-center">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border border-teal-500/20 shadow-md">
          <img src="/images/dentist-doctor.png" alt="Dr. Neha Sen" class="w-full h-full object-cover" />
        </div>
      </div>
      <div class="sm:col-span-8 space-y-4 text-xs leading-relaxed text-[var(--text-muted)]">
        <div>
          <h5 class="text-sm font-bold text-[var(--text-color)]">Dr. Neha Sen, MDS</h5>
          <span class="text-[10px] text-teal-600 font-bold uppercase tracking-wider block mt-0.5">Senior Endodontist & Microscopic RCT Expert</span>
        </div>
        <p class="text-[11px]">Completed her Master of Dental Surgery (MDS) from King George's Medical University (KGMU). Specialized in pain-free microscopic root canal treatments and crown placement with over 9 years of clinical practice in Noida.</p>
        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[var(--border-color)] text-[10px]">
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>MDS Endodontics (KGMU)</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>9+ Years Experience</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Microscope-Guided RCT</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Available: Mon, Wed, Fri</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Doc 2 (Rohan) Details -->
  <div id="doc-details-rohan" class="doc-details-block hidden p-6 rounded-2xl border border-[var(--border-color)] bg-black/20">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
      <div class="sm:col-span-4 flex justify-center">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border border-teal-500/20 shadow-md">
          <!-- We reuse dentist-doctor.png because it's the certified asset we have, or a placeholder -->
          <img src="/images/dentist-doctor.png" alt="Dr. Rohan Mehta" class="w-full h-full object-cover grayscale" />
        </div>
      </div>
      <div class="sm:col-span-8 space-y-4 text-xs leading-relaxed text-[var(--text-muted)]">
        <div>
          <h5 class="text-sm font-bold text-[var(--text-color)]">Dr. Rohan Mehta, MDS</h5>
          <span class="text-[10px] text-teal-600 font-bold uppercase tracking-wider block mt-0.5">Orthodontist & Clear Aligner Consultant</span>
        </div>
        <p class="text-[11px]">Specializes in correcting teeth alignment anomalies. Certified provider of Invisalign, Inman aligners, and self-ligating metal and ceramic braces systems with 12+ years of practice across Delhi NCR.</p>
        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[var(--border-color)] text-[10px]">
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>MDS Orthodontics (AIIMS)</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>12+ Years Experience</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Invisalign Diamond Provider</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Available: Tue, Thu, Sat</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Doc 3 (Priya) Details -->
  <div id="doc-details-priya" class="doc-details-block hidden p-6 rounded-2xl border border-[var(--border-color)] bg-black/20">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
      <div class="sm:col-span-4 flex justify-center">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border border-teal-500/20 shadow-md">
          <img src="/images/dentist-doctor.png" alt="Dr. Priya Verma" class="w-full h-full object-cover sepia" />
        </div>
      </div>
      <div class="sm:col-span-8 space-y-4 text-xs leading-relaxed text-[var(--text-muted)]">
        <div>
          <h5 class="text-sm font-bold text-[var(--text-color)]">Dr. Priya Verma, BDS</h5>
          <span class="text-[10px] text-teal-600 font-bold uppercase tracking-wider block mt-0.5">Aesthetic Dentist & Laser Surgeon</span>
        </div>
        <p class="text-[11px]">Specialist in digital smile design, porcelain veneers, laser teeth whitening, and general dental hygiene procedures. Focuses on minimal discomfort and elite cosmetic restoration designs.</p>
        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[var(--border-color)] text-[10px]">
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>BDS (Manipal Academy)</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>8+ Years Experience</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Smile Design Certifications</span>
          <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-teal-500 rounded-full"></span>Available: Daily (Mon-Sat)</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initDocSelector() {
    const buttons = document.querySelectorAll('.doc-tab-btn');
    const blocks = document.querySelectorAll('.doc-details-block');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-doc');
        
        // Reset all buttons style
        buttons.forEach(b => {
          b.className = "doc-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]";
          b.querySelector('span:nth-of-type(2)')?.classList.remove('text-teal-600');
          b.querySelector('span:nth-of-type(2)')?.classList.add('text-zinc-500');
        });
        
        // Set active button style
        btn.className = "doc-tab-btn p-4 rounded-2xl border text-left bg-zinc-900/50 border-teal-500/30 text-[var(--text-color)] shadow-lg shadow-teal-500/5";
        btn.querySelector('span:nth-of-type(2)')?.classList.remove('text-zinc-500');
        btn.querySelector('span:nth-of-type(2)')?.classList.add('text-teal-600');

        // Toggle detailed panels
        blocks.forEach(block => {
          if (block.id === `doc-details-${target}`) {
            block.classList.remove('hidden');
            block.classList.add('block');
          } else {
            block.classList.remove('block');
            block.classList.add('hidden');
          }
        });
      });
    });
  }

  // Support page transition routing loading cycles
  initDocSelector();
  document.addEventListener('astro:page-load', initDocSelector);
</script>
