---

<section class="py-20 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        Patient Care First
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        Why Families Trust Our Clinic
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm">
        Providing safe, high-quality treatments backed by professional credentials.
      </p>
    </div>

    <!-- Credentials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      
      <!-- Trust Badge 1 -->
      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl text-center space-y-4 shadow-md hover:border-brand-primary/20 transition-all duration-300">
        <div class="w-12 h-12 rounded-2xl overflow-hidden border border-brand-primary/20 bg-ink-950 flex items-center justify-center mx-auto">
          <img 
            src="https://images.unsplash.com/photo-1584824486509-112e4181ff6b?auto=format&fit=crop&w=150&h=150&q=80" 
            alt="Safety Protocol" 
            class="w-full h-full object-cover"
          />
        </div>
        <h4 class="text-base font-bold text-themeText font-display">Elite Safety Protocols</h4>
        <p class="text-xs text-themeTextMuted leading-relaxed">
          100% autoclave sterilisation compliance on all clinical tools and disposable materials, following strict WHO hygiene standards.
        </p>
      </div>

      <!-- Trust Badge 2 -->
      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl text-center space-y-4 shadow-md hover:border-brand-primary/20 transition-all duration-300">
        <div class="w-12 h-12 rounded-2xl overflow-hidden border border-brand-accent/20 bg-ink-950 flex items-center justify-center mx-auto">
          <img 
            src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=150&h=150&q=80" 
            alt="German equipment" 
            class="w-full h-full object-cover"
          />
        </div>
        <h4 class="text-base font-bold text-themeText font-display">ISO 9001 Certified</h4>
        <p class="text-xs text-themeTextMuted leading-relaxed">
          Verified quality management systems, utilising premium dental materials and advanced diagnostics imported from Germany.
        </p>
      </div>

      <!-- Trust Badge 3 -->
      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl text-center space-y-4 shadow-md hover:border-brand-primary/20 transition-all duration-300">
        <div class="w-12 h-12 rounded-2xl overflow-hidden border border-brand-primary/20 bg-ink-950 flex items-center justify-center mx-auto">
          <img 
            src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=150&h=150&q=80" 
            alt="MDS Specialists" 
            class="w-full h-full object-cover"
          />
        </div>
        <h4 class="text-base font-bold text-themeText font-display">MDS Specialist Doctors</h4>
        <p class="text-xs text-themeTextMuted leading-relaxed">
          All key treatments—from RCT to dental implants—are performed exclusively by certified Master of Dental Surgery doctors.
        </p>
      </div>

    </div>
  </div>
</section>
