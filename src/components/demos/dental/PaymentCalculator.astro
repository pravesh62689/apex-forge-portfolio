---
const treatments = [
  { name: "Microscopic Root Canal", cost: 4500, defaultDown: 1500 },
  { name: "Invisalign Clear Aligners", cost: 48000, defaultDown: 12000 },
  { name: "Porcelain Veneers (Per Tooth)", cost: 9500, defaultDown: 2500 },
  { name: "Full Mouth Dental Implants", cost: 90000, defaultDown: 25000 },
  { name: "Laser Teeth Whitening", cost: 6500, defaultDown: 2000 }
];
---

<div class="payment-calculator-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6">
  <div class="text-center md:text-left space-y-2">
    <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2 justify-center md:justify-start">
      <svg class="w-5 h-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
      </svg>
      Interest-Free EMI Calculator
    </h4>
    <p class="text-xs text-[var(--text-muted)]">Select your treatment, adjust your down payment, and view calculated interest-free monthly installment rates.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center font-sans">
    
    <!-- Inputs -->
    <div class="space-y-4 text-xs">
      <div class="space-y-1.5">
        <label for="calc-treatment" class="font-bold text-[var(--text-color)] block">Select Plan / Treatment</label>
        <select id="calc-treatment" class="w-full bg-zinc-900/50 border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500">
          {treatments.map(t => (
            <option value={t.cost} data-down={t.defaultDown}>{t.name} (₹{t.cost.toLocaleString('en-IN')})</option>
          ))}
        </select>
      </div>

      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-[var(--text-color)] font-bold">
          <label for="calc-down-slider">Down Payment (₹)</label>
          <span id="calc-down-label" class="text-teal-600">₹1,500</span>
        </div>
        <input type="range" id="calc-down-slider" min="1000" max="25000" step="500" value="1500" class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-teal-600" />
        <div class="flex justify-between text-[9px] text-[var(--text-muted)] mt-1">
          <span id="calc-down-min">Min: ₹1,000</span>
          <span id="calc-down-max">Max: ₹25,000</span>
        </div>
      </div>

      <div class="space-y-1.5">
        <span class="font-bold text-[var(--text-color)] block">EMI Repayment Tenure</span>
        <div class="grid grid-cols-4 gap-2">
          {['3 Months', '6 Months', '9 Months', '12 Months'].map((tenure, idx) => (
            <button class={`calc-tenure-btn py-2.5 rounded-xl border text-[10px] font-bold text-center transition-all ${idx === 1 ? 'border-teal-500/30 bg-teal-500/10 text-white' : 'border-[var(--border-color)] bg-[var(--card-bg)] text-[var(--text-muted)] hover:text-white'}`} data-months={(idx + 1) * 3}>
              {tenure}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="p-6 rounded-2xl bg-zinc-900/50 border border-[var(--border-color)] space-y-4">
      <div class="text-center py-4 bg-teal-950/20 border border-teal-500/10 rounded-xl space-y-1">
        <span class="text-[9px] uppercase font-bold text-teal-600 tracking-wider">Estimated Monthly EMI</span>
        <h5 class="text-3xl font-extrabold text-[var(--text-color)] font-display" id="calc-emi-result">₹500 <span class="text-xs font-normal text-[var(--text-muted)]">/ mo</span></h5>
      </div>

      <div class="space-y-2.5 text-xs text-[var(--text-muted)] leading-relaxed">
        <div class="flex justify-between py-1 border-b border-[var(--border-color)]">
          <span>Treatment Total Cost</span>
          <span class="font-bold text-[var(--text-color)]" id="calc-out-total">₹4,500</span>
        </div>
        <div class="flex justify-between py-1 border-b border-[var(--border-color)]">
          <span>Down Payment Paid</span>
          <span class="font-bold text-[var(--text-color)]" id="calc-out-down">₹1,500</span>
        </div>
        <div class="flex justify-between py-1 border-b border-[var(--border-color)]">
          <span>Remaining Principal</span>
          <span class="font-bold text-[var(--text-color)]" id="calc-out-principal">₹3,000</span>
        </div>
        <div class="flex justify-between py-1">
          <span>Interest Rate</span>
          <span class="font-bold text-emerald-500">0% (Zero Interest)</span>
        </div>
      </div>

      <div class="pt-2 text-[9px] text-[var(--text-muted)] leading-normal text-center">
        ⚡ EMI schemes backed by Bajaj Finserv and HDFC medical financing networks. Available on instant DCI-approved KYC clinic desk verification.
      </div>
    </div>
  </div>
</div>

<script>
  function initPaymentCalc() {
    const selectEl = document.getElementById('calc-treatment');
    const sliderEl = document.getElementById('calc-down-slider');
    const downLabel = document.getElementById('calc-down-label');
    const downMin = document.getElementById('calc-down-min');
    const downMax = document.getElementById('calc-down-max');
    const emiResult = document.getElementById('calc-emi-result');
    
    const outTotal = document.getElementById('calc-out-total');
    const outDown = document.getElementById('calc-out-down');
    const outPrincipal = document.getElementById('calc-out-principal');
    const tenureButtons = document.querySelectorAll('.calc-tenure-btn');

    if (!selectEl || !sliderEl || !downLabel || !emiResult) return;

    let activeMonths = 6; // default 6 Months

    function calculateEMI() {
      const totalCost = parseInt(selectEl.value);
      const minDown = Math.floor(totalCost * 0.15); // 15% minimum down payment
      const maxDown = Math.floor(totalCost * 0.6); // 60% maximum down payment
      
      // Update slider range attributes dynamically
      sliderEl.min = minDown.toString();
      sliderEl.max = maxDown.toString();
      
      // Clamp active value if needed
      let downValue = parseInt(sliderEl.value);
      if (downValue < minDown) downValue = minDown;
      if (downValue > maxDown) downValue = maxDown;
      sliderEl.value = downValue.toString();

      // Display updates
      if (downLabel) downLabel.textContent = `₹${downValue.toLocaleString('en-IN')}`;
      if (downMin) downMin.textContent = `Min: ₹${minDown.toLocaleString('en-IN')}`;
      if (downMax) downMax.textContent = `Max: ₹${maxDown.toLocaleString('en-IN')}`;

      const principal = totalCost - downValue;
      const emi = Math.round(principal / activeMonths);

      if (emiResult) emiResult.innerHTML = `₹${emi.toLocaleString('en-IN')} <span class="text-xs font-normal text-[var(--text-muted)]">/ mo</span>`;
      if (outTotal) outTotal.textContent = `₹${totalCost.toLocaleString('en-IN')}`;
      if (outDown) outDown.textContent = `₹${downValue.toLocaleString('en-IN')}`;
      if (outPrincipal) outPrincipal.textContent = `₹${principal.toLocaleString('en-IN')}`;
    }

    // Set initial down payment defaults on treatment select change
    selectEl.addEventListener('change', () => {
      const selectedOpt = selectEl.options[selectEl.selectedIndex];
      const defaultDown = selectedOpt.getAttribute('data-down');
      sliderEl.value = defaultDown;
      calculateEMI();
    });

    sliderEl.addEventListener('input', calculateEMI);

    tenureButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle selected styling
        tenureButtons.forEach(b => {
          b.className = "calc-tenure-btn py-2.5 rounded-xl border text-[10px] font-bold text-center transition-all border-[var(--border-color)] bg-[var(--card-bg)] text-[var(--text-muted)] hover:text-white";
        });
        btn.className = "calc-tenure-btn py-2.5 rounded-xl border text-[10px] font-bold text-center transition-all border-teal-500/30 bg-teal-500/10 text-white";
        activeMonths = parseInt(btn.getAttribute('data-months'));
        calculateEMI();
      });
    });

    // Run first calculation
    calculateEMI();
  }

  // Support page loads transitions
  initPaymentCalc();
  document.addEventListener('astro:page-load', initPaymentCalc);
</script>
