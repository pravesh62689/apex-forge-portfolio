---
/**
 * ConsultationFlow.astro — Dentist Premium tier
 * Virtual assessment & booking pathway
 */
---

<section id="prem-d-consult" class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-teal-500/10 text-teal-600 border border-teal-500/20 uppercase tracking-widest mb-4">Consultation</span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Your Journey to a Better Smile</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4 max-w-lg mx-auto">Three simple steps from first contact to your dream smile.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {[
        { 
          step: '01', 
          title: 'Digital Assessment', 
          desc: 'Share photos via WhatsApp for an initial assessment. Our dentist will review and suggest treatment options.', 
          icon: 'M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z' 
        },
        { 
          step: '02', 
          title: 'In-Clinic Consultation', 
          desc: 'Comprehensive examination with digital X-rays, 3D scanning, and a detailed treatment plan with costs.', 
          icon: 'M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z' 
        },
        { 
          step: '03', 
          title: 'Treatment & Follow-up', 
          desc: 'Proceed with your chosen treatment. We provide detailed post-care instructions and follow-up appointments.', 
          icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' 
        },
      ].map(item => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] text-center space-y-4">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <span class="text-2xl font-bold text-teal-600 block">{item.step}</span>
          <h4 class="text-sm font-bold text-[var(--text-color)] font-display">{item.title}</h4>
          <p class="text-xs text-[var(--text-muted)]">{item.desc}</p>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a href="https://wa.me/919999999999?text=Hi%2C%20I%27d%20like%20a%20dental%20consultation." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-teal-600 text-white hover:bg-teal-700 transition-all shadow-xl shadow-teal-600/20">
        Start Your Assessment on WhatsApp
      </a>
    </div>
  </div>
</section>
