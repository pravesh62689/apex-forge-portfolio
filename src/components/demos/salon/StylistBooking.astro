---
const stylists = [
  {
    id: "marc",
    name: "Art Director Marc",
    role: "Master of Cuts & Geometry",
    slots: ["3:00 PM", "5:00 PM", "6:30 PM"],
    specialty: "Precision bob cuts, layered styling, and aesthetic profile transformations.",
    img: "/images/gym-trainer.png" // Reuse existing placeholder image
  },
  {
    id: "ananya",
    name: "Senior Stylist Ananya",
    role: "Balayage & Color Architect",
    slots: ["1:00 PM", "4:30 PM", "6:00 PM", "7:30 PM"],
    specialty: "Premium hair painting, ammonia-free color styling, and scalp therapy treatments.",
    img: "/images/gym-trainer.png"
  },
  {
    id: "ritu",
    name: "Nail Artist Ritu",
    role: "Gel Nail & Extension Curator",
    slots: ["2:00 PM", "3:30 PM", "5:30 PM"],
    specialty: "Stiletto overlays, custom metallic chrome paint designs, and cuticle nourishing care.",
    img: "/images/gym-trainer.png"
  }
];
---

<div class="stylist-booking-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6">
  <div class="text-center md:text-left space-y-2">
    <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2 justify-center md:justify-start">
      <svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
      </svg>
      Stylist Availability & Appointment Booking
    </h4>
    <p class="text-xs text-[var(--text-muted)]">Select your preferred stylist below to check their hourly calendar schedule and lock in your session slot.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start font-sans">
    
    <!-- Stylist Selection Grid -->
    <div class="lg:col-span-5 space-y-3">
      <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block">Choose Artist</span>
      {stylists.map((st, idx) => (
        <button 
          class={`stylist-select-btn w-full p-4 rounded-2xl border text-left flex items-center gap-4 transition-all duration-300 ${idx === 0 ? 'bg-zinc-900/50 border-rose-400/30 text-[var(--text-color)] shadow-lg shadow-rose-400/5' : 'bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]'}`} 
          data-id={st.id}
          data-name={st.name}
          data-role={st.role}
          data-desc={st.specialty}
          data-slots={st.slots.join(',')}
        >
          <div class="w-12 h-12 rounded-full overflow-hidden border border-rose-400/20 bg-zinc-800 flex-shrink-0">
            <!-- Simple filter adjustment so they look like distinct people -->
            <img src={st.img} alt={st.name} class={`w-full h-full object-cover ${idx === 1 ? 'hue-rotate-60' : idx === 2 ? 'grayscale sepia' : ''}`} />
          </div>
          <div>
            <span class="text-xs font-bold block">{st.name}</span>
            <span class="text-[9px] text-zinc-500 font-semibold block mt-0.5">{st.role}</span>
          </div>
        </button>
      ))}
    </div>

    <!-- Booking details & slot select -->
    <div class="lg:col-span-7 p-6 rounded-2xl bg-zinc-900/50 border border-[var(--border-color)] space-y-5">
      <div class="pb-4 border-b border-[var(--border-color)] space-y-2">
        <h5 class="text-sm font-bold text-[var(--text-color)]" id="sel-stylist-name">Art Director Marc</h5>
        <p class="text-[11px] text-[var(--text-muted)] leading-relaxed min-h-[48px]" id="sel-stylist-desc">
          Master of Cuts & Geometry. Specialty: Precision bob cuts, layered styling, and aesthetic profile transformations.
        </p>
      </div>

      <!-- Live slots selection -->
      <div class="space-y-3">
        <span class="text-[9px] font-bold text-rose-400 uppercase tracking-widest block">Select Available Slot (Today)</span>
        <div class="grid grid-cols-3 gap-2" id="stylist-slots-grid">
          <!-- Populated by script -->
        </div>
      </div>

      <!-- Booking request form inputs -->
      <form class="space-y-4 pt-2" onsubmit="event.preventDefault(); alert('Session booking request submitted! (Demo only)');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="space-y-1">
            <label for="stylist-client-name" class="font-bold text-[var(--text-color)]">Client Name</label>
            <input id="stylist-client-name" type="text" required placeholder="Name" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-xs text-[var(--text-color)] focus:outline-none focus:border-rose-400" />
          </div>
          <div class="space-y-1">
            <label for="stylist-client-phone" class="font-bold text-[var(--text-color)]">Phone / WhatsApp</label>
            <input id="stylist-client-phone" type="tel" required placeholder="+91" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-xs text-[var(--text-color)] focus:outline-none focus:border-rose-400" />
          </div>
        </div>
        
        <!-- Hidden input storing slot state -->
        <input type="hidden" id="selected-slot-input" required />

        <button type="submit" id="stylist-book-submit" disabled class="w-full py-3.5 rounded-xl bg-zinc-800 text-zinc-500 border border-zinc-700/50 text-xs font-bold transition-all duration-300">
          Select A Time Slot Above
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function initStylistBooking() {
    const buttons = document.querySelectorAll('.stylist-select-btn');
    const nameEl = document.getElementById('sel-stylist-name');
    const descEl = document.getElementById('sel-stylist-desc');
    const slotsGrid = document.getElementById('stylist-slots-grid');
    const hiddenInput = document.getElementById('selected-slot-input') as HTMLInputElement;
    const submitBtn = document.getElementById('stylist-book-submit') as HTMLButtonElement;

    if (!buttons.length || !nameEl || !descEl || !slotsGrid) return;

    function renderSlots(slotsStr: string) {
      slotsGrid.innerHTML = '';
      const slots = slotsStr.split(',');
      
      slots.forEach(slot => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = "p-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] text-[10px] font-bold text-center text-[var(--text-muted)] hover:text-white hover:border-rose-400/30 transition-all duration-200";
        btn.textContent = slot;
        
        btn.addEventListener('click', () => {
          // Reset previous select
          slotsGrid.querySelectorAll('button').forEach(b => {
            b.className = "p-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] text-[10px] font-bold text-center text-[var(--text-muted)] hover:text-white hover:border-rose-400/30 transition-all duration-200";
          });
          
          // Select this one
          btn.className = "p-2.5 rounded-xl border border-rose-400/30 bg-rose-400/10 text-[10px] font-bold text-center text-white transition-all";
          if (hiddenInput) hiddenInput.value = slot;
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.className = "w-full py-3.5 rounded-xl bg-rose-500 text-white text-xs font-bold shadow-lg shadow-rose-500/20 hover:bg-rose-600 transition-all duration-300";
            submitBtn.textContent = `Confirm Booking at ${slot}`;
          }
        });

        slotsGrid.appendChild(btn);
      });
      
      // Reset submit button state on stylist change
      if (hiddenInput) hiddenInput.value = '';
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.className = "w-full py-3.5 rounded-xl bg-zinc-800 text-zinc-500 border border-zinc-700/50 text-xs font-bold transition-all duration-300";
        submitBtn.textContent = "Select A Time Slot Above";
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle selected styling
        buttons.forEach(b => {
          b.className = "stylist-select-btn w-full p-4 rounded-2xl border text-left flex items-center gap-4 bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)] transition-all duration-300";
        });
        btn.className = "stylist-select-btn w-full p-4 rounded-2xl border text-left flex items-center gap-4 bg-zinc-900/50 border-rose-400/30 text-[var(--text-color)] shadow-lg shadow-rose-400/5 transition-all duration-300";

        // Update details panel
        const name = btn.getAttribute('data-name');
        const role = btn.getAttribute('data-role');
        const desc = btn.getAttribute('data-desc');
        const slots = btn.getAttribute('data-slots');

        if (nameEl) nameEl.textContent = name;
        if (descEl) descEl.textContent = desc;

        // Render slots
        renderSlots(slots);
      });
    });

    // Run first rendering
    const firstBtn = buttons[0];
    const initialSlots = firstBtn.getAttribute('data-slots');
    renderSlots(initialSlots);
  }

  // Support page loads via transitions
  initStylistBooking();
  document.addEventListener('astro:page-load', initStylistBooking);
</script>
