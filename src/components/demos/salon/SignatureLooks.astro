---
---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        Portfolio
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        Our Signature Transformations
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm">
        Explore styled looks, precise cuts, and dynamic balayage transformations crafted at Noida Sec 18.
      </p>
    </div>

    <!-- Masonry/Grid Gallery -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      
      <!-- Look 1 -->
      <div class="demo-card rounded-3xl overflow-hidden aspect-[4/5] border border-ink-border shadow-md group relative">
        <img 
          src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=600&q=80" 
          alt="Precision Hair Cut Styling" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <div>
            <span class="text-xs font-bold text-white font-display block">Precision Shag Cut</span>
            <span class="text-[9px] text-brand-primary font-semibold block mt-0.5">Stylist: Rahul</span>
          </div>
        </div>
      </div>

      <!-- Look 2 -->
      <div class="demo-card rounded-3xl overflow-hidden aspect-[4/5] border border-ink-border shadow-md group relative">
        <img 
          src="https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?auto=format&fit=crop&w=600&q=80" 
          alt="French Balayage Color" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <div>
            <span class="text-xs font-bold text-white font-display block">Honey Blonde Balayage</span>
            <span class="text-[9px] text-brand-primary font-semibold block mt-0.5">Stylist: Monica</span>
          </div>
        </div>
      </div>

      <!-- Look 3 -->
      <div class="demo-card rounded-3xl overflow-hidden aspect-[4/5] border border-ink-border shadow-md group relative">
        <img 
          src="https://images.unsplash.com/photo-1605497746444-ac9dbd340b66?auto=format&fit=crop&w=600&q=80" 
          alt="Soft Wave Blowout" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <div>
            <span class="text-xs font-bold text-white font-display block">Volumising Silk Blowout</span>
            <span class="text-[9px] text-brand-primary font-semibold block mt-0.5">Stylist: Amit</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
