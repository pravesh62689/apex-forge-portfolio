---
---

<section id="booking" class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-xl mx-auto px-4">
    <div class="bg-ink-900 border border-ink-border rounded-3xl p-8 lg:p-10 shadow-xl space-y-6">
      <div class="text-center space-y-2">
        <h3 class="text-xl lg:text-2xl font-bold text-themeText font-display">Book Your Session</h3>
        <p class="text-xs text-themeTextMuted">Select your stylist and requested time for a luxury salon session.</p>
      </div>

      <!-- Booking Form -->
      <form id="mock-booking-form" class="space-y-4 text-xs font-sans" onsubmit="event.preventDefault(); document.getElementById('booking-success-msg').classList.remove('hidden'); document.getElementById('mock-booking-form').classList.add('hidden');">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="salon-book-date" class="text-themeTextMuted block font-medium">Session Date</label>
            <input id="salon-book-date" type="date" required class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="salon-book-stylist" class="text-themeTextMuted block font-medium">Select Stylist</label>
            <select id="salon-book-stylist" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary">
              <option>Monica Sen (Colorist)</option>
              <option>Rahul Sen (Cuts & Styles)</option>
              <option>Any Available Stylist</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="salon-book-name" class="text-themeTextMuted block font-medium">Your Name</label>
            <input id="salon-book-name" type="text" required placeholder="Aarav Sharma" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="salon-book-phone" class="text-themeTextMuted block font-medium">Your Phone</label>
            <input id="salon-book-phone" type="tel" required placeholder="+91 99999 99999" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary" />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="salon-book-treatment" class="text-themeTextMuted block font-medium">Treatment Requested</label>
          <select id="salon-book-treatment" class="w-full bg-ink-950 border border-ink-border rounded-xl px-3.5 py-2.5 text-themeText focus:outline-none focus:border-brand-primary">
            <option>Signature Designer Haircut</option>
            <option>Volumising Blowout</option>
            <option>Luxury French Balayage</option>
            <option>Organic Keratin Therapy</option>
          </select>
        </div>

        <button type="submit" class="btn-magnetic w-full py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary/95 text-white font-bold transition-all shadow-md shadow-brand-primary/20">
          Book Appointment Slot
        </button>
      </form>

      <!-- Success Screen -->
      <div id="booking-success-msg" class="hidden text-center p-6 rounded-2xl bg-brand-primary/10 border border-brand-primary/20 space-y-2">
        <svg class="w-8 h-8 text-brand-primary mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21m0 0L8.187 15.9M9 21h8.25m-11.25 0H3m12-9a3.75 3.75 0 1 0-7.5 0 3.75 3.75 0 0 0 7.5 0Z" /></svg>
        <span class="text-sm font-bold text-brand-primary block font-display">Salon Slot Requested!</span>
        <span class="text-[10px] text-themeTextMuted block">We have received your slot request. In a live production build, this routes directly into their receptionist booking calendars.</span>
        <button onclick="document.getElementById('booking-success-msg').classList.add('hidden'); document.getElementById('mock-booking-form').classList.remove('hidden');" class="mt-4 text-[10px] text-brand-primary font-bold hover:underline">
          Book another session
        </button>
      </div>

    </div>
  </div>
</section>
