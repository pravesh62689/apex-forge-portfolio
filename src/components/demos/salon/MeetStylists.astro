---
const { tier = "premium" } = Astro.props;

const stylists = [
  {
    name: "Monica Sen",
    role: "Master Colorist & Balayage Expert",
    desc: "With 8+ years styling across premium NCR studios, Monica specializes in custom blonding, vivid colors, and molecular hair spas.",
    img: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=300&h=300&q=80",
    alt: "Monica - Master Colorist Noida"
  },
  {
    name: "Rahul Sen",
    role: "Creative Director & Precision Cutter",
    desc: "Rahul trained at Vidal Sassoon and brings expert designer haircuts, textured pixies, and modern shags to Noida Sector 18.",
    img: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=300&h=300&q=80",
    alt: "Rahul - Creative Director Noida"
  },
  {
    name: "Priya Sharma",
    role: "Keratin & Smoothing Specialist",
    desc: "Certified in formaldehyde-free protein smoothing therapies. 6+ years transforming damaged hair into silk textures.",
    img: "https://images.unsplash.com/photo-1534751516642-a131fed10495?auto=format&fit=crop&w=300&h=300&q=80",
    alt: "Priya - Keratin Specialist Noida"
  },
  {
    name: "Amit Verma",
    role: "Men's Styling & Barber Director",
    desc: "Precision taper fades, modern texturing, and relaxing hot-towel grooming routines tailored for NCR executives.",
    img: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=300&h=300&q=80",
    alt: "Amit - Men's Barber Director Noida"
  }
];

const displayStylists = tier === "premium" ? stylists : stylists.slice(0, 2);
---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        The Artisans
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        Meet Our Master Stylists
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm font-light">
        Creative minds dedicated to tailoring the perfect look for your hair, face, and lifestyle.
      </p>
    </div>

    <!-- Stylist Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto font-sans">
      {displayStylists.map((stylist) => (
        <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl p-6 flex flex-col sm:flex-row items-center gap-6 shadow-md hover:border-brand-primary/20 transition-all duration-300">
          <div class="w-32 h-32 rounded-2xl overflow-hidden bg-ink-950 flex-shrink-0">
            <img 
              src={stylist.img} 
              alt={stylist.alt} 
              class="w-full h-full object-cover" 
            />
          </div>
          <div class="space-y-2">
            <h4 class="text-base font-bold text-themeText font-display">{stylist.name}</h4>
            <span class="text-[10px] text-brand-primary font-bold uppercase block">{stylist.role}</span>
            <p class="text-xs text-themeTextMuted leading-relaxed">
              {stylist.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
