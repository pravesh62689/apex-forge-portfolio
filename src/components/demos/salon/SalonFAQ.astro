---
/**
 * SalonFAQ.astro — Salon Standard tier
 * Salon-specific FAQ section using the UI FAQ component
 */
import FAQ from '../../ui/FAQ.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
---

<section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-3xl mx-auto px-4">
    <SectionHeader eyebrow="FAQ" title="Common Questions" />
    <FAQ items={[
      { 
        question: 'Do I need to book in advance?', 
        answer: 'Walk-ins are welcome but we recommend booking in advance, especially on weekends, to secure your preferred stylist and time.' 
      },
      { 
        question: 'What products do you use?', 
        answer: 'We use premium professional brands like L\'Oréal Professionnel, Schwarzkopf Professional, OPI, and organic alternatives for sensitive skin types.' 
      },
      { 
        question: 'Do you do home visits for bridal makeup?', 
        answer: 'Yes! Our bridal makeup and styling team is available for home and venue visits. Additional travel charges may apply depending on the distance.' 
      },
      { 
        question: 'What is your cancellation policy?', 
        answer: 'Please cancel or reschedule at least 4 hours before your appointment. Late cancellations or no-shows may incur a fee of up to 20% of the service cost.' 
      },
    ]} />
  </div>
</section>
