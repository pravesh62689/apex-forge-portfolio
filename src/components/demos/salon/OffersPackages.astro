---
/**
 * OffersPackages.astro — Salon Standard tier
 * Displays special packages and promotions
 */
import SectionHeader from '../../ui/SectionHeader.astro';
---

<section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-4xl mx-auto px-4">
    <SectionHeader eyebrow="Packages" title="Special Offers" description="Curated packages designed for the best value and absolute relaxation." />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { 
          name: 'Glow Package', 
          price: '₹2,499', 
          original: '₹3,100', 
          items: ['Haircut & Blowdry', 'Classic Facial', 'Manicure'] 
        },
        { 
          name: 'Bridal Prep', 
          price: '₹12,999', 
          original: '₹16,000', 
          items: ['Pre-Bridal Facial ×3', 'Hair Spa ×2', 'Full Body Wax', 'Bridal Makeup Trial'] 
        },
        { 
          name: 'Weekend Refresh', 
          price: '₹1,799', 
          original: '₹2,200', 
          items: ['Hair Spa', 'Head Massage', 'Pedicure'] 
        },
      ].map(pkg => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] space-y-4 hover:border-[var(--primary-accent)]/20 transition-all duration-300">
          <h4 class="text-sm font-bold text-[var(--text-color)] font-display">{pkg.name}</h4>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-extrabold text-[var(--primary-accent)]">{pkg.price}</span>
            <span class="text-sm text-[var(--text-muted)] line-through">{pkg.original}</span>
          </div>
          <ul class="space-y-1.5">
            {pkg.items.map(item => (
              <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
