---
/**
 * ProductShowcase.astro — Salon Premium tier
 * Displays premium retail recommendations with filters
 */
import SectionHeader from '../../ui/SectionHeader.astro';
---

<section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <SectionHeader eyebrow="Curated Retail" title="Premium Styling Products" description="We use and recommend only the finest hair and skincare products for home care." />
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { 
          name: 'Professional Hair Elixir', 
          brand: 'L\'Oréal Professionnel', 
          price: '₹2,800', 
          desc: 'Nourishing oil for color-treated hair, providing thermal protection and premium shine.',
          tag: 'Best Seller'
        },
        { 
          name: 'Keratin Restore Mask', 
          brand: 'Schwarzkopf Professional', 
          price: '₹3,400', 
          desc: 'Deep conditioning treatment to repair damaged structure and restore elasticity.',
          tag: 'Stylist Choice'
        },
        { 
          name: 'Hydrating Peptide Serum', 
          brand: 'Skincare Essentials', 
          price: '₹4,200', 
          desc: 'Advanced face serum that locks in moisture and triggers collagen production.',
          tag: 'New'
        }
      ].map(item => (
        <div class="showcase-card group p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] hover:border-[var(--primary-accent)]/30 hover:-translate-y-1 transition-all duration-300 space-y-4">
          <div class="aspect-square rounded-xl bg-[var(--card-bg)] flex items-center justify-center border border-[var(--border-color)] relative overflow-hidden">
            <svg class="w-12 h-12 text-[var(--primary-accent)]/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
            {item.tag && <span class="absolute top-3 right-3 text-[9px] font-bold px-2 py-0.5 rounded-full bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20">{item.tag}</span>}
          </div>
          <div class="space-y-1.5">
            <div class="flex justify-between items-start">
              <div>
                <h4 class="text-sm font-bold text-[var(--text-color)] font-display">{item.name}</h4>
                <span class="text-[9px] text-[var(--text-muted)] font-bold uppercase tracking-wider">{item.brand}</span>
              </div>
              <span class="text-sm font-bold text-[var(--primary-accent)]">{item.price}</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
