---
const { tier = "premium" } = Astro.props;

const trainers = [
  {
    name: "Coach Dev",
    role: "Head Strength Coach & Founder",
    desc: "Certified NSCA-CSCS with 8+ years mentoring competitive athletes. Specializes in starting strength programs, Olympic weightlifting, and barbell mechanics.",
    img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "NSCA Certified Strength & Conditioning Specialist",
      "8+ Years Coaching Experience"
    ]
  },
  {
    name: "Coach Reena",
    role: "MetCon & Kettlebell Coach",
    desc: "Certified RKC Kettlebell Specialist. Passionate about metabolic conditioning, high-intensity intervals, and mobility development.",
    img: "https://images.unsplash.com/photo-1548690312-e3b507d8c110?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "RKC Kettlebell Level 2 Coach",
      "Certified Functional Movement Specialist (FMS)"
    ]
  },
  {
    name: "Coach Karan",
    role: "Bodybuilding & Diet Advisor",
    desc: "Certified Fitness Nutritionist. Specializes in hypertrophy routines, body transformations, muscle mass gains, and nutritional counseling.",
    img: "https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "ISSA Certified Fitness Nutrition Specialist",
      "Hypertrophy & Muscle Gain Mentor"
    ]
  },
  {
    name: "Coach Anita",
    role: "Yoga & Mobility Specialist",
    desc: "Registered Yoga Alliance RYT-500. Focuses on athletic recovery flows, deep core training, and joint mobility enhancement.",
    img: "https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "Yoga Alliance RYT-500 Certified",
      "7+ Years Vinyasa & Mobility Instruction"
    ]
  }
];

const displayTrainers = tier === "premium" ? trainers : trainers.slice(0, 2);
---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-black uppercase tracking-widest text-brand-primary block mb-3 font-sans">
        Expert Coaching Staff
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-black text-themeText mb-4 font-display uppercase tracking-tight">
        Meet Our Trainers
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm font-sans font-medium">
        Certified strength and conditioning professionals dedicated to teaching correct mechanics and driving performance.
      </p>
    </div>

    <!-- Trainers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 max-w-7xl mx-auto font-sans">
      {displayTrainers.map((trainer) => (
        <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl overflow-hidden shadow-lg group hover:border-brand-primary/20 transition-all duration-300">
          <div class="aspect-[4/3] w-full bg-ink-950 overflow-hidden relative border-b border-ink-border">
            <img 
              src={trainer.img} 
              alt={trainer.name} 
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 filter brightness-90 grayscale-[10%]" 
            />
          </div>
          <div class="p-6 space-y-3">
            <div>
              <h4 class="text-base font-black text-themeText uppercase tracking-wide font-display">{trainer.name}</h4>
              <span class="text-[10px] font-black text-brand-primary uppercase tracking-widest">{trainer.role}</span>
            </div>
            <p class="text-[11px] text-themeTextMuted leading-relaxed">
              {trainer.desc}
            </p>
            <div class="pt-2 border-t border-ink-border/50 text-[9px] text-themeTextMuted space-y-1">
              {trainer.credentials.map((cred) => (
                <div class="flex items-center gap-1.5">
                  <svg class="w-3 h-3 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  <span>{cred}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
