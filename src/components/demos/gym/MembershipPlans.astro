---
---

<section id="plans" class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-black uppercase tracking-widest text-brand-primary block mb-3 font-sans">
        Membership Plans
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-black text-themeText mb-4 font-display uppercase tracking-tight">
        Choose Your Training Tier
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm font-sans font-medium">
        Flexible, transparent pricing options tailored for casual trainers and competitive athletes.
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto font-sans">
      
      <!-- Tier 1 -->
      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl flex flex-col justify-between hover:border-brand-primary/20 transition-all duration-300">
        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-black text-themeText uppercase tracking-wider">Basic Strength</h4>
            <p class="text-[10px] text-themeTextMuted mt-1">Access to premium gym floor & equipment</p>
          </div>
          <div class="py-2 border-y border-ink-border/50">
            <span class="text-3xl font-black text-themeText">₹2,500</span>
            <span class="text-[10px] text-themeTextMuted font-bold">/ Month</span>
          </div>
          <ul class="space-y-2.5 text-[11px] text-themeTextMuted font-medium">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Full gym floor & locker access</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>General trainer assistance</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>1 complimentary fitness assessment</span>
            </li>
            <li class="flex items-center gap-2 text-ink-border line-through">
              <svg class="w-3.5 h-3.5 text-ink-border flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              <span>No group classes included</span>
            </li>
          </ul>
        </div>
        <button class="mt-8 w-full py-3 rounded-xl bg-ink-950 border border-ink-border hover:bg-brand-primary hover:border-brand-primary text-themeText hover:text-white text-xs font-black uppercase tracking-wider transition-all">
          Select Plan
        </button>
      </div>

      <!-- Tier 2 (Popular) -->
      <div class="demo-card bg-ink-900 border-2 border-brand-primary p-8 rounded-3xl flex flex-col justify-between shadow-xl shadow-brand-primary/5 relative transform lg:-translate-y-2 transition-all duration-300">
        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest bg-brand-primary text-white">
          Most Popular
        </span>
        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-black text-themeText uppercase tracking-wider">Athletic Elite</h4>
            <p class="text-[10px] text-brand-primary font-bold mt-1">For serious training & class access</p>
          </div>
          <div class="py-2 border-y border-ink-border/50">
            <span class="text-3xl font-black text-themeText">₹4,500</span>
            <span class="text-[10px] text-themeTextMuted font-bold">/ Month</span>
          </div>
          <ul class="space-y-2.5 text-[11px] text-themeText font-semibold">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Unlimited gym floor access</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>2 personal training sessions / mo</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Access to all group classes (Yoga, HIIT, Strength)</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Standard locker & steam shower access</span>
            </li>
          </ul>
        </div>
        <button class="mt-8 w-full py-3 rounded-xl bg-brand-primary hover:bg-brand-primary/95 text-white text-xs font-black uppercase tracking-wider transition-all shadow-md shadow-brand-primary/25">
          Select Plan
        </button>
      </div>

      <!-- Tier 3 -->
      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl flex flex-col justify-between hover:border-brand-primary/20 transition-all duration-300">
        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-black text-themeText uppercase tracking-wider">Champion Prep</h4>
            <p class="text-[10px] text-themeTextMuted mt-1">Full 1-on-1 coaching & biometric tracking</p>
          </div>
          <div class="py-2 border-y border-ink-border/50">
            <span class="text-3xl font-black text-themeText">₹8,000</span>
            <span class="text-[10px] text-themeTextMuted font-bold">/ Month</span>
          </div>
          <ul class="space-y-2.5 text-[11px] text-themeTextMuted font-medium">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Dedicate 1-on-1 coach (3 sessions / week)</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Custom nutrition & recovery profiling</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Unlimited classes + premium private locker</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span>Bi-weekly body composition scans</span>
            </li>
          </ul>
        </div>
        <button class="mt-8 w-full py-3 rounded-xl bg-ink-950 border border-ink-border hover:bg-brand-primary hover:border-brand-primary text-themeText hover:text-white text-xs font-black uppercase tracking-wider transition-all">
          Select Plan
        </button>
      </div>

    </div>
  </div>
</section>
