---
/**
 * MembershipJourney.astro — Premium gym component
 * Step-by-step membership signup flow with progress indicator
 */
---

<section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">Your Journey</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Start Your Transformation</h2>
      <p class="text-[var(--text-muted)] text-sm mt-4">From first visit to fitness goals — here's how your journey unfolds.</p>
    </div>

    <!-- Journey Steps -->
    <div class="relative">
      <!-- Connection Line (desktop) -->
      <div class="hidden md:block absolute top-16 left-0 right-0 h-0.5 bg-[var(--border-color)]"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {[
          {
            step: '01',
            icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>',
            title: 'Free Trial Visit',
            desc: 'Walk in for a complimentary day pass. Explore the facility, try equipment, and attend a group class.',
          },
          {
            step: '02',
            icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0 1 18 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3 1.5 1.5 3-3.75" /></svg>',
            title: 'Fitness Assessment',
            desc: 'Professional body composition analysis, flexibility test, and fitness level evaluation by a certified trainer.',
          },
          {
            step: '03',
            icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" /></svg>',
            title: 'Custom Plan',
            desc: 'Receive a personalized workout plan, nutrition guidelines, and weekly milestone targets based on your goals.',
          },
          {
            step: '04',
            icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" /></svg>',
            title: 'Train & Track',
            desc: 'Begin training with monthly progress check-ins, plan adjustments, and regular body measurements.',
          },
        ].map(item => (
          <div class="reveal-item text-center relative">
            <div class="w-12 h-12 mx-auto rounded-full bg-[var(--primary-accent)]/10 border-2 border-[var(--primary-accent)] flex items-center justify-center text-[var(--primary-accent)] mb-4 relative z-10 bg-[var(--card-bg)]" set:html={item.icon} />
            <span class="text-[10px] font-bold text-[var(--primary-accent)] uppercase tracking-wider block mb-2">Step {item.step}</span>
            <h4 class="text-sm font-bold text-[var(--text-color)] mb-2">{item.title}</h4>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a href="#prem-gym-join" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity shadow-lg shadow-[var(--primary-accent)]/20">
        Start Your Free Trial
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </div>
</section>
