---
/**
 * VirtualTour.astro — Premium gym component
 * Interactive facility tour with hotspot navigation
 */
---

<section class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">Facility Tour</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Explore Our Facility</h2>
      <p class="text-[var(--text-muted)] text-sm mt-4">Click through different zones to experience our world-class training environment.</p>
    </div>

    <!-- Zone Selector -->
    <div class="flex flex-wrap justify-center gap-2 mb-8">
      {[
        { id: 'weights', label: 'Weight Zone', icon: '🏋️' },
        { id: 'cardio', label: 'Cardio Floor', icon: '🏃' },
        { id: 'functional', label: 'Functional Area', icon: '⚡' },
        { id: 'studio', label: 'Group Studio', icon: '🧘' },
      ].map((zone, i) => (
        <button class={`gym-tour-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all duration-200 ${i === 0 ? 'bg-[var(--primary-accent)] text-white' : 'bg-[var(--card-bg)] border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]'}`} data-zone={zone.id}>
          <span class="mr-1.5">{zone.icon}</span>{zone.label}
        </button>
      ))}
    </div>

    <!-- Tour Content -->
    <div class="relative">
      <div class="gym-tour-zone active" data-zone-content="weights">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)] aspect-video relative">
            <img src="/images/gym-floor.png" alt="Weight training zone" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="text-[9px] font-bold px-2 py-1 rounded bg-[var(--primary-accent)]/80 text-white uppercase">Weight Zone</span>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Free Weights & Machines</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">3,000 sq ft dedicated to strength training with premium equipment from Life Fitness and Hammer Strength.</p>
            <ul class="space-y-2">
              {['Olympic platforms (3)', 'Power racks (6)', 'Cable crossover stations (4)', 'Dumbbells up to 60kg', 'Smith machines (2)'].map(item => (
                <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                  <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="gym-tour-zone hidden" data-zone-content="cardio">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)] aspect-video relative">
            <img src="/images/gym-floor.png" alt="Cardio floor" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="text-[9px] font-bold px-2 py-1 rounded bg-blue-500/80 text-white uppercase">Cardio Floor</span>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Cardio & Endurance</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Climate-controlled cardio zone with entertainment screens and heart-rate monitoring equipment.</p>
            <ul class="space-y-2">
              {['Treadmills with TV (12)', 'Elliptical trainers (8)', 'Rowing machines (4)', 'Assault bikes (6)', 'StairMasters (4)'].map(item => (
                <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                  <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="gym-tour-zone hidden" data-zone-content="functional">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)] aspect-video relative">
            <img src="/images/gym-groupclass.png" alt="Functional training area" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="text-[9px] font-bold px-2 py-1 rounded bg-yellow-500/80 text-white uppercase">Functional Area</span>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Functional Training</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Open space for functional movement, CrossFit-style workouts, and athletic performance training.</p>
            <ul class="space-y-2">
              {['Battle ropes & sleds', 'TRX suspension systems', 'Kettlebells (8-48kg)', 'Medicine balls & plyo boxes', 'Turf sprint track (15m)'].map(item => (
                <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                  <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="gym-tour-zone hidden" data-zone-content="studio">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)] aspect-video relative">
            <img src="/images/gym-groupclass.png" alt="Group studio" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class="text-[9px] font-bold px-2 py-1 rounded bg-purple-500/80 text-white uppercase">Group Studio</span>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Group Class Studio</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Dedicated studio space with mirrored walls, sound system, and climate control for group fitness classes.</p>
            <ul class="space-y-2">
              {['Yoga mats & props', 'Professional sound system', 'Full-wall mirrors', 'Cycling studio (20 bikes)', 'Boxing area with bags'].map(item => (
                <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                  <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('astro:page-load', () => {
  const btns = document.querySelectorAll('.gym-tour-btn');
  const zones = document.querySelectorAll('.gym-tour-zone');
  if (btns.length === 0) return;

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-zone');
      
      btns.forEach(b => {
        b.classList.remove('bg-[var(--primary-accent)]', 'text-white');
        b.classList.add('bg-[var(--card-bg)]', 'border', 'border-[var(--border-color)]', 'text-[var(--text-muted)]');
      });
      btn.classList.add('bg-[var(--primary-accent)]', 'text-white');
      btn.classList.remove('bg-[var(--card-bg)]', 'border', 'border-[var(--border-color)]', 'text-[var(--text-muted)]');
      
      zones.forEach(zone => {
        if (zone.getAttribute('data-zone-content') === target) {
          zone.classList.remove('hidden');
          zone.classList.add('active');
        } else {
          zone.classList.add('hidden');
          zone.classList.remove('active');
        }
      });
    });
  });
});
</script>
