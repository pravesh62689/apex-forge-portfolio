---

<section class="relative overflow-hidden bg-ink-950 py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Copy -->
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-black bg-brand-primary/10 text-brand-primary border border-brand-primary/30 uppercase tracking-widest font-sans">
          <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>
          Elite Strength & Conditioning · Noida
        </span>
        <h1 class="hero-headline text-[clamp(2.5rem,5vw+1.5rem,4.5rem)] font-black text-brand-primary leading-[1.05] font-display uppercase tracking-tight">
          No limits.<br />just results.
        </h1>
        <p class="text-sm md:text-base text-themeTextMuted leading-relaxed max-w-xl font-sans font-medium">
          A premium strength and athletic training facility in Noida Sector 62. Outfitted with competition-grade barbells, custom power racks, and expert coaches to transform your performance.
        </p>
        <div class="pt-4 flex flex-wrap gap-4 font-sans">
          <a href="#plans" class="btn-magnetic px-8 py-4 rounded-xl text-xs font-black uppercase tracking-wider bg-brand-primary hover:bg-brand-primary/95 text-white shadow-lg shadow-brand-primary/25 transition-all">
            Join the Club
          </a>
          <a href="#schedule" class="btn-magnetic px-8 py-4 rounded-xl text-xs font-black uppercase tracking-wider bg-ink-900 border border-ink-border hover:bg-ink-800 text-themeText transition-all">
            View Schedule
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-[420px] aspect-[4/5] rounded-[32px] overflow-hidden shadow-2xl border border-ink-border group">
          <img 
            src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=600&q=80" 
            alt="Intense Barbells Gym Training" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-90 grayscale-[10%]" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 inset-x-6 p-4 rounded-2xl bg-ink-950/70 backdrop-blur-md border border-ink-border text-center">
            <span class="text-xs font-black text-white block uppercase tracking-wider">Limited Slots Active</span>
            <span class="text-[10px] text-brand-primary font-bold block mt-1 uppercase tracking-widest">Free Trial Session Available</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
