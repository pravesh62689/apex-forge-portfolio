---
/**
 * ClassBooking.astro — Premium gym component
 * Interactive class booking system with schedule selector
 */
---

<section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">Book a Class</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Reserve Your Spot</h2>
      <p class="text-[var(--text-muted)] text-sm mt-4">Select a class, pick your preferred time, and book instantly.</p>
    </div>

    <div class="bg-[var(--bg-color)] border border-[var(--border-color)] rounded-3xl p-6 md:p-8">
      <!-- Step Indicator -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="booking-step-dot flex items-center gap-2" data-step="1">
          <div class="w-8 h-8 rounded-full bg-[var(--primary-accent)] text-white flex items-center justify-center text-xs font-bold">1</div>
          <span class="text-xs font-bold text-[var(--text-color)] hidden sm:inline">Select Class</span>
        </div>
        <div class="w-8 h-0.5 bg-[var(--border-color)]"></div>
        <div class="booking-step-dot flex items-center gap-2 opacity-40" data-step="2">
          <div class="w-8 h-8 rounded-full bg-[var(--card-bg)] border border-[var(--border-color)] text-[var(--text-muted)] flex items-center justify-center text-xs font-bold">2</div>
          <span class="text-xs font-bold text-[var(--text-muted)] hidden sm:inline">Pick Time</span>
        </div>
        <div class="w-8 h-0.5 bg-[var(--border-color)]"></div>
        <div class="booking-step-dot flex items-center gap-2 opacity-40" data-step="3">
          <div class="w-8 h-8 rounded-full bg-[var(--card-bg)] border border-[var(--border-color)] text-[var(--text-muted)] flex items-center justify-center text-xs font-bold">3</div>
          <span class="text-xs font-bold text-[var(--text-muted)] hidden sm:inline">Confirm</span>
        </div>
      </div>

      <!-- Step 1: Select Class -->
      <div id="booking-step-1" class="booking-step-content">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {[
            { name: 'Power Yoga', time: '45 min', trainer: 'Meera K.', spots: 8, icon: '🧘' },
            { name: 'HIIT Blast', time: '30 min', trainer: 'Vikram S.', spots: 5, icon: '🔥' },
            { name: 'CrossFit WOD', time: '60 min', trainer: 'Arjun P.', spots: 12, icon: '💪' },
            { name: 'Zumba Dance', time: '45 min', trainer: 'Priya M.', spots: 15, icon: '💃' },
            { name: 'Boxing Basics', time: '45 min', trainer: 'Rohit D.', spots: 6, icon: '🥊' },
            { name: 'Spin Cycle', time: '40 min', trainer: 'Anita R.', spots: 10, icon: '🚴' },
          ].map(cls => (
            <button class="class-select-btn p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] text-left hover:border-[var(--primary-accent)]/50 transition-all duration-200 group" data-class={cls.name}>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-lg">{cls.icon}</span>
                <h4 class="text-sm font-bold text-[var(--text-color)] group-hover:text-[var(--primary-accent)] transition-colors">{cls.name}</h4>
              </div>
              <div class="flex justify-between text-[10px] text-[var(--text-muted)]">
                <span>{cls.time} · {cls.trainer}</span>
                <span class="text-[var(--primary-accent)] font-bold">{cls.spots} spots</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Pick Time (hidden) -->
      <div id="booking-step-2" class="booking-step-content hidden">
        <div class="text-center mb-6">
          <p class="text-sm text-[var(--text-muted)]">Selected: <strong id="selected-class-name" class="text-[var(--text-color)]"></strong></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {[
            'Mon 6:00 AM', 'Mon 7:00 PM', 'Tue 6:00 AM', 'Tue 5:30 PM',
            'Wed 6:00 AM', 'Wed 7:00 PM', 'Thu 6:00 AM', 'Thu 5:30 PM',
            'Fri 6:00 AM', 'Fri 7:00 PM', 'Sat 8:00 AM', 'Sat 10:00 AM',
          ].map(time => (
            <button class="time-select-btn p-3 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] text-xs font-semibold text-[var(--text-color)] hover:border-[var(--primary-accent)]/50 transition-all" data-time={time}>
              {time}
            </button>
          ))}
        </div>
        <button id="booking-back-1" class="mt-6 text-xs text-[var(--text-muted)] hover:text-[var(--text-color)] transition-colors">← Back to classes</button>
      </div>

      <!-- Step 3: Confirm (hidden) -->
      <div id="booking-step-3" class="booking-step-content hidden">
        <div class="max-w-md mx-auto text-center space-y-6">
          <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-3">
            <h3 class="text-lg font-bold text-[var(--text-color)] font-display">Booking Summary</h3>
            <div class="text-sm text-[var(--text-muted)] space-y-1">
              <p>Class: <strong id="confirm-class" class="text-[var(--text-color)]"></strong></p>
              <p>Time: <strong id="confirm-time" class="text-[var(--text-color)]"></strong></p>
            </div>
          </div>
          <button id="booking-confirm" class="w-full py-3.5 rounded-xl bg-[var(--primary-accent)] text-white text-sm font-bold hover:opacity-90 transition-opacity">Confirm Booking</button>
          <button id="booking-back-2" class="text-xs text-[var(--text-muted)] hover:text-[var(--text-color)] transition-colors">← Change time</button>
        </div>
      </div>

      <!-- Success (hidden) -->
      <div id="booking-success" class="booking-step-content hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 mx-auto rounded-full bg-green-500/10 border-2 border-green-500 flex items-center justify-center">
          <svg class="w-8 h-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Spot Reserved!</h3>
        <p class="text-sm text-[var(--text-muted)]">Your class booking has been confirmed. (Demo only)</p>
        <button id="booking-reset" class="text-xs font-bold text-[var(--primary-accent)] hover:underline">Book Another Class</button>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('astro:page-load', () => {
  let selectedClass = '';
  let selectedTime = '';

  const steps = {
    1: document.getElementById('booking-step-1'),
    2: document.getElementById('booking-step-2'),
    3: document.getElementById('booking-step-3'),
  };
  const success = document.getElementById('booking-success');
  const dots = document.querySelectorAll('.booking-step-dot');

  function showStep(n) {
    Object.values(steps).forEach(s => s?.classList.add('hidden'));
    success?.classList.add('hidden');
    steps[n]?.classList.remove('hidden');
    dots.forEach(d => {
      const s = parseInt(d.getAttribute('data-step') || '1');
      d.style.opacity = s <= n ? '1' : '0.4';
    });
  }

  document.querySelectorAll('.class-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedClass = btn.getAttribute('data-class') || '';
      const nameEl = document.getElementById('selected-class-name');
      if (nameEl) nameEl.textContent = selectedClass;
      showStep(2);
    });
  });

  document.querySelectorAll('.time-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedTime = btn.getAttribute('data-time') || '';
      const classEl = document.getElementById('confirm-class');
      const timeEl = document.getElementById('confirm-time');
      if (classEl) classEl.textContent = selectedClass;
      if (timeEl) timeEl.textContent = selectedTime;
      showStep(3);
    });
  });

  document.getElementById('booking-back-1')?.addEventListener('click', () => showStep(1));
  document.getElementById('booking-back-2')?.addEventListener('click', () => showStep(2));

  document.getElementById('booking-confirm')?.addEventListener('click', () => {
    Object.values(steps).forEach(s => s?.classList.add('hidden'));
    success?.classList.remove('hidden');
  });

  document.getElementById('booking-reset')?.addEventListener('click', () => {
    selectedClass = '';
    selectedTime = '';
    showStep(1);
  });
});
</script>
