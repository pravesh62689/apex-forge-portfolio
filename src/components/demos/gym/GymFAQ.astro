---
/**
 * GymFAQ.astro — Standard gym tier FAQ component
 */
---

<section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-3xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">FAQ</span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Membership Questions</h2>
    </div>

    <div class="space-y-3" id="gym-faq-container">
      {[
        { q: 'What are the gym operating hours?', a: 'We are open Monday to Saturday from 5:00 AM to 10:00 PM, and Sundays from 7:00 AM to 6:00 PM. Personal training sessions can be scheduled outside regular hours.' },
        { q: 'Can I freeze my membership?', a: 'Yes, you can freeze your membership for up to 30 days per year for medical or travel reasons. Contact the front desk with advance notice.' },
        { q: 'Is there a personal trainer included?', a: 'Basic membership includes a free fitness assessment and workout plan. Personal training sessions are available with Standard and Premium memberships at additional or included rates.' },
        { q: 'Do you offer group classes?', a: 'Yes! We offer yoga, HIIT, Zumba, functional training, and CrossFit classes included with Standard and Premium memberships.' },
        { q: 'Is there a trial period?', a: 'We offer a free 1-day trial pass. You can experience the full gym facilities, attend a group class, and consult with a trainer before committing.' },
        { q: 'What facilities are available in the locker room?', a: 'Clean locker rooms with hot showers, fresh towels, drinking water station, and personal storage lockers are available for all members.' },
      ].map((item, i) => (
        <div class="faq-item border border-[var(--border-color)] rounded-xl overflow-hidden bg-[var(--bg-color)]">
          <button class="faq-trigger w-full flex items-center justify-between p-4 text-left text-sm font-semibold text-[var(--text-color)] hover:text-[var(--primary-accent)] transition-colors" data-faq-index={i}>
            <span>{item.q}</span>
            <svg class="faq-chevron w-4 h-4 flex-shrink-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
document.addEventListener('astro:page-load', () => {
  document.querySelectorAll('#gym-faq-container .faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling;
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = !answer?.classList.contains('hidden');
      
      // Close all others
      document.querySelectorAll('#gym-faq-container .faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('#gym-faq-container .faq-chevron').forEach(c => c.style.transform = '');
      
      if (!isOpen && answer) {
        answer.classList.remove('hidden');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
});
</script>
