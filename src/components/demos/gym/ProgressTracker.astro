---
/**
 * ProgressTracker.astro — Premium gym component
 * Interactive fitness progress tracking UI mockup
 */
---

<section class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20 uppercase tracking-wider mb-4">Track Progress</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Your Fitness Dashboard</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4 max-w-lg mx-auto">Monitor your transformation with real-time metrics, workout logs, and achievement milestones.</p>
    </div>

    <!-- Dashboard mockup -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <!-- Stats cards -->
      {[
        { label: 'Workouts This Month', value: '18', trend: '+3 vs last month', icon: 'M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z', color: 'red' },
        { label: 'Current Streak', value: '12 Days', trend: 'Personal best!', icon: 'm3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z', color: 'amber' },
        { label: 'Body Fat', value: '18.2%', trend: '-2.1% this quarter', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z', color: 'green' },
      ].map(stat => (
        <div class="showcase-card p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider">{stat.label}</span>
            <svg class={`w-4 h-4 text-${stat.color}-500`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} /></svg>
          </div>
          <span class="text-2xl font-extrabold text-[var(--text-color)] block">{stat.value}</span>
          <span class="text-[10px] text-green-500 font-medium">{stat.trend}</span>
        </div>
      ))}
    </div>

    <!-- Progress chart mockup -->
    <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] mb-10">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-sm font-bold text-[var(--text-color)]">Weekly Activity</h3>
        <div class="flex gap-2">
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20">This Week</span>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-[var(--card-bg-hover)] text-[var(--text-muted)]">Last Week</span>
        </div>
      </div>
      <!-- Simplified bar chart -->
      <div class="flex items-end gap-2 h-32">
        {[
          { day: 'Mon', current: 85, prev: 60 },
          { day: 'Tue', current: 60, prev: 75 },
          { day: 'Wed', current: 95, prev: 50 },
          { day: 'Thu', current: 45, prev: 80 },
          { day: 'Fri', current: 100, prev: 70 },
          { day: 'Sat', current: 70, prev: 90 },
          { day: 'Sun', current: 30, prev: 40 },
        ].map(bar => (
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full flex gap-0.5 items-end" style={`height: ${Math.max(bar.current, bar.prev)}%`}>
              <div class="flex-1 rounded-t-md bg-[var(--primary-accent)]/20 border border-[var(--primary-accent)]/30 transition-all duration-500" style={`height: ${bar.prev}%`}></div>
              <div class="flex-1 rounded-t-md bg-[var(--primary-accent)] transition-all duration-500" style={`height: ${bar.current}%`}></div>
            </div>
            <span class="text-[9px] text-[var(--text-muted)] font-medium">{bar.day}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Achievement badges -->
    <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)]">
      <h3 class="text-sm font-bold text-[var(--text-color)] mb-4">Achievements</h3>
      <div class="flex flex-wrap gap-3">
        {[
          { name: 'First Workout', emoji: '🏋️', unlocked: true },
          { name: '7-Day Streak', emoji: '🔥', unlocked: true },
          { name: '10K Steps', emoji: '👟', unlocked: true },
          { name: '100 Workouts', emoji: '💯', unlocked: false },
          { name: 'Heavy Lifter', emoji: '🏆', unlocked: false },
          { name: 'Marathon Ready', emoji: '🏃', unlocked: false },
        ].map(badge => (
          <div class={`flex items-center gap-2 px-3 py-2 rounded-xl border ${badge.unlocked ? 'border-[var(--primary-accent)]/30 bg-[var(--primary-accent)]/5' : 'border-[var(--border-color)] bg-[var(--card-bg-hover)] opacity-50'}`}>
            <span class="text-base">{badge.emoji}</span>
            <span class={`text-[10px] font-bold ${badge.unlocked ? 'text-[var(--primary-accent)]' : 'text-[var(--text-muted)]'}`}>{badge.name}</span>
            {badge.unlocked && <svg class="w-3 h-3 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>}
          </div>
        ))}
      </div>
    </div>

    <p class="text-center text-[9px] text-[var(--text-muted)] mt-6">This is a demo UI mockup. Actual tracking requires integration with fitness apps.</p>
  </div>
</section>
