---
/**
 * ProgramPages.astro — Premium gym component
 * Detailed workout program cards with progressive difficulty
 */
---

<section class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">Programs</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Specialized Training Programs</h2>
      <p class="text-[var(--text-muted)] text-sm mt-4">Structured programs designed by certified trainers for every fitness level.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        {
          name: 'Strength Foundation',
          level: 'Beginner',
          duration: '8 Weeks',
          sessions: '3x/week',
          desc: 'Build a solid base with compound movements, proper form, and progressive overload principles.',
          focus: ['Squat & Deadlift form', 'Bench & Overhead press', 'Core stability', 'Flexibility work'],
          color: 'green',
        },
        {
          name: 'Muscle Hypertrophy',
          level: 'Intermediate',
          duration: '12 Weeks',
          sessions: '5x/week',
          desc: 'Targeted muscle-building program with split routines, volume training, and nutrition guidance.',
          focus: ['Push/Pull/Legs split', 'Progressive volume', 'Mind-muscle connection', 'Nutrition planning'],
          color: 'blue',
        },
        {
          name: 'Athletic Performance',
          level: 'Advanced',
          duration: '16 Weeks',
          sessions: '5-6x/week',
          desc: 'High-performance training combining strength, power, agility, and sport-specific conditioning.',
          focus: ['Olympic lifts', 'Plyometric training', 'Speed & agility', 'Recovery protocols'],
          color: 'orange',
        },
        {
          name: 'Fat Loss Transformation',
          level: 'All Levels',
          duration: '10 Weeks',
          sessions: '4x/week',
          desc: 'Metabolic conditioning with circuit training, HIIT, and structured nutrition to maximize fat loss while preserving muscle.',
          focus: ['HIIT circuits', 'Metabolic conditioning', 'Calorie tracking', 'Weekly check-ins'],
          color: 'red',
        },
      ].map(program => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4 hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between">
            <h4 class="text-base font-bold text-[var(--text-color)]">{program.name}</h4>
            <span class={`text-[9px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider bg-${program.color}-500/10 text-${program.color}-500 border border-${program.color}-500/20`}>{program.level}</span>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">{program.desc}</p>
          
          <div class="flex gap-4 text-xs text-[var(--text-muted)]">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[var(--primary-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              {program.duration}
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[var(--primary-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
              {program.sessions}
            </span>
          </div>

          <div class="pt-3 border-t border-[var(--border-color)]">
            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider block mb-2">Focus Areas</span>
            <div class="flex flex-wrap gap-2">
              {program.focus.map(f => (
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-[var(--primary-accent)]/10 text-[var(--primary-accent)]">{f}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
