---
---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-black uppercase tracking-widest text-brand-primary block mb-3 font-sans">
        Real Progress
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-black text-themeText mb-4 font-display uppercase tracking-tight">
        Transformation Gallery
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm font-sans font-medium">
        See the real results achieved by our dedicated members under our structured programming.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto font-sans">
      
      <!-- Transformation 1 -->
      <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl overflow-hidden shadow-lg group hover:border-brand-primary/20 transition-all duration-300">
        <div class="grid grid-cols-2 divide-x divide-ink-border border-b border-ink-border">
          <div class="relative aspect-[4/5] bg-ink-950 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=300&q=80" 
              alt="Before Training" 
              class="w-full h-full object-cover filter brightness-75 grayscale" 
            />
            <span class="absolute top-3 left-3 bg-black/60 px-2 py-0.5 rounded text-[8px] font-black uppercase text-white tracking-wider">Before</span>
          </div>
          <div class="relative aspect-[4/5] bg-ink-950 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?auto=format&fit=crop&w=300&q=80" 
              alt="After Training" 
              class="w-full h-full object-cover filter brightness-90" 
            />
            <span class="absolute top-3 left-3 bg-brand-primary px-2 py-0.5 rounded text-[8px] font-black uppercase text-white tracking-wider">12 Weeks</span>
          </div>
        </div>
        <div class="p-6 space-y-2">
          <div class="flex justify-between items-start">
            <h4 class="text-sm font-black text-themeText uppercase tracking-wider">Aman S. (IT Professional)</h4>
            <span class="text-[10px] text-brand-primary font-bold">Lost 8kg & Gained Strength</span>
          </div>
          <p class="text-[10px] text-themeTextMuted leading-relaxed">
            "Dev's linear progression program helped me rebuild my posture, get rid of back pain, and hit a 140kg deadlift milestone."
          </p>
          <div class="flex items-center gap-1 text-[8px] text-brand-accent/70 font-semibold uppercase tracking-wider mt-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
            <span>Illustrative Demo Result</span>
          </div>
        </div>
      </div>

      <!-- Transformation 2 -->
      <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl overflow-hidden shadow-lg group hover:border-brand-primary/20 transition-all duration-300">
        <div class="grid grid-cols-2 divide-x divide-ink-border border-b border-ink-border">
          <div class="relative aspect-[4/5] bg-ink-950 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1518310383802-640c2de311b2?auto=format&fit=crop&w=300&q=80" 
              alt="Before Training" 
              class="w-full h-full object-cover filter brightness-75 grayscale" 
            />
            <span class="absolute top-3 left-3 bg-black/60 px-2 py-0.5 rounded text-[8px] font-black uppercase text-white tracking-wider">Before</span>
          </div>
          <div class="relative aspect-[4/5] bg-ink-950 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1594381898411-846e7d193883?auto=format&fit=crop&w=300&q=80" 
              alt="After Training" 
              class="w-full h-full object-cover filter brightness-90" 
            />
            <span class="absolute top-3 left-3 bg-brand-primary px-2 py-0.5 rounded text-[8px] font-black uppercase text-white tracking-wider">6 Months</span>
          </div>
        </div>
        <div class="p-6 space-y-2">
          <div class="flex justify-between items-start">
            <h4 class="text-sm font-black text-themeText uppercase tracking-wider">Riya M. (Athlete)</h4>
            <span class="text-[10px] text-brand-primary font-bold">Improved Power & Conditioning</span>
          </div>
          <p class="text-[10px] text-themeTextMuted leading-relaxed">
            "Focused on explosive speed drills and core stability. My vertical jump increased by 4 inches and body fat dropped from 22% to 15%."
          </p>
          <div class="flex items-center gap-1 text-[8px] text-brand-accent/70 font-semibold uppercase tracking-wider mt-2">
            <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
            <span>Illustrative Demo Result</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
