---
---

<div class="table-selector-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6">
  <div class="text-center md:text-left space-y-2">
    <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2 justify-center md:justify-start">
      <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 8.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25A2.25 2.25 0 0 1 13.5 8.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
      </svg>
      Interactive Dining Room Seating Map
    </h4>
    <p class="text-xs text-[var(--text-muted)]">Select an active table on the floor plan below to check its availability, guest capacity, and atmosphere.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Seating map SVG -->
    <div class="lg:col-span-8 flex justify-center bg-black/30 p-4 rounded-2xl border border-[var(--border-color)]">
      <svg id="restaurant-map" viewBox="0 0 800 450" class="w-full max-w-[650px] h-auto select-none">
        <!-- Definitions for styling -->
        <defs>
          <radialGradient id="table-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="rgba(245, 158, 11, 0.4)" />
            <stop offset="100%" stop-color="rgba(0, 0, 0, 0)" />
          </radialGradient>
        </defs>

        <!-- Floor boundaries -->
        <rect x="10" y="10" width="780" height="430" rx="20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
        
        <!-- Entrance & Kitchen markers -->
        <g opacity="0.3">
          <rect x="350" y="435" width="100" height="10" rx="5" fill="var(--text-color)" />
          <text x="400" y="425" text-anchor="middle" font-size="12" fill="var(--text-color)" class="font-sans font-bold tracking-wider">ENTRANCE</text>

          <rect x="20" y="150" width="10" height="150" rx="5" fill="var(--text-color)" />
          <text x="40" y="230" text-anchor="middle" transform="rotate(-90 40 230)" font-size="12" fill="var(--text-color)" class="font-sans font-bold tracking-wider">KITCHEN</text>

          <!-- Window line -->
          <line x1="790" y1="50" x2="790" y2="400" stroke="rgba(6, 182, 212, 0.3)" stroke-width="4" stroke-dasharray="10 5" />
          <text x="775" y="225" text-anchor="middle" transform="rotate(90 775 225)" font-size="10" fill="rgba(6, 182, 212, 0.7)" class="font-sans font-bold tracking-wider">WINDOW VIEWS (NOIDA EXPRESSWAY)</text>
        </g>

        <!-- Bar Area -->
        <g>
          <rect x="250" y="30" width="300" height="60" rx="10" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
          <text x="400" y="65" text-anchor="middle" font-size="12" fill="var(--text-muted)" class="font-sans font-bold tracking-widest">COCKTAIL & ESPRESSO BAR</text>
        </g>

        <!-- Interactive Tables -->
        <!-- Table 1 (Window Seating) -->
        <g class="interactive-table cursor-pointer group" data-id="1" data-name="Table 1 (Premium Window)" data-capacity="2 Guests" data-zone="Expressway Window View" data-desc="Cozy candlelit table right next to the glass facade. Perfect for couples and intimate dinners.">
          <circle cx="700" cy="120" r="30" class="table-body transition-colors fill-zinc-800 stroke-zinc-700 group-hover:fill-amber-500/20 group-hover:stroke-amber-500" stroke-width="2" />
          <!-- Chairs -->
          <circle cx="700" cy="75" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="700" cy="165" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <text x="700" y="124" text-anchor="middle" font-size="12" class="font-sans font-bold fill-zinc-400 group-hover:fill-white">T1</text>
        </g>

        <!-- Table 2 (Window Seating) -->
        <g class="interactive-table cursor-pointer group" data-id="2" data-name="Table 2 (Premium Window)" data-capacity="4 Guests" data-zone="Expressway Window View" data-desc="Spacious window-side table offering high-altitude night lights views. Popular for small group celebrations.">
          <rect x="670" y="240" width="60" height="60" rx="10" class="table-body transition-colors fill-zinc-800 stroke-zinc-700 group-hover:fill-amber-500/20 group-hover:stroke-amber-500" stroke-width="2" />
          <!-- Chairs -->
          <rect x="648" y="250" width="10" height="16" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="648" y="274" width="10" height="16" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="742" y="250" width="10" height="16" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="742" y="274" width="10" height="16" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <text x="700" y="274" text-anchor="middle" font-size="12" class="font-sans font-bold fill-zinc-400 group-hover:fill-white">T2</text>
        </g>

        <!-- Table 3 (Main Hall) -->
        <g class="interactive-table cursor-pointer group" data-id="3" data-name="Table 3 (Standard Booth)" data-capacity="4 Guests" data-zone="Main Dining Room" data-desc="Plush semi-private booth in the heart of the main dining room. Ideal for quiet family meals and business conversations.">
          <rect x="420" y="160" width="80" height="50" rx="8" class="table-body transition-colors fill-zinc-800 stroke-zinc-700 group-hover:fill-amber-500/20 group-hover:stroke-amber-500" stroke-width="2" />
          <!-- Chairs -->
          <rect x="430" y="138" width="18" height="10" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="472" y="138" width="18" height="10" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="430" y="222" width="18" height="10" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <rect x="472" y="222" width="18" height="10" rx="3" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <text x="460" y="190" text-anchor="middle" font-size="12" class="font-sans font-bold fill-zinc-400 group-hover:fill-white">T3</text>
        </g>

        <!-- Table 4 (Private Lounge) -->
        <g class="interactive-table cursor-pointer group" data-id="4" data-name="Table 4 (VIP Round Lounge)" data-capacity="6-8 Guests" data-zone="VIP Private Salon" data-desc="Ultra-premium circular seating surrounded by acoustic wood paneling and featuring a customized chandelier. Perfect for birthday parties and executive boards.">
          <circle cx="150" cy="225" r="45" class="table-body transition-colors fill-zinc-800 stroke-zinc-700 group-hover:fill-amber-500/20 group-hover:stroke-amber-500" stroke-width="2" />
          <!-- Chairs surrounding circle -->
          <circle cx="150" cy="168" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="150" cy="282" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="93" cy="225" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="207" cy="225" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="110" cy="185" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="190" cy="185" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="110" cy="265" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="190" cy="265" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <text x="150" y="229" text-anchor="middle" font-size="12" class="font-sans font-bold fill-zinc-400 group-hover:fill-white">T4 VIP</text>
        </g>

        <!-- Table 5 (Main Hall Center) -->
        <g class="interactive-table cursor-pointer group" data-id="5" data-name="Table 5 (Standard Center)" data-capacity="2 Guests" data-zone="Main Dining Room" data-desc="Central main hall dining table. Lively atmosphere with proximity to the live mocktail bar.">
          <circle cx="460" cy="320" r="25" class="table-body transition-colors fill-zinc-800 stroke-zinc-700 group-hover:fill-amber-500/20 group-hover:stroke-amber-500" stroke-width="2" />
          <!-- Chairs -->
          <circle cx="418" cy="320" r="7" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <circle cx="502" cy="320" r="7" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" />
          <text x="460" y="324" text-anchor="middle" font-size="11" class="font-sans font-bold fill-zinc-400 group-hover:fill-white">T5</text>
        </g>
      </svg>
    </div>

    <!-- Interactive info card details -->
    <div class="lg:col-span-4 space-y-4">
      <div id="table-details-box" class="p-6 rounded-2xl bg-zinc-900/50 border border-[var(--border-color)] space-y-4">
        <div class="space-y-1">
          <span class="text-[9px] font-bold text-amber-500 uppercase tracking-widest block" id="table-zone">Select a Table</span>
          <h5 class="text-base font-bold text-[var(--text-color)] font-display" id="table-title">No Table Selected</h5>
        </div>
        
        <p class="text-xs text-[var(--text-muted)] leading-relaxed min-h-[60px]" id="table-desc">
          Click on any numbered table icon (T1 - T5) in the seating blueprint diagram to check detailed room parameters, specific sights views, and seating characteristics.
        </p>

        <div class="grid grid-cols-2 gap-4 border-t border-[var(--border-color)] pt-4 text-xs">
          <div>
            <span class="text-zinc-500 block text-[9px] uppercase font-bold">Capacity</span>
            <span class="text-[var(--text-color)] font-bold font-sans mt-0.5 block" id="table-cap">—</span>
          </div>
          <div>
            <span class="text-zinc-500 block text-[9px] uppercase font-bold">Status</span>
            <span class="text-emerald-500 font-bold font-sans mt-0.5 block" id="table-status">Available</span>
          </div>
        </div>

        <button id="book-selected-table-btn" disabled class="w-full py-3 rounded-xl bg-amber-600/20 text-zinc-500 text-xs font-bold border border-zinc-700/50 transition-all duration-300">
          Book Selected Table
        </button>
      </div>

      <!-- Live statistics indicators -->
      <div class="grid grid-cols-3 gap-2 text-center text-[10px] font-bold uppercase tracking-wider">
        <div class="p-2.5 rounded-xl border border-[var(--border-color)] bg-zinc-900/20">
          <span class="text-amber-500 block text-xs">18 / 20</span>
          <span class="text-zinc-500 text-[8px] mt-0.5 block">Total Tables</span>
        </div>
        <div class="p-2.5 rounded-xl border border-[var(--border-color)] bg-zinc-900/20">
          <span class="text-emerald-500 block text-xs">3 Free</span>
          <span class="text-zinc-500 text-[8px] mt-0.5 block">Noida Hall</span>
        </div>
        <div class="p-2.5 rounded-xl border border-[var(--border-color)] bg-zinc-900/20">
          <span class="text-cyan-500 block text-xs">92%</span>
          <span class="text-zinc-500 text-[8px] mt-0.5 block">Occupancy</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initTableSelector() {
    const tables = document.querySelectorAll('.interactive-table');
    const zoneEl = document.getElementById('table-zone');
    const titleEl = document.getElementById('table-title');
    const descEl = document.getElementById('table-desc');
    const capEl = document.getElementById('table-cap');
    const btnEl = document.getElementById('book-selected-table-btn');

    tables.forEach(table => {
      table.addEventListener('click', () => {
        // Reset all tables highlight styling classes
        tables.forEach(t => {
          const body = t.querySelector('.table-body');
          if (body) {
            body.classList.remove('fill-amber-500/20', 'stroke-amber-500');
            body.classList.add('fill-zinc-800', 'stroke-zinc-700');
          }
          t.querySelector('text')?.classList.remove('fill-white');
          t.querySelector('text')?.classList.add('fill-zinc-400');
        });

        // Set active table styling
        const body = table.querySelector('.table-body');
        if (body) {
          body.classList.remove('fill-zinc-800', 'stroke-zinc-700');
          body.classList.add('fill-amber-500/20', 'stroke-amber-500');
        }
        table.querySelector('text')?.classList.remove('fill-zinc-400');
        table.querySelector('text')?.classList.add('fill-white');

        // Extract metadata attributes
        const name = table.getAttribute('data-name');
        const cap = table.getAttribute('data-capacity');
        const zone = table.getAttribute('data-zone');
        const desc = table.getAttribute('data-desc');

        // Update details panel
        if (zoneEl) zoneEl.textContent = zone;
        if (titleEl) titleEl.textContent = name;
        if (descEl) descEl.textContent = desc;
        if (capEl) capEl.textContent = cap;

        // Enable booking button
        if (btnEl) {
          btnEl.removeAttribute('disabled');
          btnEl.className = "w-full py-3 rounded-xl bg-amber-600 text-white text-xs font-bold shadow-lg shadow-amber-600/10 hover:bg-amber-700 transition-all duration-300";
          btnEl.textContent = `Reserve ${name}`;
          
          // Connect action
          btnEl.onclick = () => {
            alert(`Selected table reservation: ${name} (${cap}) reserved mockingly! In a live build, this automatically pre-fills your reservation details below.`);
            const formDateInput = document.querySelector('#prem-reserve input[type="date"]');
            const formGuestsInput = document.querySelector('#prem-reserve select:nth-of-type(2)');
            if (formGuestsInput) {
              // Pre-select guest count
              if (cap.includes('2')) formGuestsInput.value = '1-2';
              else if (cap.includes('4')) formGuestsInput.value = '3-4';
              else if (cap.includes('6-8')) formGuestsInput.value = '7-10';
            }
            // Scroll down to the booking form automatically
            const bookingForm = document.getElementById('prem-reserve');
            if (bookingForm) {
              bookingForm.scrollIntoView({ behavior: 'smooth' });
            }
          };
        }
      });
    });
  }

  // Support view transitions
  initTableSelector();
  document.addEventListener('astro:page-load', initTableSelector);
</script>
