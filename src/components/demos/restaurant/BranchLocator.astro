---
---

<div class="branch-locator-card p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-6">
  <div class="text-center md:text-left space-y-2">
    <h4 class="text-lg font-bold text-[var(--text-color)] font-display flex items-center gap-2 justify-center md:justify-start">
      <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      Our Dining Rooms (Locations)
    </h4>
    <p class="text-xs text-[var(--text-muted)]">Switch between our locations to view local operational hours, maps directions, and specific menu exclusions.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <!-- Noida 62 Tab -->
    <button class="branch-tab-btn p-4 rounded-2xl border text-left bg-zinc-900/50 border-amber-500/30 text-[var(--text-color)] shadow-lg shadow-amber-500/5" data-branch="sec62">
      <span class="text-xs font-bold block">Noida Sector 62</span>
      <span class="text-[10px] text-amber-500 font-semibold block mt-0.5">Flagship Bistro</span>
    </button>
    
    <!-- Noida 18 Tab -->
    <button class="branch-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]" data-branch="sec18">
      <span class="text-xs font-bold block">Noida Sector 18</span>
      <span class="text-[10px] text-zinc-500 font-semibold block mt-0.5">Specialty Brew Bar</span>
    </button>

    <!-- Connaught Place Tab -->
    <button class="branch-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]" data-branch="cp">
      <span class="text-xs font-bold block">Connaught Place</span>
      <span class="text-[10px] text-zinc-500 font-semibold block mt-0.5">Rooftop Lounge</span>
    </button>
  </div>

  <!-- Noida 62 Details -->
  <div id="branch-details-sec62" class="branch-details-block block p-6 rounded-2xl border border-[var(--border-color)] bg-black/20 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs leading-relaxed text-[var(--text-muted)]">
      <div class="space-y-3">
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Address</span>
          <span class="text-[var(--text-color)] font-bold font-sans">Stellar IT Park, Sector 62, Noida, UP 201301</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Hours</span>
          <span class="text-[var(--text-color)] font-bold font-sans">8:00 AM - 11:00 PM (Daily)</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Phone</span>
          <a href="tel:+919999999999" class="text-amber-500 font-bold hover:underline font-sans">+91 99999 99999</a>
        </div>
      </div>
      <div class="space-y-2">
        <span class="text-[9px] uppercase font-bold text-zinc-500 block">Branch Highlights</span>
        <div class="flex flex-wrap gap-2 pt-1">
          {['Woodfired Sourdough', 'Expressway Facade View', 'In-house Roastery', 'Private Dining Room'].map(h => (
            <span class="text-[9px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20">{h}</span>
          ))}
        </div>
        <p class="text-[10px] text-zinc-500 leading-normal pt-2">Our flagship space overlooking the Noida expressway. Features a live organic coffee bean roaster and an open-view bakery parlor.</p>
      </div>
    </div>
  </div>

  <!-- Noida 18 Details -->
  <div id="branch-details-sec18" class="branch-details-block hidden p-6 rounded-2xl border border-[var(--border-color)] bg-black/20 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs leading-relaxed text-[var(--text-muted)]">
      <div class="space-y-3">
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Address</span>
          <span class="text-[var(--text-color)] font-bold font-sans">Wave Silver Tower, Sector 18, Noida, UP 201301</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Hours</span>
          <span class="text-[var(--text-color)] font-bold font-sans">10:00 AM - Midnight (Daily)</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Phone</span>
          <a href="tel:+918888888888" class="text-amber-500 font-bold hover:underline font-sans">+91 88888 88888</a>
        </div>
      </div>
      <div class="space-y-2">
        <span class="text-[9px] uppercase font-bold text-zinc-500 block">Branch Highlights</span>
        <div class="flex flex-wrap gap-2 pt-1">
          {['Patio Seating', 'Live Acoustic Weekends', 'Valet Parking', 'Specialty Syphon Brew Bar'].map(h => (
            <span class="text-[9px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20">{h}</span>
          ))}
        </div>
        <p class="text-[10px] text-zinc-500 leading-normal pt-2">Located in Noida's premier retail center. Known for its breezy outdoor courtyard and live acoustic lounge stages on Friday & Saturday evenings.</p>
      </div>
    </div>
  </div>

  <!-- Connaught Place Details -->
  <div id="branch-details-cp" class="branch-details-block hidden p-6 rounded-2xl border border-[var(--border-color)] bg-black/20 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs leading-relaxed text-[var(--text-muted)]">
      <div class="space-y-3">
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Address</span>
          <span class="text-[var(--text-color)] font-bold font-sans">Outer Circle, Connaught Place, New Delhi 110001</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Hours</span>
          <span class="text-[var(--text-color)] font-bold font-sans">11:00 AM - 1:00 AM (Daily)</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-zinc-500 block">Phone</span>
          <a href="tel:+917777777777" class="text-amber-500 font-bold hover:underline font-sans">+91 77777 77777</a>
        </div>
      </div>
      <div class="space-y-2">
        <span class="text-[9px] uppercase font-bold text-zinc-500 block">Branch Highlights</span>
        <div class="flex flex-wrap gap-2 pt-1">
          {['Heritage Architecture', 'Rooftop Skylights', 'Signature Cocktails', 'Late Night Kitchen'].map(h => (
            <span class="text-[9px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20">{h}</span>
          ))}
        </div>
        <p class="text-[10px] text-zinc-500 leading-normal pt-2">Our heritage Delhi outlet. Built inside a classic Georgian structure with a fully open glass rooftop overlooking central CP lights.</p>
      </div>
    </div>
  </div>
</div>

<script>
  function initBranchLocator() {
    const buttons = document.querySelectorAll('.branch-tab-btn');
    const blocks = document.querySelectorAll('.branch-details-block');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-branch');
        
        // Reset all buttons style
        buttons.forEach(b => {
          b.className = "branch-tab-btn p-4 rounded-2xl border text-left bg-[var(--card-bg)] border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-color)]";
          b.querySelector('span:nth-of-type(2)')?.classList.remove('text-amber-500');
          b.querySelector('span:nth-of-type(2)')?.classList.add('text-zinc-500');
        });
        
        // Set active button style
        btn.className = "branch-tab-btn p-4 rounded-2xl border text-left bg-zinc-900/50 border-amber-500/30 text-[var(--text-color)] shadow-lg shadow-amber-500/5";
        btn.querySelector('span:nth-of-type(2)')?.classList.remove('text-zinc-500');
        btn.querySelector('span:nth-of-type(2)')?.classList.add('text-amber-500');

        // Toggle detailed panels
        blocks.forEach(block => {
          if (block.id === `branch-details-${target}`) {
            block.classList.remove('hidden');
            block.classList.add('block');
          } else {
            block.classList.remove('block');
            block.classList.add('hidden');
          }
        });
      });
    });
  }

  // Support page transition routing loading cycles
  initBranchLocator();
  document.addEventListener('astro:page-load', initBranchLocator);
</script>
