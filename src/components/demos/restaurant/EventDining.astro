---
/**
 * EventDining.astro — Restaurant Premium tier
 * Private dining & event booking section
 */
---

<section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20 uppercase tracking-widest mb-4">Private Events</span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Exclusive Dining Experiences</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4 max-w-lg mx-auto">From intimate celebrations to corporate gatherings, create unforgettable moments in our private spaces.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {[
        { 
          title: 'Private Dining Room', 
          capacity: 'Up to 12 guests', 
          desc: 'An intimate, enclosed dining room with custom menu options, dedicated service staff, and ambient lighting.',
          features: ['Custom Menu', 'Dedicated Server', 'AV Setup'],
          icon: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25'
        },
        { 
          title: 'Banquet Hall', 
          capacity: 'Up to 50 guests', 
          desc: 'Our spacious banquet hall for wedding receptions, corporate events, and milestone celebrations.',
          features: ['Stage Area', 'Sound System', 'Custom Décor'],
          icon: 'M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z'
        },
        { 
          title: 'Chef\'s Table', 
          capacity: 'Up to 8 guests', 
          desc: 'An exclusive front-row seat to the kitchen. Watch the chef craft your multi-course tasting menu live.',
          features: ['Live Cooking', 'Tasting Menu', 'Wine Pairing'],
          icon: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.047 8.287 8.287 0 009 9.601a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z'
        },
      ].map(space => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] space-y-4 hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-[var(--primary-accent)]/10 border border-[var(--primary-accent)]/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-[var(--primary-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={space.icon} /></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-[var(--text-color)]">{space.title}</h3>
            <span class="text-[10px] font-bold text-[var(--primary-accent)] uppercase">{space.capacity}</span>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">{space.desc}</p>
          <div class="flex flex-wrap gap-2">
            {space.features.map(f => (
              <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20">{f}</span>
            ))}
          </div>
          <a href="#" onclick="event.preventDefault(); alert('Enquiry sent! (Demo only)')" class="block w-full py-2.5 text-center text-xs font-bold rounded-xl bg-[var(--card-bg-hover)] text-[var(--text-color)] border border-[var(--border-color)] hover:border-[var(--primary-accent)]/30 transition-colors">
            Enquire Now
          </a>
        </div>
      ))}
    </div>

    <div class="p-6 rounded-2xl border border-[var(--primary-accent)]/20 bg-[var(--primary-accent)]/5 text-center">
      <p class="text-sm text-[var(--text-muted)]">Looking to host a special event? <a href="tel:+919999999999" class="text-[var(--primary-accent)] font-bold hover:underline">Contact our events team</a> for custom packages and availability.</p>
    </div>
  </div>
</section>
