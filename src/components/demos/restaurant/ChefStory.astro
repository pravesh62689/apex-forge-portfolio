---
/**
 * ChefStory.astro — Restaurant Standard tier
 * Chef/brand story section with narrative and visual layout
 */
---

<section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="rounded-3xl overflow-hidden border border-[var(--border-color)] aspect-[4/3]">
        <img src="/images/restaurant-chef.png" alt="Our Chef" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="space-y-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20 uppercase tracking-wider">Our Story</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display leading-tight">A Passion for Flavor</h2>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">Every dish tells a story. Our kitchen is built on the belief that food should be more than sustenance — it should be an experience that brings people together and creates lasting memories.</p>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">From locally-sourced ingredients to time-honored recipes reimagined with modern technique, every plate is crafted with intention and care.</p>
        <div class="grid grid-cols-2 gap-4 pt-4">
          {[
            { value: 'Farm-to-Table', label: 'Local Sourcing' },
            { value: 'Seasonal', label: 'Menu Updates' },
            { value: 'Handcrafted', label: 'Every Dish' },
            { value: 'Zero', label: 'Artificial Additives' },
          ].map(item => (
            <div class="text-center p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-color)]">
              <span class="text-sm font-extrabold text-[var(--primary-accent)] block">{item.value}</span>
              <span class="text-[9px] text-[var(--text-muted)] uppercase tracking-wider font-bold">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
