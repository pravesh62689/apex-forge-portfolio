---
const { tier = "premium" } = Astro.props;

const dishes = [
  {
    title: "Wild Mushroom & Truffle Pizza",
    price: "₹650",
    desc: "Slow-fermented sourdough crust topped with seasonal wild forest mushrooms, fresh mozzarella, truffle oil infusion, and shaved aged parmesan.",
    img: "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80",
    tags: ["Woodfired", "Vegetarian"]
  },
  {
    title: "Specialty Cappuccino",
    price: "₹220",
    desc: "Double shot of organic single-origin arabica espresso, topped with perfectly steamed microfoam and served with a house-baked almond biscotti.",
    img: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80",
    tags: ["Single-Origin", "Arabica"]
  },
  {
    title: "Truffled Avocado Sourdough",
    price: "₹380",
    desc: "Thick slice of toasted rustic sourdough topped with mashed hass avocados, organic cherry tomatoes, crumbled greek feta, and microgreens.",
    img: "https://images.unsplash.com/photo-1541532713592-79a0317b6b77?auto=format&fit=crop&w=600&q=80",
    tags: ["Fresh", "Organic Sourdough"]
  },
  {
    title: "Handmade Truffle Tagliatelle",
    price: "₹580",
    desc: "Fresh egg tagliatelle tossed in a rich butter cream sauce, wild forest mushrooms, and shaved Italian black truffles.",
    img: "https://images.unsplash.com/photo-1645112411341-6c4fd023714a?auto=format&fit=crop&w=600&q=80",
    tags: ["Handmade", "Truffle"]
  },
  {
    title: "Artisan Pistachio Croissant",
    price: "₹190",
    desc: "Flaky, multi-layered French butter croissant filled with house-made sweet Sicilian pistachio cream and dusted with crushed pistachios.",
    img: "https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80",
    tags: ["Freshly Baked", "Sweet"]
  },
  {
    title: "Organic Berries Acai Bowl",
    price: "₹340",
    desc: "Blended organic Brazilian acai berries topped with gluten-free rolled oat granola, organic honey, sliced bananas, and fresh strawberries.",
    img: "https://images.unsplash.com/photo-1590301157890-4810ed352733?auto=format&fit=crop&w=600&q=80",
    tags: ["Superfood", "Vegan Option"]
  }
];

const displayDishes = tier === "premium" ? dishes : dishes.slice(0, 4);
---

<section id="menu" class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        Signature Dishes
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        From the Woodfire & Brew Bar
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm">
        Dishes designed with passion, curated with precision, and served warm in Noida Sector 62.
      </p>
    </div>

    <!-- Dish Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {displayDishes.map((dish) => (
        <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl overflow-hidden shadow-xl hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 group">
          <div class="h-56 overflow-hidden relative">
            <img 
              src={dish.img} 
              alt={dish.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute top-4 right-4 bg-brand-primary text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase">
              {dish.price}
            </div>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="text-lg font-bold text-themeText font-display">{dish.title}</h3>
            <p class="text-xs text-themeTextMuted leading-relaxed">
              {dish.desc}
            </p>
            <div class="flex items-center gap-2 pt-2 text-[10px] text-brand-accent font-bold uppercase">
              {dish.tags.map((tag, idx) => (
                <>
                  <span>{tag}</span>
                  {idx < dish.tags.length - 1 && <span>·</span>}
                </>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
