---
---

<section class="relative overflow-hidden bg-ink-950 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Copy -->
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary border border-brand-primary/20 uppercase tracking-wider">
          <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21V9.75M3.284 14.253a9 9 0 0 0 17.432 0" /></svg>
          Noida Sector 62
        </span>
        <h1 class="hero-headline text-[clamp(2.25rem,4vw+1.5rem,3.75rem)] font-extrabold text-brand-primary leading-[1.15] font-display">
          Crafting moments of culinary pleasure
        </h1>
        <p class="text-sm md:text-base text-themeTextMuted leading-relaxed max-w-xl">
          Experience gourmet wood-fired pizzas, artisan roasted coffees, and handmade pastries prepared with locally-sourced premium ingredients. Set in Noida’s most welcoming contemporary dining hall.
        </p>
        <div class="pt-4 flex flex-wrap gap-4">
          <a href="#booking" class="btn-magnetic px-8 py-3.5 rounded-xl text-xs font-bold bg-brand-primary hover:bg-brand-primary/95 text-white shadow-lg shadow-brand-primary/25 transition-all">
            Reserve a Table
          </a>
          <a href="#menu" class="btn-magnetic px-8 py-3.5 rounded-xl text-xs font-bold bg-ink-900 border border-ink-border hover:bg-ink-800 text-themeText transition-all">
            Explore Menu
          </a>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-[420px] aspect-[4/5] rounded-[32px] overflow-hidden shadow-2xl border border-ink-border group">
          <img 
            src="/images/restaurant-hero.jpg" 
            alt="Bistro 62 Fine Dining Table" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 inset-x-6 p-4 rounded-2xl bg-ink-950/60 backdrop-blur-md border border-ink-border text-center">
            <span class="text-xs font-bold text-white block">Signature Ambiance</span>
            <span class="text-[10px] text-brand-accent font-semibold block mt-0.5">Warm lighting · Wood fires</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
