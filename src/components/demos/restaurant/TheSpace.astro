---
const { tier = "standard" } = Astro.props;

const photos = [
  {
    src: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600&q=80",
    alt: "Main Dining Room",
    title: "Main Dining Room"
  },
  {
    src: "https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?auto=format&fit=crop&w=600&q=80",
    alt: "Attentive Service",
    title: "Attentive Service"
  },
  {
    src: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=600&q=80",
    alt: "Artistic Plating",
    title: "Artistic Plating"
  },
  {
    src: "https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=600&q=80",
    alt: "Cozy Booths",
    title: "Cozy Booths"
  },
  {
    src: "https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=600&q=80",
    alt: "Woodfire Kitchen",
    title: "Woodfire Kitchen"
  },
  {
    src: "https://images.unsplash.com/photo-1525610553991-2bede1a236e2?auto=format&fit=crop&w=600&q=80",
    alt: "Cafe Exterior",
    title: "Warm Welcomes"
  }
];

const displayPhotos = tier === "premium" ? photos : photos.slice(0, 3);
---

<section id="the-space" class="py-24 border-t border-ink-border bg-ink-950 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        The Ambiance
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        The Dining Room & Vibe
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm">
        A space designed for unhurried dinners, warm coffee mornings, and friendly celebrations.
      </p>
    </div>
  </div>

  {tier === "premium" ? (
    <div class="space-gallery-container relative w-full select-none">
      <!-- Desktop Horizontal Scroll (pinning wrapper) -->
      <div class="hidden md:block horizontal-scroll-wrapper relative">
        <div class="horizontal-scroll-content flex gap-8 px-[10vw]" style="width: max-content; will-change: transform;">
          {photos.map((photo) => (
            <div class="w-[450px] aspect-[4/3] rounded-3xl overflow-hidden border border-ink-border shadow-lg group relative flex-shrink-0">
              <img 
                src={photo.src} 
                alt={photo.alt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                <span class="text-sm font-bold text-white font-display">{photo.title}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <!-- Mobile vertical stack fallback -->
      <div class="grid grid-cols-1 md:hidden gap-6 px-4">
        {photos.map((photo) => (
          <div class="demo-card rounded-3xl overflow-hidden aspect-[4/3] border border-ink-border shadow-md group relative">
            <img 
              src={photo.src} 
              alt={photo.alt} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <span class="text-xs font-bold text-white font-display">{photo.title}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto px-4">
      {displayPhotos.map((photo) => (
        <div class="demo-card rounded-3xl overflow-hidden aspect-[4/3] border border-ink-border shadow-md group relative">
          <img 
            src={photo.src} 
            alt={photo.alt} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
            <span class="text-xs font-bold text-white font-display">{photo.title}</span>
          </div>
        </div>
      ))}
    </div>
  )}
</section>
