---
/**
 * ReservationSystem.astro — Restaurant Standard tier
 * Full reservation form with date/time selection
 */
---

<section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20 uppercase tracking-wider mb-4">Reservations</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Reserve Your Table</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4">Book your dining experience in advance for the perfect evening.</p>
    </div>

    <div class="max-w-2xl mx-auto bg-[var(--bg-color)] border border-[var(--border-color)] rounded-3xl p-8">
      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Reservation submitted! (Demo only)');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="rest-res-name" class="text-xs font-semibold text-[var(--text-color)]">Full Name</label>
            <input id="rest-res-name" type="text" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors" placeholder="Your name" />
          </div>
          <div class="space-y-1.5">
            <label for="rest-res-phone" class="text-xs font-semibold text-[var(--text-color)]">Phone Number</label>
            <input id="rest-res-phone" type="tel" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors" placeholder="+91" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="space-y-1.5">
            <label for="rest-res-date" class="text-xs font-semibold text-[var(--text-color)]">Date</label>
            <input id="rest-res-date" type="date" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors" />
          </div>
          <div class="space-y-1.5">
            <label for="rest-res-time" class="text-xs font-semibold text-[var(--text-color)]">Time</label>
            <select id="rest-res-time" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors">
              <option>12:00 PM</option>
              <option>12:30 PM</option>
              <option>1:00 PM</option>
              <option>1:30 PM</option>
              <option>7:00 PM</option>
              <option>7:30 PM</option>
              <option>8:00 PM</option>
              <option>8:30 PM</option>
              <option>9:00 PM</option>
              <option>9:30 PM</option>
            </select>
          </div>
          <div class="space-y-1.5">
            <label for="rest-res-guests" class="text-xs font-semibold text-[var(--text-color)]">Guests</label>
            <select id="rest-res-guests" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors">
              <option>1 Guest</option>
              <option>2 Guests</option>
              <option>3 Guests</option>
              <option>4 Guests</option>
              <option>5 Guests</option>
              <option>6 Guests</option>
              <option>7+ Guests</option>
            </select>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="rest-res-requests" class="text-xs font-semibold text-[var(--text-color)]">Special Requests</label>
          <textarea id="rest-res-requests" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-[var(--primary-accent)] transition-colors" rows="3" placeholder="Dietary requirements, celebrations, seating preferences..."></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-[var(--primary-accent)] text-white text-sm font-bold hover:opacity-90 transition-opacity">Reserve Table</button>
      </form>

      <div class="mt-6 p-4 rounded-xl bg-[var(--primary-accent)]/5 border border-[var(--primary-accent)]/10">
        <p class="text-[10px] text-[var(--text-muted)] text-center">For large party bookings (8+), please call us directly at <strong class="text-[var(--text-color)]">+91 99999 99999</strong></p>
      </div>
    </div>
  </div>
</section>
