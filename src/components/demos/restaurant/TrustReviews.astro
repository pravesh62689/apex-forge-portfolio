---
/**
 * TrustReviews.astro — Restaurant Standard tier
 * Sample-labeled customer reviews for trust building
 */
---

<section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] border border-[var(--primary-accent)]/20 uppercase tracking-wider mb-4">Reviews</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">What Diners Say</h2>
      <p class="text-sm text-[var(--text-muted)] mt-4">How a restaurant website can showcase authentic customer feedback.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { rating: 5, text: 'The ambiance was incredible and the food was exceptional. The chef\'s tasting menu was a journey through flavors I didn\'t know existed. Will definitely return!', source: 'Google Review Format', initials: 'AK' },
        { rating: 5, text: 'Perfect place for our anniversary dinner. The service was impeccable, and every course was beautifully presented. The wine pairing recommendations were spot-on.', source: 'Zomato Review Format', initials: 'PS' },
        { rating: 4, text: 'Great lunch spot for business meetings. The menu has excellent variety, and the private dining area is quiet and elegant. Quick service despite the attention to detail.', source: 'Google Review Format', initials: 'RV' },
      ].map(review => (
        <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4 relative">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--primary-accent)]/10 border border-[var(--primary-accent)]/20 flex items-center justify-center">
              <span class="text-xs font-bold text-[var(--primary-accent)]">{review.initials}</span>
            </div>
            <div>
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg class={`w-3 h-3 ${i < review.rating ? 'text-amber-400' : 'text-[var(--border-color)]'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                ))}
              </div>
              <span class="text-[9px] text-[var(--text-muted)] font-medium">{review.source}</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed italic">"{review.text}"</p>
          <span class="text-[8px] text-[var(--text-muted)] opacity-60 block">(Sample review for demo purposes)</span>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <p class="text-[10px] text-[var(--text-muted)]">These are sample reviews to demonstrate the review section layout. Actual reviews would come from Google, Zomato, or similar platforms.</p>
    </div>
  </div>
</section>
