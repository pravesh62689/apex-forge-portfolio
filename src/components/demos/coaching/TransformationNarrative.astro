---
/**
 * TransformationNarrative.astro — Premium coaching component
 * Shows student transformation journey stories (sample-labeled, not fake testimonials)
 */
---

<section class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3">Student Journeys</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Transformation Stories</h2>
      <p class="text-[var(--text-muted)] text-sm mt-4">Real academic journeys showing how structured coaching transforms potential into performance.</p>
    </div>

    <div class="space-y-8">
      {[
        {
          name: 'Rahul S.',
          journey: 'Class 11 → JEE Advanced',
          before: { score: '45%', label: 'Diagnostic Test Score', challenges: ['Weak in Physics concepts', 'No structured study plan', 'Inconsistent practice'] },
          after: { score: '92%', label: 'Final Mock Score', achievements: ['Physics became strongest subject', 'Completed 50+ mock tests', 'Developed exam-time strategy'] },
          duration: '18 months',
          program: 'JEE Advanced Intensive',
        },
        {
          name: 'Priya M.',
          journey: 'Class 12 → NEET',
          before: { score: '380/720', label: 'Initial Mock Score', challenges: ['Biology conceptual gaps', 'Slow problem solving', 'Board + NEET conflict'] },
          after: { score: '645/720', label: 'Final NEET Score', achievements: ['Complete NCERT mastery', 'Speed improved by 40%', 'Balanced board + entrance prep'] },
          duration: '12 months',
          program: 'NEET Excellence',
        },
      ].map((story, i) => (
        <div class="showcase-card rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] overflow-hidden hover:-translate-y-1 transition-all duration-300">
          <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <span class="text-[9px] font-bold px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 border border-blue-500/20 uppercase tracking-wider">Sample Journey</span>
              <span class="text-xs font-bold text-[var(--text-color)]">{story.name}</span>
              <span class="text-xs text-[var(--text-muted)]">· {story.journey}</span>
              <span class="text-xs text-[var(--text-muted)]">· {story.duration} program</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Before -->
              <div class="p-5 rounded-2xl border border-red-200/50 bg-red-50/50 dark:border-red-500/20 dark:bg-red-500/5 space-y-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl font-extrabold text-red-500">{story.before.score}</span>
                  <div>
                    <span class="text-[10px] font-bold text-red-600 uppercase tracking-wider block">Before</span>
                    <span class="text-xs text-[var(--text-muted)]">{story.before.label}</span>
                  </div>
                </div>
                <ul class="space-y-1.5">
                  {story.before.challenges.map(c => (
                    <li class="flex items-center gap-2 text-xs text-red-600/80">
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                      {c}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- After -->
              <div class="p-5 rounded-2xl border border-green-200/50 bg-green-50/50 dark:border-green-500/20 dark:bg-green-500/5 space-y-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl font-extrabold text-green-500">{story.after.score}</span>
                  <div>
                    <span class="text-[10px] font-bold text-green-600 uppercase tracking-wider block">After</span>
                    <span class="text-xs text-[var(--text-muted)]">{story.after.label}</span>
                  </div>
                </div>
                <ul class="space-y-1.5">
                  {story.after.achievements.map(a => (
                    <li class="flex items-center gap-2 text-xs text-green-600/80">
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="mt-6 pt-4 border-t border-[var(--border-color)]">
              <div class="flex items-center justify-between text-xs mb-2">
                <span class="text-[var(--text-muted)]">Program: <strong class="text-[var(--text-color)]">{story.program}</strong></span>
                <span class="text-[var(--primary-accent)] font-bold">Completed</span>
              </div>
              <div class="h-1.5 bg-[var(--border-color)] rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-500 to-green-500 rounded-full transform-gpu transition-all duration-1000" style="width: 100%"></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
