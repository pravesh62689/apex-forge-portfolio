      <div class="demo-card bg-ink-900 border border-ink-border p-8 rounded-3xl space-y-2 shadow-md hover:border-brand-primary/20 transition-all duration-300">
        <span class="text-4xl lg:text-5xl font-extrabold text-brand-primary block font-display">96.4%</span>
