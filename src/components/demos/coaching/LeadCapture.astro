---
/**
 * LeadCapture.astro — Standard coaching component
 * Newsletter / consultation lead capture section
 */
---

<section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-gradient-to-br from-blue-600/10 via-[var(--bg-color)] to-blue-600/5 rounded-3xl border border-blue-500/20 p-8 md:p-12 relative overflow-hidden">
      <!-- Decorative gradient orb -->
      <div class="absolute -top-20 -right-20 w-60 h-60 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[var(--primary-accent)]">Free Resources</span>
          <h3 class="text-2xl font-extrabold text-[var(--text-color)] font-display">Get Free Study Material</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">Subscribe to receive free chapter-wise notes, formula sheets, and previous year papers directly in your inbox. No spam — only useful academic resources.</p>
          <ul class="space-y-2">
            {[
              'Chapter-wise revision notes',
              'Important formula sheets',
              'Previous year solved papers',
              'Weekly exam tips',
            ].map(item => (
              <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                <svg class="w-3.5 h-3.5 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <form class="space-y-4" onsubmit="event.preventDefault(); this.querySelector('button').textContent = 'Subscribed! ✓'; this.querySelector('button').disabled = true;">
            <div class="space-y-1.5">
              <label for="lead-stud-name" class="text-xs font-semibold text-[var(--text-color)]">Student Name</label>
              <input id="lead-stud-name" type="text" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500 placeholder:text-[var(--text-muted)]" placeholder="Full Name" />
            </div>
            <div class="space-y-1.5">
              <label for="lead-stud-email" class="text-xs font-semibold text-[var(--text-color)]">Email Address</label>
              <input id="lead-stud-email" type="email" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500 placeholder:text-[var(--text-muted)]" placeholder="student@email.com" />
            </div>
            <div class="space-y-1.5">
              <label for="lead-stud-exam" class="text-xs font-semibold text-[var(--text-color)]">Target Exam</label>
              <select id="lead-stud-exam" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500">
                <option>JEE Main</option>
                <option>JEE Advanced</option>
                <option>NEET</option>
                <option>CBSE Board</option>
              </select>
            </div>
            <button type="submit" class="w-full py-3.5 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors">Get Free Study Material</button>
            <p class="text-[10px] text-[var(--text-muted)] text-center">Demo only — no data is collected or stored.</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
