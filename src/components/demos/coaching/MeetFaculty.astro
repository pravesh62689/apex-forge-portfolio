---
const { tier = "premium" } = Astro.props;

const faculty = [
  {
    name: "Dr. Rajesh Sharma",
    role: "Director & Physics Faculty",
    desc: "Ph.D. in Applied Physics from IIT Delhi. Over 15 years of JEE coaching experience. Known for simplifying electrodynamics and mechanics.",
    img: "https://images.unsplash.com/photo-1568602471122-7832951cc4c5?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "IIT Delhi (Ph.D. & M.Sc.)",
      "Ex-Head of Physics at leading national institute"
    ]
  },
  {
    name: "Prof. Amit Verma",
    role: "Chemistry Specialist",
    desc: "M.Sc. Organic Chemistry (DU). 10+ years teaching NEET aspirants. Expert in organic reaction mechanisms and periodic properties.",
    img: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "Delhi University (M.Sc. Chemistry)",
      "Authored popular chemistry guidebooks for NEET"
    ]
  },
  {
    name: "Ms. Priya Sen",
    role: "Mathematics Faculty",
    desc: "M.Sc. Mathematics (BITS Pilani). Specializes in calculus, probability, and board exam preparatory routines.",
    img: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "BITS Pilani (M.Sc. Mathematics)",
      "8+ years experience coaching board toppers"
    ]
  },
  {
    name: "Dr. Neha Rastogi",
    role: "NEET Biology Specialist",
    desc: "Ph.D. in Life Sciences from DU. 12+ years mentoring top medical ranks. Renowned for cell biology and genetics breakdowns.",
    img: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=80",
    credentials: [
      "Jawaharlal Nehru University (M.Sc.)",
      "Delhi University (Ph.D. Biology)"
    ]
  }
];

const displayFaculty = tier === "premium" ? faculty : faculty.slice(0, 2);
---

<section class="py-24 border-t border-ink-border bg-ink-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        Expert Educators
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-themeText mb-4 font-display">
        Meet Our Leading Faculty
      </h2>
      <p class="text-themeTextMuted text-xs sm:text-sm">
        Experienced teachers dedicated to simplifying complex concepts and mentoring students.
      </p>
    </div>

    <!-- Faculty Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 max-w-7xl mx-auto font-sans">
      {displayFaculty.map((member) => (
        <div class="demo-card bg-ink-900 border border-ink-border rounded-3xl overflow-hidden shadow-lg group hover:border-brand-primary/20 transition-all duration-300">
          <div class="aspect-[4/3] w-full bg-ink-950 overflow-hidden relative border-b border-ink-border">
            <img 
              src={member.img} 
              alt={member.name} 
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500" 
            />
          </div>
          <div class="p-6 space-y-3">
            <div>
              <h4 class="text-base font-bold text-themeText font-display">{member.name}</h4>
              <span class="text-[10px] font-bold text-brand-primary uppercase tracking-wider">{member.role}</span>
            </div>
            <p class="text-[11px] text-themeTextMuted leading-relaxed">
              {member.desc}
            </p>
            <div class="pt-2 border-t border-ink-border/50 text-[9px] text-themeTextMuted space-y-1">
              {member.credentials.map((cred) => (
                <div class="flex items-center gap-1.5">
                  <svg class="w-3 h-3 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  <span>{cred}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
