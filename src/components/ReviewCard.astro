---
const { author = "Saurabh Sharma", business = "Sharma Dental Clinic", content = "Excellent work! They built a beautiful site in just 3 days. We've already had multiple patients contact us directly via the WhatsApp button.", rating = 5 } = Astro.props;
---

<div class="bg-gray-900/40 border border-gray-800/80 p-8 rounded-2xl shadow-lg relative">
  <!-- Stars -->
  <div class="flex text-amber-400 gap-1 mb-4">
    {Array.from({ length: rating }).map(() => (
      <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  
  <!-- Review text -->
  <p class="text-gray-300 italic text-sm leading-relaxed mb-6">
    "{content}"
  </p>
  
  <!-- Author info -->
  <div class="flex items-center gap-3 pt-4 border-t border-gray-800">
    <div class="w-10 h-10 rounded-full bg-brand-primary flex items-center justify-center text-white font-bold text-sm">
      {author.charAt(0)}
    </div>
    <div>
      <h4 class="text-sm font-bold text-white">{author}</h4>
      <p class="text-xs text-gray-500">{business}</p>
    </div>
  </div>
</div>
