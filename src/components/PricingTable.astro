      </div>
      
      <div class="w-full h-px bg-ink-border"></div>

      <ul class="space-y-4 text-xs text-zinc-400 font-medium">
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Multi-page Simulated Routing</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Custom Booking Mock Widgets</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Premium local SEO & Structured Markup</span>
        </li>
        <li class="flex items-center gap-3">
