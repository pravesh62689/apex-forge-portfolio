---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto px-4 items-stretch">
  <!-- Basic Tier -->
  <div class="pricing-card bg-ink-900/40 border border-ink-border rounded-3xl p-8 flex flex-col justify-between hover:border-zinc-800 transition-all duration-300 relative overflow-hidden">
    <div class="space-y-6">
      <div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700/50 uppercase">
          Clean & Fast
        </span>
        <h3 class="text-xl font-bold text-white mt-4 mb-2">Basic</h3>
        <p class="text-xs text-zinc-500 leading-snug">Perfect for new local clinics or single operators wanting simple web presence.</p>
      </div>

      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-sm text-zinc-500 line-through">₹8,000</span>
          <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">25% OFF</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span class="text-3xl font-extrabold text-white">₹6,001</span>
          <span class="text-xs text-zinc-500">/ one-time</span>
        </div>
      </div>
      
      <div class="w-full h-px bg-ink-border"></div>

      <ul class="space-y-4 text-xs text-zinc-400">
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>1-Page High Speed Site</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Static Layout (Fast Load)</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Google Maps & Review Embed</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Direct WhatsApp Call Button</span>
        </li>
        <li class="flex items-center gap-3 text-zinc-700 line-through">
          <svg class="w-3.5 h-3.5 text-zinc-700 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          <span>Custom Interactive Forms</span>
        </li>
        <li class="flex items-center gap-3 text-zinc-700 line-through">
          <svg class="w-3.5 h-3.5 text-zinc-700 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          <span>Multi-Section Category Tabs</span>
        </li>
      </ul>
    </div>
    
    <div class="pt-8">
      <a href="/contact" class="btn-magnetic block w-full py-3.5 text-center text-xs font-bold rounded-xl bg-ink-900 border border-ink-border hover:bg-zinc-800 text-zinc-300 transition-colors">
        Choose Basic
      </a>
    </div>
  </div>

  <!-- Standard Tier (Recommended / Highlighted) -->
  <div class="pricing-card bg-brand-primary/5 border-2 border-brand-primary rounded-3xl p-8 flex flex-col justify-between hover:border-brand-primary/80 transition-all duration-300 relative shadow-lg shadow-brand-primary/5">
    <div class="absolute top-0 right-8 -translate-y-1/2 bg-brand-primary text-white text-[9px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
      Most Popular
    </div>
    
    <div class="space-y-6">
      <div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-brand-primary/10 text-brand-primary border border-brand-primary/20 uppercase">
          Considered & Complete
        </span>
        <h3 class="text-xl font-bold text-white mt-4 mb-2">Standard</h3>
        <p class="text-xs text-zinc-300 leading-snug">For growing local businesses looking to establish high local search trust.</p>
      </div>

      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-sm text-zinc-400 line-through">₹15,000</span>
          <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">33% OFF</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span class="text-4xl font-extrabold text-white">₹10,000</span>
          <span class="text-xs text-zinc-400">/ one-time</span>
        </div>
      </div>
      
      <div class="w-full h-px bg-brand-primary/20"></div>

      <ul class="space-y-4 text-xs text-zinc-200 font-medium">
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>3-5 Optimized Sections/Pages</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Micro-Reveal Animation Flow</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Tabbed Menu / Categories</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Pure CSS FAQ Accordions</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Local SEO Basics & Schema</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-3.5 h-3.5 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          <span>Custom domain & SSL Setup</span>
        </li>
      </ul>
    </div>
    
    <div class="pt-8">
      <a href="/contact" class="btn-magnetic block w-full py-3.5 text-center text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white shadow-lg shadow-brand-primary/15 transition-all duration-200">
        Choose Standard
      </a>
    </div>
  </div>

  <!-- Premium Tier -->
  <div class="pricing-card bg-ink-900/40 border border-ink-border rounded-3xl p-8 flex flex-col justify-between hover:border-zinc-800 transition-all duration-300 relative overflow-hidden">
    <div class="space-y-6">
