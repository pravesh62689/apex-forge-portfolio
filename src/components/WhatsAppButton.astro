---
const { phone = "919999999999", message = "Hi, I am interested in building a website for my business. I'd love to chat!", floating = false } = Astro.props;
const encodedMessage = encodeURIComponent(message);
const waUrl = `https://wa.me/${phone}?text=${encodedMessage}`;
---

{floating ? (
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-16 h-16 bg-[#25D366] text-white rounded-full shadow-2xl hover:bg-[#20ba56] hover:scale-110 active:scale-95 transition-all duration-300 group"
    aria-label="Chat on WhatsApp"
  >
    <!-- Pulse animations -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-40 animate-ping group-hover:animate-none"></span>
    
    <svg class="w-8 h-8 relative z-10" fill="currentColor" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.625 1.451 5.403.002 9.803-4.394 9.806-9.799.002-2.618-1.016-5.08-2.867-6.933C16.36 1.947 13.9 .924 11.993.924c-5.402 0-9.802 4.394-9.806 9.802-.001 1.73.461 3.42 1.337 4.91L2.482 20.4l4.165-1.092zM17.47 14.39c-.3-.149-1.77-.874-2.046-.975-.276-.101-.476-.149-.676.15-.2.299-.775.975-.95 1.174-.175.199-.35.224-.65.075-1.127-.565-2.222-1.04-3.155-1.85-.721-.628-1.182-1.4-1.323-1.649-.142-.249-.015-.383.11-.507.112-.111.25-.299.375-.449.125-.149.167-.249.25-.419.083-.169.042-.319-.02-.469-.063-.15-.576-1.396-.79-1.907-.208-.5-.436-.408-.597-.417-.152-.008-.328-.01-.505-.01-.177 0-.464.067-.707.329-.243.262-.927.906-.927 2.21 0 1.304.949 2.562 1.08 2.731.133.169 1.867 2.85 4.522 3.997.632.273 1.126.435 1.51.558.634.201 1.21.172 1.666.105.508-.075 1.77-.724 2.02-1.39.25-.666.25-1.238.176-1.39-.074-.15-.274-.249-.574-.399z"/>
    </svg>
  </a>
) : (
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-lg font-bold bg-[#25D366] hover:bg-[#20ba56] text-white shadow-xl shadow-green-500/20 hover:shadow-green-500/35 hover:-translate-y-0.5 active:scale-98 transition-all duration-200"
  >
    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.625 1.451 5.403.002 9.803-4.394 9.806-9.799.002-2.618-1.016-5.08-2.867-6.933C16.36 1.947 13.9 .924 11.993.924c-5.402 0-9.802 4.394-9.806 9.802-.001 1.73.461 3.42 1.337 4.91L2.482 20.4l4.165-1.092zM17.47 14.39c-.3-.149-1.77-.874-2.046-.975-.276-.101-.476-.149-.676.15-.2.299-.775.975-.95 1.174-.175.199-.35.224-.65.075-1.127-.565-2.222-1.04-3.155-1.85-.721-.628-1.182-1.4-1.323-1.649-.142-.249-.015-.383.11-.507.112-.111.25-.299.375-.449.125-.149.167-.249.25-.419.083-.169.042-.319-.02-.469-.063-.15-.576-1.396-.79-1.907-.208-.5-.436-.408-.597-.417-.152-.008-.328-.01-.505-.01-.177 0-.464.067-.707.329-.243.262-.927.906-.927 2.21 0 1.304.949 2.562 1.08 2.731.133.169 1.867 2.85 4.522 3.997.632.273 1.126.435 1.51.558.634.201 1.21.172 1.666.105.508-.075 1.77-.724 2.02-1.39.25-.666.25-1.238.176-1.39-.074-.15-.274-.249-.574-.399z"/>
    </svg>
    Chat on WhatsApp
  </a>
)}
