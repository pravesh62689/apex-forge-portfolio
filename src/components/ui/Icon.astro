const pathHtml = icons[name] || "";
---

{pathHtml && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="1.5" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    set:html={pathHtml}
  />
)}
