---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  items: FAQItem[];
  accentColor?: string;
}
const { items, accentColor = 'var(--primary-accent)' } = Astro.props;
---

<div class="faq-container space-y-3">
  {items.map((item, i) => (
    <details class="faq-item group rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] overflow-hidden transition-all duration-300 hover:border-[var(--primary-accent)]/30">
      
      <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none list-none text-sm font-semibold text-[var(--text-color)] outline-none">
        <span>{item.question}</span>
        <svg class="w-4 h-4 text-[var(--text-muted)] flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </summary>
      
      <div class="faq-answer px-6 pb-5 text-xs text-[var(--text-muted)] leading-relaxed border-t border-[var(--border-color)]">
        <p class="pt-4">{item.answer}</p>
      </div>

    </details>
  ))}
</div>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  details[open] {
    background: var(--card-bg-hover);
  }

  /* * Zero-JS Smooth Animation Hack.
   * When details is open, the child .faq-answer gets animated in.
   * This provides a premium feel without fighting the browser's native DOM updates.
   */
  details[open] .faq-answer {
    animation: sweep 0.35s ease-out forwards;
  }

  @keyframes sweep {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>