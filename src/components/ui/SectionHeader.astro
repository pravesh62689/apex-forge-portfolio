---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
}
const { eyebrow, title, description, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-3xl mb-16 ${alignClass}`}>
  {eyebrow && (
    <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary-accent)] block mb-3 font-sans">
      {eyebrow}
    </span>
  )}
  <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-[var(--text-color)] mb-4 tracking-tight font-display">
    {title}
  </h2>
  {description && (
    <p class="text-[var(--text-muted)] text-sm md:text-base leading-relaxed">
      {description}
    </p>
  )}
</div>
