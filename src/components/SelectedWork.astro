---
---

<section class="py-24 border-t border-ink-border bg-ink-950 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
        What I Build
      </span>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-white mb-4 tracking-tight font-display">
        Bespoke Client Architectures
      </h2>
      <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
        Real-world local systems engineered for sub-100ms loading speeds, automated customer scheduling, and robust data persistence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      <!-- Project 1: Restaurant/Cafe Digital System -->
      <a href="/demos/restaurant-demo" class="group relative block rounded-3xl bg-ink-900 border border-ink-border hover:border-brand-primary/50 transition-all duration-500">
        <div class="aspect-[16/10] overflow-hidden relative">
          <img 
            src="/images/portfolio-restaurant.png" 
            alt="Bistro 62 Digital Reservation & Menu System" 
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            width="560"
            height="350"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
        </div>
        <div class="p-8">
          <span class="px-2 py-1 rounded-md bg-amber-500/10 border border-amber-500/20 text-[9px] font-bold text-amber-400 uppercase tracking-wider font-sans mb-3 inline-block">
            Hospitality & Booking
          </span>
          <h3 class="text-xl font-bold text-white mb-2 font-display">Bistro 62 Noida</h3>
          <p class="text-zinc-400 text-xs mb-4 leading-relaxed font-sans">Features category-based digital menus, real-time slot reservation previews, and automated customer notifications.</p>
          <div class="flex gap-2">
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">Astro</span>
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">TailwindCSS</span>
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">GSAP</span>
          </div>
        </div>
      </a>

      <!-- Project 2: Dental Clinic Portal -->
      <a href="/demos/dentist-demo" class="group relative block rounded-3xl bg-ink-900 border border-ink-border hover:border-brand-primary/50 transition-all duration-500">
        <div class="aspect-[16/10] overflow-hidden relative">
          <img 
            src="/images/portfolio-dentist.png" 
            alt="Noida Dental Care Appointment Portal" 
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            width="560"
            height="350"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
        </div>
        <div class="p-8">
          <span class="px-2 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-[9px] font-bold text-emerald-400 uppercase tracking-wider font-sans mb-3 inline-block">
            Healthcare & Scheduling
          </span>
          <h3 class="text-xl font-bold text-white mb-2 font-display">Noida Dental Care</h3>
          <p class="text-zinc-400 text-xs mb-4 leading-relaxed font-sans">Patient journey mapping, dentist-specialty dashboards, insurance details, and virtual consultation intakes.</p>
          <div class="flex gap-2">
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">Astro</span>
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">TailwindCSS</span>
            <span class="px-2 py-1 rounded-md bg-ink-800 text-[10px] font-bold text-zinc-300 uppercase">VanillaJS</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>
