    },
  ];

  function hexToRgba(hex, alpha) {
    const h = hex.replace("#", "");
    const r = parseInt(h.substring(0, 2), 16);
    const g = parseInt(h.substring(2, 4), 16);
    const b = parseInt(h.substring(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  function initHero() {
    if (ctx) ctx.revert();

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // --- 1. Entrance animations ---
    ctx = gsap.context(() => {
      if (!prefersReducedMotion) {
        gsap.from(".hero-eyebrow", {
          y: 15,
          opacity: 0,
          duration: 1,
          ease: "power2.out",
        });
        gsap.from(".hero-title-safe", {
          y: 30,
          opacity: 0,
          duration: 1.2,
          ease: "power3.out",
          delay: 0.1,
        });
        gsap.from(".hero-subtitle-safe", {
          y: 20,
          opacity: 0,
          duration: 1.2,
          ease: "power3.out",
          delay: 0.3,
        });
        gsap.from(".hero-ctas-safe", {
          y: 20,
          opacity: 0,
          duration: 1.2,
          ease: "power3.out",
          delay: 0.4,
        });
        gsap.from(".hero-mockup-safe", {
          y: 40,
          opacity: 0,
          duration: 1.5,
          ease: "power3.out",
          delay: 0.2,
        });
      }
    });

    // --- 2. Continuous background animation ---
    if (!prefersReducedMotion) {
      const mesh = document.querySelector(".hero-mesh");
      if (mesh) {
        const tween = gsap.to(mesh, {
          backgroundPosition: "100% 100%",
          duration: 20,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
        });
        bgAnimations.push(tween);
      }

      const orbs = document.querySelectorAll(".hero-orb");
      orbs.forEach((orb, i) => {
        const tween = gsap.to(orb, {
          x: gsap.utils.random(-60, 60),
          y: gsap.utils.random(-40, 40),
          scale: gsap.utils.random(0.8, 1.2),
          duration: gsap.utils.random(6, 10),
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay: i * 0.5,
        });
        bgAnimations.push(tween);
      });

      const particles = document.querySelectorAll(".particle");
      particles.forEach((p, i) => {
        const tween = gsap.to(p, {
          x: gsap.utils.random(-80, 80),
          y: gsap.utils.random(-60, 60),
          duration: gsap.utils.random(15, 25),
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay: i * 0.3,
        });
        bgAnimations.push(tween);
      });
    }

    // --- 3. Mockup rotation logic ---
    const screen = document.getElementById("mock-screen");
    const navIcon = document.getElementById("mock-nav-icon");
    const navLabel = document.getElementById("mock-nav-label");
    const cardImage = document.getElementById("mock-card-image");
    const icon = document.getElementById("mock-icon");
    const badge = document.getElementById("mock-badge");
    const title = document.getElementById("mock-title");
    const star = document.getElementById("mock-star");
    const meta = document.getElementById("mock-meta");
    const desc = document.getElementById("mock-desc");
    const cta = document.getElementById("mock-cta");
    const ctaLabel = document.getElementById("mock-cta-label");
    const dots = document.querySelectorAll("#mock-dots .dot");

    // Make sure we have a wrapper to observe for intersection
    const heroBg = document.querySelector(".hero-mockup-safe") || screen;

    if (!screen || !heroBg) return;

    let activeIndex = 0;

    function applyNiche(n, animate) {
      const apply = () => {
        // Background & text
        screen.style.backgroundColor = n.bg;
        screen.style.color = n.text;
        if (n.font) screen.style.fontFamily = `'${n.font}', sans-serif`;

        // Nav
        navIcon.textContent = n.icon;
        navIcon.style.backgroundColor = hexToRgba(n.accent, 0.15);
        navIcon.style.color = n.accent;
        navLabel.textContent = n.label;
        navLabel.style.color = n.text;

        // --- IMAGE: Inject background image ---
        cardImage.style.backgroundImage = `url(${n.image})`;
        cardImage.style.backgroundSize = "cover";
        cardImage.style.backgroundPosition = "center";
        cardImage.style.backgroundColor = "transparent"; // remove fallback color
        if (icon) icon.style.display = "none"; // hide the SVG icon fallback

        // Badge
        badge.textContent = n.badge;
        badge.style.color = n.accent;

        // Title, stars, meta, desc
        title.textContent = n.label;
        title.style.color = n.text;
        star.style.color = n.accent;
        meta.textContent = n.meta;
        desc.textContent = n.desc;

        // CTA button
        cta.style.backgroundColor = n.accent;
        ctaLabel.textContent = n.cta;
        ctaLabel.style.color = "#fff";

        // Borders & cards
        document.querySelectorAll(".mock-screen-border").forEach((el) => {
          el.style.borderColor = n.border;
        });
        document.querySelectorAll(".mock-card-bg").forEach((el) => {
          el.style.backgroundColor = n.card;
        });
      };

      if (animate && !prefersReducedMotion) {
        gsap
          .timeline()
          .to([title, desc, navLabel, cardImage], {
            opacity: 0,
            y: -6,
            duration: 0.18,
            ease: "power1.in",
          })
          .call(apply)
          .fromTo(
            [navLabel, title, desc, cardImage],
            { opacity: 0, y: 6 },
            {
              opacity: 1,
              y: 0,
              duration: 0.3,
              ease: "power2.out",
              stagger: 0.03,
            },
          );
      } else {
        apply();
      }
    }

    function updateDots(index, accent) {
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.className =
            "dot w-5 h-1.5 rounded-full transition-all duration-300";
          dot.style.backgroundColor = accent;
        } else {
          dot.className =
            "dot w-1.5 h-1.5 rounded-full transition-all duration-300";
          dot.style.backgroundColor = "rgba(156, 163, 175, 0.4)"; // neutral gray for inactive
        }
      });
    }

    // Initialize first state
    applyNiche(NICHES[0], false);
    updateDots(0, NICHES[0].accent);

    function rotateNiche() {
      activeIndex = (activeIndex + 1) % NICHES.length;
      const n = NICHES[activeIndex];
      applyNiche(n, true);
      updateDots(activeIndex, n.accent);
    }

    if (observer as any) observer.disconnect();
    if (rotationInterval) clearInterval(rotationInterval);

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !prefersReducedMotion) {
            if (!rotationInterval) {
              rotationInterval = setInterval(rotateNiche, 4200);
            }
          } else {
            if (rotationInterval) {
              clearInterval(rotationInterval);
              rotationInterval = null;
            }
          }
        });
      },
      { threshold: 0.1 },
    );

    observer.observe(heroBg);
  }

  function cleanupHero() {
    bgAnimations.forEach((t) => t.kill());
    bgAnimations = [];

    if (rotationInterval) {
      clearInterval(rotationInterval);
      rotationInterval = null;
    }
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    if (ctx) {
      ctx.revert();
    }
  }

  // Astro page lifecycle hooks
  document.addEventListener("astro:page-load", initHero);
  document.addEventListener("astro:before-swap", cleanupHero);
</script>

