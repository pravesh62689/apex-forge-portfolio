<section
  class="relative overflow-hidden pt-28 pb-24 lg:pt-36 lg:pb-28 bg-ink-950 hero-mesh hero-bg"
>
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-brand-primary/10 blur-[120px] pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/3 left-1/4 w-[300px] h-[300px] rounded-full bg-brand-accent/5 blur-[100px] pointer-events-none"
  >
  </div>
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>
  <div class="hero-orb hero-orb-3"></div>
  <div
    class="hero-particles absolute inset-0 overflow-hidden pointer-events-none z-0"
  >
    <div class="particle p-1"></div>
    <div class="particle p-2"></div>
    <div class="particle p-3"></div>
    <div class="particle p-4"></div>
    <div class="particle p-5"></div>
    <div class="particle p-6"></div>
    <div class="particle p-7"></div>
    <div class="particle p-8"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col justify-center">
        <div class="w-full lg:pr-4 xl:pr-12">
          <span
            class="hero-eyebrow inline-flex items-center gap-2 self-start px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-primary/10 text-brand-primary border-2 border-brand-primary mb-6 tracking-wide shadow-[0_0_12px_rgba(6,182,212,0.2)]"
          >
            <svg
              class="w-3.5 h-3.5 text-brand-primary flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
              ></path>
            </svg>
            APEX FORGE TECHNOLOGIES
          </span>

          <h1
            class="hero-title-safe text-[clamp(2.5rem,4.5vw+1rem,4.5rem)] font-extrabold tracking-tight text-white mb-6 leading-[1.1] font-display"
          >
            Your business deserves a website that <br class="hidden xl:block" />
            <span class="text-brand-primary">never lets a customer down</span>
          </h1>

          <p
            class="hero-subtitle-safe text-base md:text-lg text-zinc-400 font-medium mb-10 max-w-2xl leading-relaxed"
          >
            Fast, mobile-first websites for local Noida & NCR businesses — built
            by an engineer who has spent two years building transaction and
            security systems that financial institutions trust. Live in days,
            not weeks.
          </p>

          <div
            class="hero-ctas-safe flex flex-col sm:flex-row items-center gap-4 sm:gap-5"
          >
            <a
              href="/demos"
              class="btn-magnetic w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold bg-brand-primary hover:bg-brand-primary/90 text-white shadow-xl shadow-brand-primary/20 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              Explore Our Work
            </a>
            <a
              href="/contact"
              class="btn-magnetic w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold bg-ink-900 border border-ink-border hover:bg-ink-800 text-zinc-300 transition-all duration-200"
            >
              Start a Project
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: 3D character team presenting the product to a happy customer -->
      <div
        class="lg:col-span-5 xl:col-span-4 flex items-center justify-center relative mt-12 lg:mt-0 hero-mockup-safe"
      >
        <div class="hero-3d-stage relative w-full max-w-[520px] mx-auto">
          <!-- Glow platform behind the characters -->
          <div class="hero-3d-glow" aria-hidden="true"></div>

          <!-- The 3D character illustration (floats gently) -->
          <div class="hero-3d-frame relative z-10">
            <img
              src="/images/hero-3d-team.png"
              alt="A 3D design team presenting a laptop and phone showing a growing business website to a happy client"
              class="hero-3d-img w-full h-auto select-none pointer-events-none"
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>

          <!-- Animated speech bubble from the presenter -->
          <div class="hero-speech z-20">
            <span class="hero-speech-dot"></span>
            <p class="hero-speech-text">
              <span class="hero-speech-strong">Your business will grow</span>
              <span class="hero-speech-sub">Live in days, not weeks.</span>
            </p>
          </div>

          <!-- Floating stat card: growth -->
          <div class="hero-float-card hero-float-card-1 z-20">
            <div class="hero-float-icon hero-float-icon-up">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 7h4v4" />
              </svg>
            </div>
            <div class="leading-tight">
              <span class="block text-[10px] uppercase tracking-wider text-zinc-400 font-bold">Growth</span>
              <span class="block text-sm font-extrabold text-white">+3× leads</span>
            </div>
          </div>

          <!-- Floating stat card: rating -->
          <div class="hero-float-card hero-float-card-2 z-20">
            <div class="hero-float-icon hero-float-icon-star">
              <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
            <div class="leading-tight">
              <span class="block text-[10px] uppercase tracking-wider text-zinc-400 font-bold">Rating</span>
              <span class="block text-sm font-extrabold text-white">4.9 / 5</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hidden legacy mockup (kept out of layout; script safely no-ops) -->
