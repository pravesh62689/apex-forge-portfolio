                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    ><path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                    ></path></svg
                  >
                  <span id="mock-meta"></span>
                </div>

                <p id="mock-desc" class="text-sm opacity-70 leading-relaxed">
                </p>

                <div class="mt-auto pt-6">
                  <button
                    id="mock-cta"
                    class="w-full py-3.5 rounded-xl flex items-center justify-center transition-transform active:scale-95 shadow-lg"
                  >
                    <span
                      id="mock-cta-label"
                      class="font-bold text-sm tracking-wide"></span>
                  </button>
                </div>
              </div>

              <div
                id="mock-dots"
                class="absolute bottom-4 left-0 right-0 flex justify-center items-center gap-2 z-20"
              >
                <div
                  class="dot w-5 h-1.5 rounded-full transition-all duration-300"
                >
                </div>
                <div
                  class="dot w-1.5 h-1.5 rounded-full transition-all duration-300"
                >
                </div>
                <div
                  class="dot w-1.5 h-1.5 rounded-full transition-all duration-300"
                >
                </div>
                <div
                  class="dot w-1.5 h-1.5 rounded-full transition-all duration-300"
                >
                </div>
                <div
                  class="dot w-1.5 h-1.5 rounded-full transition-all duration-300"
                >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Static, anchored caption — explains what the mockup is doing -->
        <div
          class="absolute -bottom-3 -right-4 bg-ink-900 border border-ink-border px-4 py-2.5 rounded-xl shadow-xl z-20"
        >
          <span
            class="text-[9px] text-themeTextMuted uppercase font-bold tracking-wider block"
            >One Engine</span
          >
          <span
            id="caption-niche-count"
            class="text-sm font-bold text-brand-primary leading-tight block"
            >5 Live Identities</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

