---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FAQ from '../../components/ui/FAQ.astro';
import Gallery from '../../components/ui/Gallery.astro';
import TableSelector from '../../components/demos/restaurant/TableSelector.astro';
import BranchLocator from '../../components/demos/restaurant/BranchLocator.astro';
import SpecialOffers from '../../components/demos/restaurant/SpecialOffers.astro';
import ChefStory from '../../components/demos/restaurant/ChefStory.astro';
import TrustReviews from '../../components/demos/restaurant/TrustReviews.astro';
import ReservationSystem from '../../components/demos/restaurant/ReservationSystem.astro';
import EventDining from '../../components/demos/restaurant/EventDining.astro';
import AtmosphereShowcase from '../../components/demos/restaurant/AtmosphereShowcase.astro';
---


<Base 
  title="Bistro 62 Noida — Cafe & Restaurant Niche Demo" 
  description="Artisan coffee and gourmet food at Bistro 62 in Noida Sector 62. Family dining and home delivery. View our basic, standard, and premium digital layouts."
  theme="restaurant"
>
  <!-- Demo Banner -->
  <div class="bg-[var(--primary-accent)]/10 border-b border-[var(--primary-accent)]/20 py-2.5 px-4 text-center text-xs font-semibold text-[var(--primary-accent)] z-40 relative select-none flex items-center justify-center gap-1.5">
    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
    <span>Sample Concept Demo — Select a tier tab to experience the visual and functional scaling.</span>
  </div>

  <!-- Pricing Tier Selector -->
  <div class="py-6 border-b border-[var(--border-color)] sticky top-20 z-30 backdrop-blur-md bg-[var(--bg-color)]/90 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold text-[var(--text-color)] font-display">Niche Preview: Restaurant & Cafe</h1>
        <p class="text-xs text-[var(--text-muted)]">Bistro 62 Noida concept build</p>
      </div>
      <div class="flex bg-[var(--card-bg)] border border-[var(--border-color)] p-1 rounded-xl">
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-[var(--primary-accent)] text-white" data-tier="basic">Basic</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="standard">Standard</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="premium">Premium</button>
      </div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- BASIC TIER — 5 Sections -->
  <!-- ============================================== -->
  <div id="tier-basic-content" class="tier-content-block block">
    
    <!-- 1. Hero -->
    <section class="py-20 bg-[var(--bg-color)] relative overflow-hidden">
      <div class="absolute inset-0 opacity-20">
        <img src="/images/restaurant-hero.jpg" alt="" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-color)] via-[var(--bg-color)]/80 to-[var(--bg-color)]"></div>
      <div class="max-w-3xl mx-auto px-4 text-center relative z-10 space-y-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Bistro 62 Noida</h2>
        <p class="text-[var(--text-muted)] text-base">Artisan coffees, hand-stretched pizzas, and bakery items. Sector 62, Noida.</p>
        <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
          View Menu & Order
        </a>
      </div>
    </section>

    <!-- 2. Menu Highlights (4-6 dishes) -->
    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-8 font-display">Our Menu</h3>
        <div class="space-y-4">
          {[
            { name: 'Artisan Cappuccino', desc: 'Freshly roasted organic beans with microfoam.', price: '₹220' },
            { name: 'Truffle Pizza', desc: 'Hand-stretched crust, wild mushrooms, white truffle oil.', price: '₹650' },
            { name: 'Smashed Avocado Toast', desc: 'Avocado, feta, and cherry tomatoes on sourdough.', price: '₹380' },
            { name: 'Classic Margherita', desc: 'San Marzano tomatoes, fresh mozzarella, basil.', price: '₹420' },
            { name: 'Belgian Waffle Stack', desc: 'With fresh berries, maple syrup, and whipped cream.', price: '₹350' },
            { name: 'Grilled Chicken Bowl', desc: 'Quinoa, roasted vegetables, lemon herb dressing.', price: '₹480' },
          ].map(item => (
            <div class="flex justify-between items-start gap-4 py-3 border-b border-[var(--border-color)]">
              <div>
                <span class="text-[var(--text-color)] font-semibold text-sm block">{item.name}</span>
                <span class="text-[var(--text-muted)] text-xs">{item.desc}</span>
              </div>
              <span class="text-[var(--primary-accent)] font-bold text-sm whitespace-nowrap">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Daily Specials -->
    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Daily Specials</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)]">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase tracking-wider">Weekday Lunch</span>
            <h4 class="text-sm font-bold text-[var(--text-color)] mt-2">Combo Meal — ₹399</h4>
            <p class="text-xs text-[var(--text-muted)] mt-1">Any pizza + coffee + dessert of the day.</p>
          </div>
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)]">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase tracking-wider">Weekend Brunch</span>
            <h4 class="text-sm font-bold text-[var(--text-color)] mt-2">Brunch Platter — ₹599</h4>
            <p class="text-xs text-[var(--text-muted)] mt-1">Eggs benedict, waffles, fresh juice & coffee.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Booking CTA -->
    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-6">
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Reserve a Table</h3>
        <p class="text-sm text-[var(--text-muted)]">Walk-ins welcome. For guaranteed seating, call us or book via WhatsApp.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            Call: +91 99999 99999
          </a>
          <a href="https://wa.me/919999999999?text=Hi%20Bistro%2062%2C%20I%27d%20like%20to%20reserve%20a%20table." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg)] transition-colors">
            Book on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- 5. Location & Contact -->
    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Find Us</h3>
        <div class="p-6 rounded-2xl bg-[var(--bg-color)] border border-[var(--border-color)] space-y-3 text-sm text-[var(--text-muted)]">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            <span>Stellar IT Park, Sector 62, Noida, UP 201301</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <span>Mon - Sun: 8:00 AM - 11:00 PM</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            <span>Phone: +91 99999 99999</span>
          </p>
        </div>
        <p class="text-center text-[10px] text-[var(--text-muted)] mt-6">Basic Tier — Clean single-page site optimized for speed and clarity.</p>
      </div>
    </section>
  </div>

  <!-- ============================================== -->
  <!-- STANDARD TIER — 8 Sections -->
  <!-- ============================================== -->
  <div id="tier-standard-content" class="tier-content-block hidden">
    
    <!-- 1. Cinematic Hero -->
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0">
        <img src="/images/restaurant-hero.jpg" alt="Bistro 62 dining atmosphere" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-24">
        <div class="max-w-xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 mb-6 uppercase tracking-wider">Standard Demo</span>
          <h2 class="hero-headline text-4xl md:text-6xl font-extrabold text-white tracking-tight font-display leading-tight">
            Where Every Meal Becomes a Memory
          </h2>
          <p class="text-white/70 text-base mt-6 leading-relaxed">Artisan crafted dishes, organic ingredients, and a warm atmosphere that makes Sector 62 your favorite dining destination.</p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href="#std-menu" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold bg-amber-600 text-white hover:bg-amber-700 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              View Full Menu
            </a>
            <a href="#std-reservation" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold border border-white/20 text-white hover:bg-white/10 transition-colors">
              Reserve a Table
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Filterable Menu Categories -->
    <section id="std-menu" class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Our Menu" title="Crafted With Passion" description="Every dish is prepared with the freshest organic ingredients and artisan techniques." />
        
        <!-- Category Tabs -->
        <div class="flex flex-wrap gap-2 justify-center mb-12">
          {['Appetizers', 'Mains', 'Desserts', 'Drinks'].map((cat, i) => (
            <button class={`menu-cat-btn px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-200 ${i === 0 ? 'bg-amber-500/10 text-amber-600' : 'text-[var(--text-muted)] hover:text-[var(--text-color)]'} border border-[var(--border-color)]`} data-cat={cat.toLowerCase()}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Menu Blocks -->
        <div id="cat-appetizers" class="menu-cat-block block">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { name: 'Bruschetta Trio', desc: 'Tomato basil, mushroom truffle, and roasted pepper on ciabatta.', price: '₹380', img: '/images/restaurant-dishes.png' },
              { name: 'Soup of the Day', desc: "Chef's seasonal selection served with sourdough bread.", price: '₹280', img: '/images/restaurant-dishes.png' },
              { name: 'Caesar Salad', desc: 'Romaine, parmesan shavings, croutons, classic dressing.', price: '₹350', img: '/images/restaurant-dishes.png' },
              { name: 'Garlic Bread Platter', desc: 'With mozzarella and sun-dried tomato dip.', price: '₹220', img: '/images/restaurant-dishes.png' },
            ].map(item => (
              <div class="showcase-card flex gap-4 p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-amber-500/20 transition-all duration-300">
                <img src={item.img} alt={item.name} class="w-20 h-20 rounded-xl object-cover flex-shrink-0" loading="lazy" />
                <div class="flex-grow">
                  <div class="flex justify-between items-start">
                    <span class="text-sm font-bold text-[var(--text-color)]">{item.name}</span>
                    <span class="text-sm font-bold text-[var(--primary-accent)]">{item.price}</span>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] mt-1">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="cat-mains" class="menu-cat-block hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { name: 'Truffle Pizza', desc: 'Hand-stretched crust, wild mushrooms, white truffle oil.', price: '₹650' },
              { name: 'Grilled Salmon', desc: 'Atlantic salmon with asparagus and lemon butter.', price: '₹890' },
              { name: 'Paneer Tikka Bowl', desc: 'Tandoori paneer with quinoa, roasted veggies, mint chutney.', price: '₹480' },
              { name: 'Pasta Carbonara', desc: 'Spaghetti, egg yolk, pecorino, crispy pancetta.', price: '₹520' },
            ].map(item => (
              <div class="showcase-card flex gap-4 p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-amber-500/20 transition-all duration-300">
                <div class="w-20 h-20 rounded-xl bg-amber-500/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-8 h-8 text-amber-500/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0L3 16.5m15-3.379a48.474 48.474 0 0 0-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 0 1 3 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 0 1 6 13.12" /></svg>
                </div>
                <div class="flex-grow">
                  <div class="flex justify-between items-start">
                    <span class="text-sm font-bold text-[var(--text-color)]">{item.name}</span>
                    <span class="text-sm font-bold text-[var(--primary-accent)]">{item.price}</span>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] mt-1">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="cat-desserts" class="menu-cat-block hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { name: 'Tiramisu', desc: 'Classic Italian dessert with espresso-soaked ladyfingers.', price: '₹320' },
              { name: 'Belgian Waffle Stack', desc: 'With fresh berries, maple syrup, whipped cream.', price: '₹350' },
              { name: 'Molten Lava Cake', desc: 'Dark chocolate with vanilla bean ice cream.', price: '₹380' },
            ].map(item => (
              <div class="showcase-card flex gap-4 p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-amber-500/20 transition-all duration-300">
                <div class="w-20 h-20 rounded-xl bg-amber-500/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-8 h-8 text-amber-500/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>
                </div>
                <div class="flex-grow">
                  <div class="flex justify-between items-start">
                    <span class="text-sm font-bold text-[var(--text-color)]">{item.name}</span>
                    <span class="text-sm font-bold text-[var(--primary-accent)]">{item.price}</span>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] mt-1">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="cat-drinks" class="menu-cat-block hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { name: 'Artisan Cappuccino', desc: 'Single origin beans, microfoam art.', price: '₹220' },
              { name: 'Fresh Mint Lemonade', desc: 'Hand-pressed lemons with crushed mint.', price: '₹180' },
              { name: 'Mango Smoothie', desc: 'Alphonso mango with yogurt and honey.', price: '₹250' },
            ].map(item => (
              <div class="showcase-card flex gap-4 p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-amber-500/20 transition-all duration-300">
                <div class="w-20 h-20 rounded-xl bg-amber-500/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-8 h-8 text-amber-500/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                </div>
                <div class="flex-grow">
                  <div class="flex justify-between items-start">
                    <span class="text-sm font-bold text-[var(--text-color)]">{item.name}</span>
                    <span class="text-sm font-bold text-[var(--primary-accent)]">{item.price}</span>
                  </div>
                  <p class="text-xs text-[var(--text-muted)] mt-1">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Chef / Brand Story -->
    <ChefStory />

    <!-- 4. Gallery -->
    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
