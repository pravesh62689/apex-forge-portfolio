---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FAQ from '../../components/ui/FAQ.astro';
import Gallery from '../../components/ui/Gallery.astro';
import DoctorTabSelector from '../../components/demos/dental/DoctorTabSelector.astro';
import PaymentCalculator from '../../components/demos/dental/PaymentCalculator.astro';
import VirtualTour from '../../components/demos/dental/VirtualTour.astro';
import ProcedureExplainer from '../../components/demos/dental/ProcedureExplainer.astro';
import InsuranceInfo from '../../components/demos/dental/InsuranceInfo.astro';
import ConsultationFlow from '../../components/demos/dental/ConsultationFlow.astro';
import PatientJourney from '../../components/demos/dental/PatientJourney.astro';
---


<Base title="Noida Dental Care — Dentist & Clinic Niche Demo" description="Modern dental care for the whole family. Treatments, smile designing, and emergency care in Noida." theme="dental">
  <!-- Demo Banner -->
  <div class="bg-[var(--primary-accent)]/10 border-b border-[var(--primary-accent)]/20 py-2.5 px-4 text-center text-xs font-semibold text-[var(--primary-accent)] z-40 relative select-none flex items-center justify-center gap-1.5">
    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
    <span>Sample Concept Demo — Select a tier tab to experience the visual and functional scaling.</span>
  </div>

  <!-- Tier Selector -->
  <div class="py-6 border-b border-[var(--border-color)] sticky top-20 z-30 backdrop-blur-md bg-[var(--bg-color)]/90">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold text-[var(--text-color)] font-display">Niche Preview: Dentist & Clinic</h1>
        <p class="text-xs text-[var(--text-muted)]">Noida Dental Care concept build</p>
      </div>
      <div class="flex bg-[var(--card-bg)] border border-[var(--border-color)] p-1 rounded-xl">
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-[var(--primary-accent)] text-white" data-tier="basic">Basic</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="standard">Standard</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="premium">Premium</button>
      </div>
    </div>
  </div>

  <!-- ===== BASIC TIER — 5 Sections ===== -->
  <div id="tier-basic-content" class="tier-content-block block">
    <!-- 1. Hero -->
    <section class="py-20 bg-[var(--bg-color)] relative overflow-hidden">
      <div class="absolute inset-0 opacity-15"><img src="/images/dentist-hero.jpg" alt="" class="w-full h-full object-cover" /></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-color)] via-[var(--bg-color)]/80 to-[var(--bg-color)]"></div>
      <div class="max-w-3xl mx-auto px-4 text-center relative z-10 space-y-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Noida Dental Care</h2>
        <p class="text-[var(--text-muted)] text-base">Modern dental treatments for the whole family. Smile designing, root canals, and preventive care.</p>
        <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.78-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
          Book Appointment
        </a>
      </div>
    </section>

    <!-- 2. Services (6 core) -->
    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-8 font-display">Our Treatments</h3>
        <div class="grid grid-cols-2 gap-4">
          {[
            { name: 'General Checkup', icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
            { name: 'Teeth Cleaning', icon: 'M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z' },
            { name: 'Root Canal', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z' },
            { name: 'Smile Designing', icon: 'M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z' },
            { name: 'Braces & Aligners', icon: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75' },
            { name: 'Dental Implants', icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] flex items-center gap-3">
              <svg class="w-5 h-5 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              <span class="text-sm font-medium text-[var(--text-color)]">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Trust Cues -->
    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <div class="grid grid-cols-3 gap-4 text-center">
          {[
            { label: 'Years Experience', value: '15+' },
            { label: 'Dental Council Certified', value: 'DCI' },
            { label: 'Advanced Equipment', value: 'Digital' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-color)]">
              <span class="text-2xl font-extrabold text-[var(--primary-accent)] block">{item.value}</span>
              <span class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-bold">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Doctor Block -->
    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <div class="flex flex-col sm:flex-row gap-6 items-center p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)]">
          <img src="/images/dentist-doctor.png" alt="Dr. at Noida Dental Care" class="w-24 h-24 rounded-2xl object-cover flex-shrink-0" loading="lazy" />
          <div>
            <h4 class="text-base font-bold text-[var(--text-color)]">Meet Our Lead Dentist</h4>
            <p class="text-xs text-[var(--text-muted)] mt-1">BDS, MDS (Orthodontics) • 15+ years of clinical experience in cosmetic and restorative dentistry. Member of Indian Dental Association.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Appointment CTA -->
    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-6">
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Book Your Appointment</h3>
        <p class="text-sm text-[var(--text-muted)]">Call us or send a WhatsApp message to schedule your visit.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Call: +91 99999 99999</a>
          <a href="https://wa.me/919999999999" target="_blank" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg-hover)] transition-colors">WhatsApp Us</a>
        </div>
        <p class="text-[10px] text-[var(--text-muted)]">Basic Tier — Professional single-page clinic presence.</p>
      </div>
    </section>
  </div>

  <!-- ===== STANDARD TIER — 8 Sections ===== -->
  <div id="tier-standard-content" class="tier-content-block hidden">
    <!-- 1. Professional Hero -->
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/dentist-hero.jpg" alt="Noida Dental Care clinic" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-[#1E3A5F]/90 via-[#1E3A5F]/60 to-transparent"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-24">
        <div class="max-w-xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-teal-500/20 text-teal-300 border border-teal-500/30 mb-6 uppercase tracking-wider">Standard Demo</span>
          <h2 class="hero-headline text-4xl md:text-6xl font-extrabold text-white tracking-tight font-display leading-tight">Your Smile, Our Expertise</h2>
          <p class="text-white/70 text-base mt-6 leading-relaxed">Comprehensive dental care with modern technology and a gentle approach. From routine cleanings to complete smile makeovers.</p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href="#std-d-booking" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold bg-teal-600 text-white hover:bg-teal-700 transition-colors">Book Appointment</a>
            <a href="#std-d-treatments" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold border border-white/20 text-white hover:bg-white/10 transition-colors">View Treatments</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Treatment Categories -->
    <section id="std-d-treatments" class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Treatments" title="Comprehensive Dental Services" description="From preventive care to advanced cosmetic procedures, we cover every aspect of dental health." />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { name: 'Preventive Care', desc: 'Regular checkups, professional cleaning, fluoride treatment, and early cavity detection.', icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z' },
            { name: 'Cosmetic Dentistry', desc: 'Teeth whitening, veneers, bonding, and complete smile makeover procedures.', icon: 'M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z' },
            { name: 'Orthodontics', desc: 'Traditional braces, clear aligners, and retainer treatments for perfect alignment.', icon: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75' },
            { name: 'Root Canal Therapy', desc: 'Painless root canal treatments using advanced rotary technology and microscopic precision.', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z' },
            { name: 'Dental Implants', desc: 'Permanent tooth replacement with titanium implants and natural-looking crowns.', icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085' },
            { name: 'Pediatric Dentistry', desc: 'Gentle and fun dental care for children, including sealants, fillings, and fluoride.', icon: 'M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z' },
          ].map(item => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4 hover:border-teal-500/20 hover:-translate-y-1 transition-all duration-300">
              <div class="w-12 h-12 rounded-xl bg-teal-500/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              </div>
              <h4 class="text-sm font-bold text-[var(--text-color)]">{item.name}</h4>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Why Choose Us -->
    <section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Why Us" title="What Sets Us Apart" description="We combine advanced technology with a patient-first philosophy." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)]">
            <img src="/images/dentist-clinic.png" alt="Modern dental clinic interior" class="w-full h-80 object-cover" loading="lazy" />
          </div>
          <div class="space-y-5">
            {[
              { title: 'Latest Digital Technology', desc: 'Digital X-rays, 3D scanning, and CAD/CAM for precise treatments.' },
              { title: 'Pain-Free Procedures', desc: 'Advanced anesthesia techniques ensure comfortable treatments.' },
              { title: 'Sterilization Standards', desc: 'Hospital-grade sterilization protocols for every instrument.' },
              { title: 'Flexible Scheduling', desc: 'Evening and weekend appointments available for your convenience.' },
            ].map(item => (
              <div class="flex gap-4">
                <svg class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <div>
                  <h4 class="text-sm font-bold text-[var(--text-color)]">{item.title}</h4>
                  <p class="text-xs text-[var(--text-muted)] mt-0.5">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Procedure Explanations -->
    <ProcedureExplainer />


    <!-- 5. Meet the Doctor -->
    <section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)]">
            <img src="/images/dentist-doctor.png" alt="Lead dentist" class="w-full h-80 object-cover" loading="lazy" />
          </div>
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-600">Our Doctor</span>
            <h3 class="text-2xl font-bold text-[var(--text-color)] font-display">Expertise You Can Trust</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">BDS, MDS (Orthodontics & Dentofacial Orthopaedics) with 15+ years of clinical experience. Specializing in cosmetic dentistry, implantology, and orthodontics.</p>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Member of the Indian Dental Association. Regular continuing education to stay current with the latest dental advancements.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FAQ -->
    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <SectionHeader eyebrow="Questions" title="Frequently Asked" />
        <FAQ items={[
          { question: 'Is teeth cleaning painful?', answer: 'Professional cleaning is generally painless. You may feel slight pressure or sensitivity, but our hygienists use gentle techniques to ensure your comfort.' },
          { question: 'How often should I visit the dentist?', answer: 'We recommend a checkup and cleaning every 6 months. If you have specific dental concerns, more frequent visits may be needed.' },
          { question: 'Do you accept dental insurance?', answer: 'Yes, we accept most major dental insurance plans. Please contact us with your insurance details for verification before your visit.' },
          { question: 'What should I do in a dental emergency?', answer: 'Call us immediately at +91 99999 99999. We offer same-day emergency appointments for acute pain, broken teeth, and other urgent dental issues.' },
          { question: 'How long do dental implants last?', answer: 'With proper care, dental implants can last 20+ years. They are the most durable and natural-looking tooth replacement option available.' },
        ]} />
      </div>
    </section>

    <!-- 7. Insurance & Payment -->
    <InsuranceInfo />


    <!-- 8. Appointment Booking -->
    <section id="std-d-booking" class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-xl mx-auto px-4">
        <SectionHeader eyebrow="Book Now" title="Schedule Your Visit" description="Fill in the form below and we'll confirm your appointment via call or WhatsApp." />
        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Appointment booked! (Demo only)');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="dentist-std-name" class="text-xs font-semibold text-[var(--text-color)]">Your Name</label><input id="dentist-std-name" type="text" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500" placeholder="Full Name" /></div>
            <div class="space-y-1.5"><label for="dentist-std-phone" class="text-xs font-semibold text-[var(--text-color)]">Phone</label><input id="dentist-std-phone" type="tel" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500" placeholder="+91" /></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="dentist-std-date" class="text-xs font-semibold text-[var(--text-color)]">Preferred Date</label><input id="dentist-std-date" type="date" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500" /></div>
            <div class="space-y-1.5"><label for="dentist-std-treatment" class="text-xs font-semibold text-[var(--text-color)]">Treatment</label>
              <select id="dentist-std-treatment" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500">
                <option>General Checkup</option><option>Teeth Cleaning</option><option>Root Canal</option><option>Cosmetic Dentistry</option><option>Braces / Aligners</option><option>Dental Implant</option><option>Emergency</option>
              </select>
            </div>
          </div>
          <div class="space-y-1.5"><label for="dentist-std-notes" class="text-xs font-semibold text-[var(--text-color)]">Additional Notes</label><textarea id="dentist-std-notes" rows="3" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-teal-500 resize-none" placeholder="Any specific concerns or medical history..."></textarea></div>
