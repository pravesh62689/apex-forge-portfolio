---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FAQ from '../../components/ui/FAQ.astro';
import Gallery from '../../components/ui/Gallery.astro';
import ProgramPages from '../../components/demos/gym/ProgramPages.astro';
import MembershipJourney from '../../components/demos/gym/MembershipJourney.astro';
import VirtualTour from '../../components/demos/gym/VirtualTour.astro';
import ClassBooking from '../../components/demos/gym/ClassBooking.astro';
import ProgressTracker from '../../components/demos/gym/ProgressTracker.astro';
import GymFAQ from '../../components/demos/gym/GymFAQ.astro';
---

<Base title="Iron Strong Gym — Gym & Fitness Niche Demo" description="Premium strength training, cardio, and group fitness in Noida. Iron Strong Gym." theme="gym">
  <div class="bg-[var(--primary-accent)]/10 border-b border-[var(--primary-accent)]/20 py-2.5 px-4 text-center text-xs font-semibold text-[var(--primary-accent)] z-40 relative select-none flex items-center justify-center gap-1.5">
    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
    <span>Sample Concept Demo — Select a tier tab to experience the visual and functional scaling.</span>
  </div>

  <div class="py-6 border-b border-[var(--border-color)] sticky top-20 z-30 backdrop-blur-md bg-[var(--bg-color)]/90">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold text-[var(--text-color)] font-display">Niche Preview: Gym & Fitness</h1>
        <p class="text-xs text-[var(--text-muted)]">Iron Strong Gym concept build</p>
      </div>
      <div class="flex bg-[var(--card-bg)] border border-[var(--border-color)] p-1 rounded-xl">
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-[var(--primary-accent)] text-white" data-tier="basic">Basic</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="standard">Standard</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="premium">Premium</button>
      </div>
    </div>
  </div>

  <!-- BASIC — 5 Sections -->
  <div id="tier-basic-content" class="tier-content-block block">
    <section class="py-20 bg-[var(--bg-color)] relative overflow-hidden">
      <div class="absolute inset-0 opacity-20"><img src="/images/gym-hero.jpg" alt="" class="w-full h-full object-cover" /></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-color)] via-[var(--bg-color)]/80 to-[var(--bg-color)]"></div>
      <div class="max-w-3xl mx-auto px-4 text-center relative z-10 space-y-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">IRON STRONG GYM</h2>
        <p class="text-[var(--text-muted)] text-base">Premium strength training, cardio, and functional fitness in Noida.</p>
        <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Join Today — Free Trial</a>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-8 font-display">Classes & Programs</h3>
        <div class="grid grid-cols-2 gap-4">
          {[
            { name: 'Strength Training', icon: 'm3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z' },
            { name: 'Cardio & HIIT', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z' },
            { name: 'CrossFit', icon: 'M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z' },
            { name: 'Yoga & Flexibility', icon: 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z' },
            { name: 'Boxing & MMA', icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085' },
            { name: 'Personal Training', icon: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] flex items-center gap-3">
              <svg class="w-5 h-5 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              <span class="text-sm font-medium text-[var(--text-color)]">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Membership</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)]">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase">Monthly</span>
            <h4 class="text-2xl font-extrabold text-[var(--text-color)] mt-2">₹2,000<span class="text-sm font-normal text-[var(--text-muted)]">/mo</span></h4>
          </div>
          <div class="p-5 rounded-2xl border border-[var(--primary-accent)]/30 bg-[var(--primary-accent)]/5">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase">Annual (Best Value)</span>
            <h4 class="text-2xl font-extrabold text-[var(--text-color)] mt-2">₹18,000<span class="text-sm font-normal text-[var(--text-muted)]">/yr</span></h4>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Our Facility</h3>
        <div class="grid grid-cols-2 gap-3">
          <img src="/images/gym-floor.png" alt="Training floor" class="rounded-xl h-32 w-full object-cover" loading="lazy" />
          <img src="/images/gym-hero.jpg" alt="Gym interior" class="rounded-xl h-32 w-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-6">
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Start Your Free Trial</h3>
        <p class="text-sm text-[var(--text-muted)]">Walk in for a free 1-day trial. No commitment required.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Call: +91 99999 99999</a>
          <a href="https://wa.me/919999999999" target="_blank" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg-hover)] transition-colors">Get Free Pass</a>
        </div>
        <p class="text-[10px] text-[var(--text-muted)]">Basic Tier — Dynamic single-page gym presence.</p>
      </div>
    </section>
  </div>

  <!-- STANDARD — 8 Sections -->
  <div id="tier-standard-content" class="tier-content-block hidden">
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/gym-hero.jpg" alt="Iron Strong Gym" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-transparent"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-24">
        <div class="max-w-xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-red-500/20 text-red-300 border border-red-500/30 mb-6 uppercase tracking-wider">Standard Demo</span>
          <h2 class="hero-headline text-4xl md:text-6xl font-extrabold text-white tracking-tight font-display leading-tight">FORGE YOUR STRONGEST SELF</h2>
          <p class="text-white/70 text-base mt-6">World-class equipment, expert trainers, and a community that pushes you to break limits.</p>
          <div class="flex gap-3 mt-8">
            <a href="#std-g-join" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold bg-red-600 text-white hover:bg-red-700 transition-colors">Join Now</a>
            <a href="#std-g-schedule" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold border border-white/20 text-white hover:bg-white/10 transition-colors">Class Schedule</a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Our Team" title="Expert Trainers" description="Certified professionals committed to your transformation." />
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {[
            { name: 'Head Trainer', specialty: 'Strength & Conditioning', cert: 'ACE, NSCA Certified' },
            { name: 'CrossFit Coach', specialty: 'Functional Fitness', cert: 'CrossFit Level 2' },
            { name: 'Yoga Instructor', specialty: 'Yoga & Mobility', cert: 'RYT 500' },
          ].map(trainer => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-3">
              <div class="w-20 h-20 mx-auto rounded-full overflow-hidden"><img src="/images/gym-trainer.png" alt={trainer.name} class="w-full h-full object-cover" loading="lazy" /></div>
              <div class="text-center">
                <h4 class="text-sm font-bold text-[var(--text-color)]">{trainer.name}</h4>
                <p class="text-xs text-[var(--primary-accent)] font-medium">{trainer.specialty}</p>
                <p class="text-[10px] text-[var(--text-muted)]">{trainer.cert}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="std-g-schedule" class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Schedule" title="Weekly Class Calendar" />
        <div class="overflow-x-auto">
          <table class="w-full text-xs border-collapse">
            <thead><tr class="border-b border-[var(--border-color)]">
              <th class="p-3 text-left text-[var(--text-muted)] font-bold">Time</th>
              {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(day => (<th class="p-3 text-center text-[var(--text-muted)] font-bold">{day}</th>))}
            </tr></thead>
            <tbody>
              {[
                { time: '6:00 AM', classes: ['HIIT', 'Strength', 'HIIT', 'Strength', 'HIIT', 'Yoga'] },
                { time: '7:00 AM', classes: ['Yoga', 'CrossFit', 'Yoga', 'CrossFit', 'Yoga', 'HIIT'] },
                { time: '9:00 AM', classes: ['Strength', 'Boxing', 'Strength', 'Boxing', 'Strength', 'CrossFit'] },
                { time: '5:00 PM', classes: ['CrossFit', 'HIIT', 'CrossFit', 'HIIT', 'CrossFit', 'Open Gym'] },
                { time: '7:00 PM', classes: ['Boxing', 'Strength', 'Boxing', 'Strength', 'Open Gym', '—'] },
              ].map(row => (
                <tr class="border-b border-[var(--border-color)]">
                  <td class="p-3 font-bold text-[var(--text-color)]">{row.time}</td>
                  {row.classes.map(cls => (
                    <td class="p-3 text-center"><span class={`px-2 py-1 rounded-lg text-[10px] font-bold ${cls === '—' ? 'text-[var(--text-muted)]' : 'bg-[var(--primary-accent)]/10 text-[var(--primary-accent)]'}`}>{cls}</span></td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Membership" title="Choose Your Plan" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { name: 'Monthly', price: '₹2,000', original: '₹2,500', features: ['Full gym access', 'Group classes', 'Locker room'], popular: false },
            { name: 'Quarterly', price: '₹5,500', original: '₹7,500', features: ['Full gym access', 'All group classes', 'Body composition analysis', '1 PT session/month'], popular: true },
            { name: 'Annual', price: '₹18,000', original: '₹24,000', features: ['Full gym access', 'All group classes', 'Monthly PT sessions', 'Diet consultation', 'Freeze up to 30 days'], popular: false },
          ].map(plan => (
            <div class={`showcase-card p-6 rounded-2xl border ${plan.popular ? 'border-[var(--primary-accent)]/40 bg-[var(--primary-accent)]/5' : 'border-[var(--border-color)] bg-[var(--card-bg)]'} space-y-4 relative`}>
              {plan.popular && <span class="absolute top-0 right-6 -translate-y-1/2 bg-[var(--primary-accent)] text-white text-[9px] font-bold px-3 py-1 rounded-full uppercase">Best Value</span>}
              <h4 class="text-base font-bold text-[var(--text-color)]">{plan.name}</h4>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-[var(--text-color)]">{plan.price}</span>
                <span class="text-sm text-[var(--text-muted)] line-through">{plan.original}</span>
              </div>
              <ul class="space-y-2">
                {plan.features.map(f => (
                  <li class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
                    <svg class="w-3 h-3 text-[var(--primary-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="#std-g-join" class={`block w-full py-3 text-center text-xs font-bold rounded-xl transition-colors ${plan.popular ? 'bg-[var(--primary-accent)] text-white hover:opacity-90' : 'bg-[var(--card-bg-hover)] text-[var(--text-color)] border border-[var(--border-color)]'}`}>
                Choose {plan.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Facility" title="Our Training Spaces" />
        <Gallery images={[
          { src: '/images/gym-floor.png', alt: 'Strength area', caption: 'Strength Zone' },
          { src: '/images/gym-groupclass.png', alt: 'Group fitness class', caption: 'Group Classes' },
          { src: '/images/gym-trainer.png', alt: 'Personal training', caption: 'Personal Training' },
          { src: '/images/gym-hero.jpg', alt: 'Main floor', caption: 'Main Training Floor' },
        ]} columns={2} />
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <SectionHeader eyebrow="FAQ" title="Membership Questions" />
        <FAQ items={[
          { question: 'Can I try before I join?', answer: 'Yes! We offer a free 1-day trial for all new visitors. Just walk in with your ID proof.' },
          { question: 'What are the gym hours?', answer: 'Monday to Saturday: 5:30 AM - 10:00 PM. Sunday: 7:00 AM - 12:00 PM. Closed on national holidays.' },
          { question: 'Do you provide a trainer?', answer: 'Group classes are included with all memberships. Personal training sessions are available as add-ons or included in premium plans.' },
          { question: 'Can I freeze my membership?', answer: 'Annual members can freeze up to 30 days. Monthly members cannot freeze but can extend by equivalent days with medical certificates.' },
          { question: 'Is parking available?', answer: 'Yes, free two-wheeler parking and discounted car parking available for gym members.' },
        ]} />
      </div>
    </section>

    <section id="std-g-join" class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-4xl mx-auto px-4 text-center space-y-8">
        <SectionHeader eyebrow="Join" title="Ready to Transform?" description="Walk in for a free trial or contact us to start your membership." />
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Call: +91 99999 99999</a>
          <a href="https://wa.me/919999999999?text=Hi%20Iron%20Strong%2C%20I%27d%20like%20to%20join." target="_blank" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-sm font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg-hover)] transition-colors">Get Free Pass on WhatsApp</a>
        </div>
        <p class="text-[10px] text-[var(--text-muted)]">Standard Tier — Complete gym website with trainers, schedule, memberships, facility, and FAQ.</p>
      </div>
    </section>
  </div>

  <!-- PREMIUM — Multipage Experience -->
  <div id="tier-premium-content" class="tier-content-block hidden">
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/gym-hero.jpg" alt="Premium gym" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/40"></div></div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none"><div class="particle-field-gym"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-32">
        <div class="max-w-2xl">
          <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-red-500/20 text-red-300 border border-red-500/30 mb-8 uppercase tracking-widest backdrop-blur-sm">Premium Experience</span>
          <h2 class="hero-headline text-5xl md:text-7xl font-extrabold text-white tracking-tight font-display leading-[1.05]">UNLEASH YOUR POTENTIAL</h2>
          <p class="text-white/60 text-lg mt-8 leading-relaxed max-w-lg">The ultimate training experience. Elite equipment, expert coaching, and a community that refuses to settle for average.</p>
          <div class="flex gap-4 mt-10">
            <a href="#prem-g-join" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-red-600 text-white hover:bg-red-700 transition-all shadow-xl shadow-red-600/20">Start Free Trial</a>
            <a href="#prem-g-programs" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-white/10 backdrop-blur-sm border border-white/20 text-white hover:bg-white/20 transition-all">Programs</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Program Pages -->
    <ProgramPages />

    <!-- 3. Virtual Facility Tour -->
    <VirtualTour />

    <!-- 4. Class Booking System -->
    <ClassBooking />

    <!-- 5. Membership Journey -->
    <MembershipJourney />

    <!-- 6. Progress Tracker -->
    <ProgressTracker />

    <!-- 7. Transformations -->
    <section class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Transformations" title="Real Results" description="Sample transformation stories to demonstrate how gym websites build trust." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { title: '90-Day Transformation', desc: 'Lost 15kg and gained visible muscle definition through our Shred & Tone program combined with nutrition coaching.' },
            { title: 'Strength Journey', desc: 'Went from zero gym experience to deadlifting 120kg in 6 months with our Strength Foundation program.' },
          ].map(story => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4">
              <div class="grid grid-cols-2 gap-3">
                <div class="h-40 rounded-xl bg-[var(--bg-color)] flex items-center justify-center border border-[var(--border-color)]"><span class="text-xs text-[var(--text-muted)]">Before</span></div>
                <div class="h-40 rounded-xl overflow-hidden"><img src="/images/gym-trainer.png" alt="After" class="w-full h-full object-cover" loading="lazy" /></div>
              </div>
              <h4 class="text-sm font-bold text-[var(--text-color)]">{story.title}</h4>
              <p class="text-xs text-[var(--text-muted)]">{story.desc} <span class="text-[9px] opacity-60">(Sample for demo)</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Facility Gallery -->
    <section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Facility" title="World-Class Training Environment" />
        <Gallery images={[
          { src: '/images/gym-floor.png', alt: 'Weight room', caption: 'Weight Room' },
          { src: '/images/gym-groupclass.png', alt: 'Group class', caption: 'Group Training' },
          { src: '/images/gym-trainer.png', alt: 'Trainer session', caption: 'Personal Training' },
          { src: '/images/gym-hero.jpg', alt: 'Full facility', caption: 'Full Facility' },
        ]} columns={2} />
