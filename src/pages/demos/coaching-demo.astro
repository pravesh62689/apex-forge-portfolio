---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FAQ from '../../components/ui/FAQ.astro';
import Gallery from '../../components/ui/Gallery.astro';
import LeadCapture from '../../components/demos/coaching/LeadCapture.astro';
import TransformationNarrative from '../../components/demos/coaching/TransformationNarrative.astro';
import AuthorityPresentation from '../../components/demos/coaching/AuthorityPresentation.astro';
import AssessmentTool from '../../components/demos/coaching/AssessmentTool.astro';
---

<Base title="Apex Coaching Noida — Coaching Center Niche Demo" description="Academic excellence for CBSE, JEE, and NEET preparation. Apex Coaching in Noida." theme="coaching">
  <div class="bg-[var(--primary-accent)]/10 border-b border-[var(--primary-accent)]/20 py-2.5 px-4 text-center text-xs font-semibold text-[var(--primary-accent)] z-40 relative select-none flex items-center justify-center gap-1.5">
    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
    <span>Sample Concept Demo — Select a tier tab to experience the visual and functional scaling.</span>
  </div>

  <div class="py-6 border-b border-[var(--border-color)] sticky top-20 z-30 backdrop-blur-md bg-[var(--bg-color)]/90">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold text-[var(--text-color)] font-display">Niche Preview: Coaching Center</h1>
        <p class="text-xs text-[var(--text-muted)]">Apex Coaching Noida concept build</p>
      </div>
      <div class="flex bg-[var(--card-bg)] border border-[var(--border-color)] p-1 rounded-xl">
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-[var(--primary-accent)] text-white" data-tier="basic">Basic</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="standard">Standard</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="premium">Premium</button>
      </div>
    </div>
  </div>

  <!-- BASIC — 5 Sections -->
  <div id="tier-basic-content" class="tier-content-block block">
    <section class="py-20 bg-[var(--bg-color)] relative overflow-hidden">
      <div class="absolute inset-0 opacity-10"><img src="/images/coaching-hero.jpg" alt="" class="w-full h-full object-cover" /></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-color)] via-[var(--bg-color)]/80 to-[var(--bg-color)]"></div>
      <div class="max-w-3xl mx-auto px-4 text-center relative z-10 space-y-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Apex Coaching Noida</h2>
        <p class="text-[var(--text-muted)] text-base">Academic excellence for CBSE, JEE, and NEET preparation. Expert faculty, proven results.</p>
        <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Enquire Now</a>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-8 font-display">Our Programs</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { name: 'JEE Foundation (9-10)', price: '₹45,000/yr' },
            { name: 'JEE Main + Advanced (11-12)', price: '₹75,000/yr' },
            { name: 'NEET Preparation (11-12)', price: '₹70,000/yr' },
            { name: 'CBSE Board Coaching (9-12)', price: '₹35,000/yr' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] flex justify-between items-center">
              <span class="text-sm font-medium text-[var(--text-color)]">{item.name}</span>
              <span class="text-xs font-bold text-[var(--primary-accent)]">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">What Students Achieve</h3>
        <div class="grid grid-cols-3 gap-4 text-center">
          {[
            { label: 'Board Toppers', value: '50+' },
            { label: 'JEE Qualifiers', value: '200+' },
            { label: 'Years Running', value: '10+' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-color)]">
              <span class="text-2xl font-extrabold text-[var(--primary-accent)] block">{item.value}</span>
              <span class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-bold">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Fee Overview</h3>
        <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)]">
          <p class="text-sm text-[var(--text-muted)]">Programs range from <strong class="text-[var(--text-color)]">₹35,000 to ₹75,000</strong> per year depending on the course. Installment options available. Free counseling session for new enquiries.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-6">
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Book a Free Counseling Session</h3>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Call Us</a>
          <a href="https://wa.me/919999999999" target="_blank" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg-hover)] transition-colors">WhatsApp</a>
        </div>
        <p class="text-[10px] text-[var(--text-muted)]">Basic Tier — Clear single-page coaching presence.</p>
      </div>
    </section>
  </div>

  <!-- STANDARD — 7 Sections -->
  <div id="tier-standard-content" class="tier-content-block hidden">
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/coaching-hero.jpg" alt="Apex Coaching" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-blue-900/90 via-blue-900/60 to-transparent"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-24">
        <div class="max-w-xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 mb-6 uppercase tracking-wider">Standard Demo</span>
          <h2 class="hero-headline text-4xl md:text-6xl font-extrabold text-white tracking-tight font-display leading-tight">Building Future Toppers</h2>
          <p class="text-white/70 text-base mt-6">Structured programs with expert faculty, regular testing, and personalized attention to transform academic potential into results.</p>
          <div class="flex gap-3 mt-8">
            <a href="#std-c-enroll" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold bg-blue-600 text-white hover:bg-blue-700 transition-colors">Enroll Now</a>
            <a href="#std-c-programs" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold border border-white/20 text-white hover:bg-white/10 transition-colors">View Programs</a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="The Problem" title="Why Students Struggle" description="Understanding the gap between effort and results." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl border border-red-200 bg-red-50 space-y-4">
            <h4 class="text-sm font-bold text-red-700">Common Challenges</h4>
            <ul class="space-y-2">
              {['No structured study plan', 'Self-study without guidance', 'Lack of regular testing', 'Unclear exam strategies', 'No doubt-clearing support'].map(item => (
                <li class="flex items-center gap-2 text-xs text-red-600">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="p-6 rounded-2xl border border-green-200 bg-green-50 space-y-4">
            <h4 class="text-sm font-bold text-green-700">Our Solution</h4>
            <ul class="space-y-2">
              {['Structured daily schedule', 'Expert faculty mentorship', 'Weekly tests with analysis', 'Proven exam strategies', 'Unlimited doubt sessions'].map(item => (
                <li class="flex items-center gap-2 text-xs text-green-600">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="std-c-programs" class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Programs" title="Comprehensive Course Catalog" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { name: 'JEE Foundation', grade: 'Class 9-10', duration: '2 Years', subjects: 'Physics, Chemistry, Mathematics', fee: '₹45,000/yr', features: ['Concept building from basics', 'Weekly tests', 'Online + Offline'] },
            { name: 'JEE Main + Advanced', grade: 'Class 11-12', duration: '2 Years', subjects: 'Physics, Chemistry, Mathematics', fee: '₹75,000/yr', features: ['Advanced problem solving', 'Mock tests series', 'Personal mentorship'] },
            { name: 'NEET Preparation', grade: 'Class 11-12', duration: '2 Years', subjects: 'Physics, Chemistry, Biology', fee: '₹70,000/yr', features: ['NCERT focused approach', 'Lab sessions', 'Medical entrance strategy'] },
            { name: 'CBSE Board Excellence', grade: 'Class 9-12', duration: '1 Year', subjects: 'All Core Subjects', fee: '₹35,000/yr', features: ['Board exam focus', 'Sample paper practice', 'Flexible timing'] },
          ].map(program => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] space-y-4 hover:border-blue-500/20 transition-all duration-300">
              <div class="flex justify-between items-start">
                <h4 class="text-base font-bold text-[var(--text-color)]">{program.name}</h4>
                <span class="text-xs font-bold text-[var(--primary-accent)] bg-blue-500/10 px-2 py-0.5 rounded-full">{program.grade}</span>
              </div>
              <div class="flex gap-4 text-xs text-[var(--text-muted)]">
                <span>Duration: {program.duration}</span>
                <span>Fee: <strong class="text-[var(--text-color)]">{program.fee}</strong></span>
              </div>
              <p class="text-xs text-[var(--text-muted)]">Subjects: {program.subjects}</p>
              <div class="flex flex-wrap gap-2">
                {program.features.map(f => (<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-600">{f}</span>))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-5xl mx-auto px-4">
        <SectionHeader eyebrow="Process" title="How We Work" />
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          {[
            { step: '01', title: 'Free Counseling', desc: 'Understand student goals and recommend the right program.' },
            { step: '02', title: 'Diagnostic Test', desc: 'Assess current level and identify areas for improvement.' },
            { step: '03', title: 'Structured Learning', desc: 'Daily classes, study material, and doubt sessions.' },
            { step: '04', title: 'Regular Assessment', desc: 'Weekly tests, performance reports, and parent meetings.' },
          ].map(item => (
            <div class="showcase-card p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] text-center space-y-3">
              <span class="text-2xl font-bold text-[var(--primary-accent)]">{item.step}</span>
              <h4 class="text-sm font-bold text-[var(--text-color)]">{item.title}</h4>
              <p class="text-xs text-[var(--text-muted)]">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <SectionHeader eyebrow="FAQ" title="Parent & Student Questions" />
        <FAQ items={[
          { question: 'What is the batch size?', answer: 'We maintain small batches of 25-30 students to ensure personalized attention and effective doubt clearing.' },
          { question: 'Do you provide study material?', answer: 'Yes, comprehensive study material, practice sheets, and previous year papers are included in the fee.' },
          { question: 'Is there a demo class available?', answer: 'Yes, we offer 2 free demo classes for every program. Contact us to schedule your demo.' },
          { question: 'What are the class timings?', answer: 'Morning batches (6-8 AM), Evening batches (4-8 PM), and Weekend batches available. Flexible scheduling for board students.' },
          { question: 'Do you offer online classes?', answer: 'Yes, hybrid mode is available. Students can attend online or offline based on convenience.' },
        ]} />
      </div>
    </section>

    <!-- 7. Lead Capture -->
    <LeadCapture />

    <!-- 8. Enrollment -->
    <section id="std-c-enroll" class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-xl mx-auto px-4">
        <SectionHeader eyebrow="Enroll" title="Book a Free Counseling Session" />
        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Enquiry submitted! (Demo only)');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="coach-std-name" class="text-xs font-semibold text-[var(--text-color)]">Student Name</label><input id="coach-std-name" type="text" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500" placeholder="Student's Full Name" /></div>
            <div class="space-y-1.5"><label for="coach-std-phone" class="text-xs font-semibold text-[var(--text-color)]">Parent Phone</label><input id="coach-std-phone" type="tel" required class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500" placeholder="+91" /></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="coach-std-class" class="text-xs font-semibold text-[var(--text-color)]">Current Class</label>
              <select id="coach-std-class" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500">
                <option>Class 9</option><option>Class 10</option><option>Class 11</option><option>Class 12</option><option>Dropper</option>
              </select>
            </div>
            <div class="space-y-1.5"><label for="coach-std-interest" class="text-xs font-semibold text-[var(--text-color)]">Interested In</label>
              <select id="coach-std-interest" class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-blue-500">
                <option>JEE Foundation</option><option>JEE Main + Advanced</option><option>NEET</option><option>CBSE Board</option>
              </select>
            </div>
          </div>
          <button type="submit" class="w-full py-3.5 rounded-xl bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors">Submit Enquiry</button>
        </form>
        <p class="text-center text-[10px] text-[var(--text-muted)] mt-8">Standard Tier — Complete coaching website with programs, process, FAQ, and enrollment.</p>
      </div>
    </section>
  </div>

  <!-- PREMIUM — Multipage Experience -->
  <div id="tier-premium-content" class="tier-content-block hidden">
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/coaching-hero.jpg" alt="Premium coaching" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-t from-blue-950 via-blue-950/70 to-blue-950/40"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-32">
        <div class="max-w-2xl">
          <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 mb-8 uppercase tracking-widest backdrop-blur-sm">Premium Experience</span>
          <h2 class="hero-headline text-5xl md:text-7xl font-extrabold text-white tracking-tight font-display leading-[1.05]">Where Excellence Becomes Habit</h2>
          <p class="text-white/60 text-lg mt-8 leading-relaxed max-w-lg">A transformative academic journey with personalized mentorship, advanced resources, and a proven track record of creating toppers.</p>
          <div class="flex gap-4 mt-10">
            <a href="#prem-c-consult" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-blue-600 text-white hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/20">Book Consultation</a>
            <a href="#prem-c-programs" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-white/10 backdrop-blur-sm border border-white/20 text-white hover:bg-white/20 transition-all">Explore Programs</a>
          </div>
        </div>
      </div>
    </section>

    <section id="prem-c-programs" class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Programs" title="Comprehensive Academic Pathways" description="Detailed program structures designed for maximum academic impact." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { name: 'JEE Advanced Intensive', desc: 'Our flagship program for IIT aspirants. Covers complete JEE syllabus with advanced problem-solving workshops.', features: ['500+ Hours of Instruction', 'Personal Mentor Assigned', 'Mock Test Series (50+)', 'Doubt Resolution Within 2 Hours'], highlight: true },
            { name: 'NEET Excellence', desc: 'Comprehensive medical entrance preparation with biology lab access and NCERT-focused methodology.', features: ['Biology Lab Sessions', 'NCERT Complete Coverage', 'Previous Year Analysis', 'Weekly Parent Updates'] },
            { name: 'Board Topper Program', desc: 'For students targeting 95%+ in CBSE boards. Structured revision, sample papers, and exam technique training.', features: ['Chapter-wise Testing', 'Sample Paper Marathon', 'Answer Writing Practice', 'Flexible Scheduling'] },
            { name: 'Crash Course Programs', desc: 'Intensive short-term programs for last-minute preparation. Available for JEE, NEET, and Board exams.', features: ['30/45/60 Day Options', 'Revision Focused', 'Formula Sheets', 'Practice Sets'] },
          ].map(program => (
            <div class={`showcase-card p-6 rounded-2xl border ${program.highlight ? 'border-blue-500/30 bg-blue-500/5' : 'border-[var(--border-color)] bg-[var(--card-bg)]'} space-y-4 hover:-translate-y-1 transition-all duration-300`}>
              {program.highlight && <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-600 text-white uppercase">Flagship</span>}
              <h4 class="text-base font-bold text-[var(--text-color)]">{program.name}</h4>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed">{program.desc}</p>
              <div class="flex flex-wrap gap-2">
                {program.features.map(f => (<span class="text-[9px] font-bold px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 border border-blue-500/20">{f}</span>))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Transformation Stories -->
    <TransformationNarrative />

    <!-- 4. Authority & Methodology -->
    <AuthorityPresentation />

    <!-- 5. Faculty -->
    <section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Faculty" title="Our Expert Team" description="Experienced educators from premier institutions." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="rounded-3xl overflow-hidden border border-[var(--border-color)]">
            <img src="/images/coaching-faculty.png" alt="Faculty team" class="w-full h-80 object-cover" loading="lazy" />
          </div>
          <div class="space-y-5">
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Our faculty brings combined experience of 50+ years from premier institutions. Each teacher is subject-matter expert with proven track record of producing top rankers.</p>
            {[
              { title: 'IIT/NIT Alumni Faculty', desc: 'Physics and Mathematics taught by IIT graduates.' },
              { title: 'Medical College Professors', desc: 'Biology faculty with research and clinical experience.' },
              { title: 'Continuous Training', desc: 'Faculty undergoes regular pedagogical training.' },
            ].map(item => (
              <div class="flex gap-4">
                <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <div><h4 class="text-sm font-bold text-[var(--text-color)]">{item.title}</h4><p class="text-xs text-[var(--text-muted)]">{item.desc}</p></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Assessment Tool -->
    <AssessmentTool />

    <!-- 7. Consultation Booking -->
    <section id="prem-c-consult" class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-5xl mx-auto px-4">
        <SectionHeader eyebrow="Consultation" title="Start Your Journey" description="Three steps to academic excellence." />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          {[
            { step: '01', title: 'Free Assessment', desc: 'Diagnostic test to understand current academic standing.' },
            { step: '02', title: 'Counseling Session', desc: 'Discuss goals, recommend the right program and batch.' },
            { step: '03', title: 'Begin Learning', desc: 'Start classes with study material and mentor assignment.' },
          ].map(item => (
