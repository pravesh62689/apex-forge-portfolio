---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FAQ from '../../components/ui/FAQ.astro';
import Gallery from '../../components/ui/Gallery.astro';
import LookbookCarousel from '../../components/demos/salon/LookbookCarousel.astro';
import StylistBooking from '../../components/demos/salon/StylistBooking.astro';
import OffersPackages from '../../components/demos/salon/OffersPackages.astro';
import SalonFAQ from '../../components/demos/salon/SalonFAQ.astro';
import TransformationStories from '../../components/demos/salon/TransformationStories.astro';
import VirtualTour from '../../components/demos/salon/VirtualTour.astro';
import ProductShowcase from '../../components/demos/salon/ProductShowcase.astro';
---


<Base title="Glow & Style Salon — Salon & Hair Spa Niche Demo" description="Premium hair styling, nail art, makeup, and spa treatments. Glow & Style Salon in Noida." theme="salon">
  <!-- Demo Banner -->
  <div class="bg-[var(--primary-accent)]/10 border-b border-[var(--primary-accent)]/20 py-2.5 px-4 text-center text-xs font-semibold text-[var(--primary-accent)] z-40 relative select-none flex items-center justify-center gap-1.5">
    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
    <span>Sample Concept Demo — Select a tier tab to experience the visual and functional scaling.</span>
  </div>

  <div class="py-6 border-b border-[var(--border-color)] sticky top-20 z-30 backdrop-blur-md bg-[var(--bg-color)]/90">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold text-[var(--text-color)] font-display">Niche Preview: Salon & Hair Spa</h1>
        <p class="text-xs text-[var(--text-muted)]">Glow & Style Salon concept build</p>
      </div>
      <div class="flex bg-[var(--card-bg)] border border-[var(--border-color)] p-1 rounded-xl">
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-[var(--primary-accent)] text-white" data-tier="basic">Basic</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="standard">Standard</button>
        <button class="tier-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 text-[var(--text-muted)] hover:text-[var(--text-color)]" data-tier="premium">Premium</button>
      </div>
    </div>
  </div>

  <!-- ===== BASIC — 5 Sections ===== -->
  <div id="tier-basic-content" class="tier-content-block block">
    <section class="py-20 bg-[var(--bg-color)] relative overflow-hidden">
      <div class="absolute inset-0 opacity-15"><img src="/images/salon-hero.jpg" alt="" class="w-full h-full object-cover" /></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-color)] via-[var(--bg-color)]/80 to-[var(--bg-color)]"></div>
      <div class="max-w-3xl mx-auto px-4 text-center relative z-10 space-y-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] tracking-tight font-display">Glow & Style Salon</h2>
        <p class="text-[var(--text-muted)] text-base">Premium hair styling, nail art, makeup, and spa treatments in Noida.</p>
        <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Book Appointment</a>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-8 font-display">Our Services</h3>
        <div class="grid grid-cols-2 gap-4">
          {[
            { name: 'Haircut & Styling', price: 'From ₹500' },
            { name: 'Hair Color', price: 'From ₹1,500' },
            { name: 'Keratin Treatment', price: 'From ₹3,000' },
            { name: 'Manicure & Pedicure', price: 'From ₹800' },
            { name: 'Bridal Makeup', price: 'From ₹8,000' },
            { name: 'Facial & Spa', price: 'From ₹1,200' },
          ].map(item => (
            <div class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] flex justify-between items-center">
              <span class="text-sm font-medium text-[var(--text-color)]">{item.name}</span>
              <span class="text-xs font-bold text-[var(--primary-accent)]">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Our Work</h3>
        <div class="grid grid-cols-3 gap-3">
          <img src="/images/salon-styling.png" alt="Hair styling" class="rounded-xl h-32 w-full object-cover" loading="lazy" />
          <img src="/images/salon-nailart.png" alt="Nail art" class="rounded-xl h-32 w-full object-cover" loading="lazy" />
          <img src="/images/salon-interior.png" alt="Salon interior" class="rounded-xl h-32 w-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4">
        <h3 class="text-xl font-bold text-[var(--text-color)] mb-6 font-display">Starter Packages</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)]">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase">Glow Package</span>
            <h4 class="text-sm font-bold text-[var(--text-color)] mt-2">₹2,499</h4>
            <p class="text-xs text-[var(--text-muted)] mt-1">Haircut + Facial + Manicure</p>
          </div>
          <div class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)]">
            <span class="text-xs font-bold text-[var(--primary-accent)] uppercase">Style Package</span>
            <h4 class="text-sm font-bold text-[var(--text-color)] mt-2">₹4,999</h4>
            <p class="text-xs text-[var(--text-muted)] mt-1">Hair Color + Keratin + Blowdry</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-6">
        <h3 class="text-xl font-bold text-[var(--text-color)] font-display">Book Your Visit</h3>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="tel:+919999999999" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[var(--primary-accent)] text-white hover:opacity-90 transition-opacity">Call Now</a>
          <a href="https://wa.me/919999999999" target="_blank" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold border border-[var(--border-color)] text-[var(--text-color)] hover:bg-[var(--card-bg-hover)] transition-colors">WhatsApp</a>
        </div>
        <p class="text-[10px] text-[var(--text-muted)]">Basic Tier — Elegant single-page salon presence.</p>
      </div>
    </section>
  </div>

  <!-- ===== STANDARD — 8 Sections ===== -->
  <div id="tier-standard-content" class="tier-content-block hidden">
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/salon-hero.jpg" alt="Glow & Style Salon" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-[#161213]/90 via-[#161213]/60 to-transparent"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-24">
        <div class="max-w-xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30 mb-6 uppercase tracking-wider">Standard Demo</span>
          <h2 class="hero-headline text-4xl md:text-6xl font-extrabold text-white tracking-tight font-display leading-tight">Where Beauty Meets Artistry</h2>
          <p class="text-white/70 text-base mt-6">Expert stylists, premium products, and a luxurious experience that makes you feel extraordinary.</p>
          <div class="flex gap-3 mt-8">
            <a href="#std-s-book" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold bg-rose-600 text-white hover:bg-rose-700 transition-colors">Book Now</a>
            <a href="#std-s-services" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold border border-white/20 text-white hover:bg-white/10 transition-colors">Services</a>
          </div>
        </div>
      </div>
    </section>

    <section id="std-s-services" class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Services" title="Complete Beauty Menu" description="Expert treatments for hair, nails, skin, and more." />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { name: 'Hair Services', items: ['Haircut & Blowdry — ₹500', 'Hair Color — ₹1,500', 'Keratin Smoothing — ₹3,000', 'Hair Spa — ₹1,200'] },
            { name: 'Skin & Face', items: ['Classic Facial — ₹1,200', 'Gold Facial — ₹2,500', 'Anti-Aging Treatment — ₹3,500', 'Clean-Up — ₹800'] },
            { name: 'Nails', items: ['Manicure — ₹600', 'Pedicure — ₹800', 'Gel Nails — ₹1,500', 'Nail Art — ₹300/nail'] },
            { name: 'Makeup', items: ['Party Makeup — ₹3,000', 'Bridal Makeup — ₹8,000', 'Engagement Look — ₹5,000', 'HD Makeup — ₹4,000'] },
            { name: 'Spa & Wellness', items: ['Body Massage — ₹2,000', 'Hot Stone Therapy — ₹3,000', 'Aromatherapy — ₹2,500', 'Head Massage — ₹800'] },
            { name: 'Waxing & Threading', items: ['Full Body Wax — ₹2,000', 'Rica Waxing — ₹2,500', 'Eyebrow Threading — ₹100', 'Upper Lip — ₹80'] },
          ].map(cat => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4 hover:border-rose-500/20 transition-all duration-300">
              <h4 class="text-sm font-bold text-[var(--text-color)]">{cat.name}</h4>
              <ul class="space-y-2">
                {cat.items.map(item => (
                  <li class="text-xs text-[var(--text-muted)] flex justify-between">
                    <span>{item.split('—')[0]}</span>
                    <span class="font-semibold text-[var(--primary-accent)]">{item.split('—')[1]}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Our Team" title="Meet Our Stylists" description="Trained professionals with years of experience in premium styling." />
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {[
            { name: 'Lead Stylist', specialty: 'Hair Color & Cutting', exp: '8+ years' },
            { name: 'Senior Makeup Artist', specialty: 'Bridal & HD Makeup', exp: '6+ years' },
            { name: 'Nail Technician', specialty: 'Gel Nails & Nail Art', exp: '5+ years' },
          ].map(stylist => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] text-center space-y-3">
              <div class="w-20 h-20 mx-auto rounded-full bg-rose-500/10 border border-rose-500/20 flex items-center justify-center">
                <svg class="w-8 h-8 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
              </div>
              <h4 class="text-sm font-bold text-[var(--text-color)]">{stylist.name}</h4>
              <p class="text-xs text-[var(--primary-accent)] font-medium">{stylist.specialty}</p>
              <p class="text-[10px] text-[var(--text-muted)]">{stylist.exp} experience</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Gallery" title="Our Work Speaks" />
        <Gallery images={[
          { src: '/images/salon-styling.png', alt: 'Hair styling result', caption: 'Hair Transformation' },
          { src: '/images/salon-nailart.png', alt: 'Nail art designs', caption: 'Nail Art Collection' },
          { src: '/images/salon-interior.png', alt: 'Salon interior', caption: 'Our Space' },
          { src: '/images/salon-hero.jpg', alt: 'Styling in progress', caption: 'Expert Styling' },
          { src: '/images/salon-styling.png', alt: 'Color treatment', caption: 'Color Expertise' },
          { src: '/images/salon-interior.png', alt: 'Premium products', caption: 'Premium Products' },
        ]} columns={3} />
      </div>
    </section>

    <!-- Packages -->
    <OffersPackages />

    <!-- FAQ -->
    <SalonFAQ />


    <section id="std-s-book" class="py-20 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-xl mx-auto px-4">
        <SectionHeader eyebrow="Book" title="Schedule Your Visit" />
        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Appointment booked! (Demo only)');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="salon-std-name" class="text-xs font-semibold text-[var(--text-color)]">Your Name</label><input id="salon-std-name" type="text" required class="w-full bg-[var(--bg-color)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-rose-500" placeholder="Full Name" /></div>
            <div class="space-y-1.5"><label for="salon-std-phone" class="text-xs font-semibold text-[var(--text-color)]">Phone</label><input id="salon-std-phone" type="tel" required class="w-full bg-[var(--bg-color)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-rose-500" placeholder="+91" /></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5"><label for="salon-std-date" class="text-xs font-semibold text-[var(--text-color)]">Date</label><input id="salon-std-date" type="date" required class="w-full bg-[var(--bg-color)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-rose-500" /></div>
            <div class="space-y-1.5"><label for="salon-std-service" class="text-xs font-semibold text-[var(--text-color)]">Service</label>
              <select id="salon-std-service" class="w-full bg-[var(--bg-color)] border border-[var(--border-color)] rounded-xl p-3 text-sm text-[var(--text-color)] focus:outline-none focus:border-rose-500">
                <option>Haircut & Styling</option><option>Hair Color</option><option>Keratin Treatment</option><option>Facial</option><option>Bridal Makeup</option><option>Nail Art</option><option>Spa Package</option>
              </select>
            </div>
          </div>
          <button type="submit" class="w-full py-3.5 rounded-xl bg-rose-600 text-white text-sm font-bold hover:bg-rose-700 transition-colors">Book Appointment</button>
        </form>
        <p class="text-center text-[10px] text-[var(--text-muted)] mt-8">Standard Tier — Complete salon website with services, team, gallery, packages, and booking.</p>
      </div>
    </section>
  </div>

  <!-- ===== PREMIUM — Multipage Experience ===== -->
  <div id="tier-premium-content" class="tier-content-block hidden">
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0"><img src="/images/salon-hero.jpg" alt="Premium salon" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-gradient-to-t from-[#161213] via-[#161213]/60 to-[#161213]/30"></div></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 py-32">
        <div class="max-w-2xl">
          <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30 mb-8 uppercase tracking-widest backdrop-blur-sm">Premium Experience</span>
          <h2 class="hero-headline text-5xl md:text-7xl font-extrabold text-white tracking-tight font-display leading-[1.05]">Luxury Beauty, Redefined</h2>
          <p class="text-white/60 text-lg mt-8 leading-relaxed max-w-lg">An elevated beauty experience where every detail is curated for your transformation and confidence.</p>
          <div class="flex gap-4 mt-10">
            <a href="#prem-s-book" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-rose-600 text-white hover:bg-rose-700 transition-all shadow-xl shadow-rose-600/20">Book Experience</a>
            <a href="#prem-s-lookbook" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-sm font-bold bg-white/10 backdrop-blur-sm border border-white/20 text-white hover:bg-white/20 transition-all">View Lookbook</a>
          </div>
        </div>
      </div>
    </section>

    <section id="prem-s-lookbook" class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <LookbookCarousel />
      </div>
    </section>

    <section class="py-24 bg-[var(--card-bg)] border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4">
        <SectionHeader eyebrow="Services" title="Comprehensive Beauty Services" description="Detailed service categories with premium treatment options." />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { name: 'Hair Transformation', desc: 'From cuts to complete color transformations, our stylists create looks that enhance your natural beauty.', features: ['Precision Cuts', 'Balayage & Highlights', 'Keratin Smoothing', 'Olaplex Treatments'] },
            { name: 'Bridal & Occasion', desc: 'Complete bridal packages with trials, multiple looks, and a dedicated team for your special day.', features: ['HD & Airbrush Makeup', 'Hair Styling', 'Draping Assistance', 'Home Visit Available'] },
            { name: 'Skin & Wellness', desc: 'Advanced skincare treatments using medical-grade products for lasting results.', features: ['HydraFacial', 'Chemical Peels', 'LED Therapy', 'Anti-Aging Treatments'] },
            { name: 'Nail Artistry', desc: 'From classic manicures to elaborate nail art, our technicians deliver perfection.', features: ['Gel Extensions', 'Custom Nail Art', 'Dip Powder', 'Spa Pedicure'] },
          ].map(service => (
            <div class="showcase-card p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-color)] space-y-4 hover:border-rose-500/20 hover:-translate-y-1 transition-all duration-300">
              <h4 class="text-base font-bold text-[var(--text-color)]">{service.name}</h4>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed">{service.desc}</p>
              <div class="flex flex-wrap gap-2">
                {service.features.map(f => (
                  <span class="text-[9px] font-bold px-2.5 py-1 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20">{f}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="prem-s-book" class="py-24 bg-[var(--bg-color)] border-t border-[var(--border-color)]">
      <div class="max-w-5xl mx-auto px-4">
        <StylistBooking />
      </div>
    </section>

    <!-- Virtual Tour -->
    <VirtualTour />

    <!-- Product Showcase -->
    <ProductShowcase />

    <!-- Before & After Transformation Stories -->
    <TransformationStories />

  </div>

  <WhatsAppButton phone="919999999999" message="Hi Glow & Style, I'd like to book an appointment." floating={true} />
</Base>
