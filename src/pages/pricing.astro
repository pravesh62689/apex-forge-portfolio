---
import Base from '../layouts/Base.astro';
import PricingTable from '../components/PricingTable.astro';
---

<Base title="Pricing & Comparison — OMNI DIGITAL" description="Compare transparent website packages starting at ₹6,001 for local businesses in Noida & NCR. Detailed feature matrix and tier value comparison.">
  <section class="py-24 bg-ink-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Title Section -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          Simple, Fixed Pricing
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 font-display">Invest in a Site that Pays for Itself</h1>
        <p class="text-zinc-400 text-sm">No locked contracts, no template bloat, and zero monthly software template fees. You own 100% of your source code and files.</p>
      </div>

      <!-- Pricing Table -->
      <PricingTable />

      <!-- Support Retainer Callout -->
      <div class="max-w-3xl mx-auto mt-16 p-6 rounded-3xl border border-brand-accent/20 bg-brand-accent/5 text-center space-y-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-brand-accent/15 text-brand-accent border border-brand-accent/35 uppercase tracking-wide">
          Recurring Support
        </span>
        <h4 class="text-base font-bold text-white font-display">Optional Website Care Plan — ₹999/month</h4>
        <p class="text-xs text-zinc-400 max-w-xl mx-auto leading-relaxed">
          Need peace of mind? Cover all minor text updates, monthly uptime checks, fast photo changes, and security patches under one simple care subscription. Cancel anytime.
        </p>
      </div>

      <!-- Detailed Feature Comparison Matrix -->
      <div class="max-w-4xl mx-auto mt-28">
        <h2 class="text-2xl font-bold text-center text-white mb-12 font-display">Deep Feature Comparison</h2>
        
        <div class="overflow-x-auto rounded-3xl border border-ink-border bg-ink-900/20">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-ink-border bg-ink-900/60 text-zinc-400 font-bold uppercase tracking-wider">
                <th class="p-6">Feature Details</th>
                <th class="p-6 text-center">Basic (₹6,001)</th>
                <th class="p-6 text-center">Standard (₹10,000)</th>
                <th class="p-6 text-center">Premium (₹18,000+)</th>
              </tr>
            </thead>
            <tbody class="text-zinc-300 divide-y divide-ink-border font-sans">
              <!-- Site Structure -->
              <tr>
                <td class="p-5 font-semibold text-white">Site Layout & Pages</td>
                <td class="p-5 text-center text-zinc-400">1-Page High-speed Landing Page</td>
                <td class="p-5 text-center text-zinc-300">3-5 Sections/Subpages</td>
                <td class="p-5 text-center text-brand-primary font-semibold">Fully Segmented Multi-page</td>
              </tr>
              <!-- Visuals -->
              <tr>
                <td class="p-5 font-semibold text-white">Visual & Motion System</td>
                <td class="p-5 text-center text-zinc-500">Clean flat design (CSS reveals)</td>
                <td class="p-5 text-center text-zinc-300">Micro-reveal transitions</td>
                <td class="p-5 text-center text-brand-primary font-semibold">Layered GSAP Cinematic Motion</td>
              </tr>
              <!-- Optimization -->
              <tr>
                <td class="p-5 font-semibold text-white">Page Load Performance</td>
                <td class="p-5 text-center text-emerald-400">Sub-100ms Load Speed</td>
                <td class="p-5 text-center text-emerald-400">Sub-100ms Load Speed</td>
                <td class="p-5 text-center text-emerald-400 font-semibold">Sub-100ms Load Speed</td>
              </tr>
              <!-- Elements -->
              <tr>
                <td class="p-5 font-semibold text-white">Interactive Elements</td>
                <td class="p-5 text-center text-zinc-400">Direct WhatsApp / Call Buttons</td>
                <td class="p-5 text-center text-zinc-300">FAQ Accordion & Forms</td>
                <td class="p-5 text-center text-brand-primary font-semibold">Category-specific Booking Widget</td>
              </tr>
              <!-- SEO -->
              <tr>
                <td class="p-5 font-semibold text-white">Local SEO & Schema</td>
                <td class="p-5 text-center text-zinc-600">Basic Sitemap</td>
                <td class="p-5 text-center text-zinc-300">Structured Schema Markup</td>
                <td class="p-5 text-center text-brand-primary font-semibold">Full Local Authority SEO</td>
              </tr>
              <!-- Integrations -->
              <tr>
                <td class="p-5 font-semibold text-white">Integrations & Analytics</td>
                <td class="p-5 text-center text-zinc-600">None</td>
                <td class="p-5 text-center text-zinc-500">Basic Google Maps Embed</td>
                <td class="p-5 text-center text-brand-primary font-semibold">Google Analytics & pixel setup</td>
              </tr>
              <!-- Support -->
              <tr>
                <td class="p-5 font-semibold text-white">Post-Launch Support</td>
                <td class="p-5 text-center text-zinc-500">1 Week email support</td>
                <td class="p-5 text-center text-zinc-300">30 Days priority support</td>
                <td class="p-5 text-center text-brand-primary font-semibold">3 Months Premium Care</td>
              </tr>
              <!-- Cost -->
              <tr>
                <td class="p-5 font-semibold text-white">Hosting Fees</td>
                <td class="p-5 text-center text-emerald-400">₹0/mo forever</td>
                <td class="p-5 text-center text-emerald-400">₹0/mo forever</td>
                <td class="p-5 text-center text-emerald-400 font-semibold">₹0/mo forever</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Industry-specific Justification Grid -->
      <div class="max-w-4xl mx-auto mt-28">
        <h2 class="text-2xl font-bold text-center text-white mb-12 font-display">Which Tier Fits Your Industry?</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 font-sans">
          <!-- Item 1: Dentist -->
          <div class="demo-card p-6 rounded-3xl bg-ink-900/40 border border-ink-border space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
              <h3 class="text-base font-bold text-white">Dentist / Clinic</h3>
            </div>
            <p class="text-zinc-400 text-xs leading-relaxed">
              Medical practices require extreme trust. We recommend the <strong class="text-emerald-400">Standard Tier</strong> at minimum, which lets you show procedure explanations, clinic credentials, and patient FAQs to answer visitor objections before they book.
            </p>
          </div>
          
          <!-- Item 2: Salon -->
          <div class="demo-card p-6 rounded-3xl bg-ink-900/40 border border-ink-border space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21m0 0L8.187 15.9M9 21h8.25m-11.25 0H3m12-9a3.75 3.75 0 1 0-7.5 0 3.75 3.75 0 0 0 7.5 0Z" /></svg>
              <h3 class="text-base font-bold text-white">Salon & Styling</h3>
            </div>
            <p class="text-zinc-400 text-xs leading-relaxed">
              Salons sell visual results. A <strong class="text-pink-400">Basic Tier</strong> works well to launch with service menus, styling rates, and direct WhatsApp booking. Upgrading to <strong class="text-pink-400">Standard</strong> unlocks stylized transformations and stylist credentials.
            </p>
          </div>
          
          <!-- Item 3: Restaurant -->
          <div class="demo-card p-6 rounded-3xl bg-ink-900/40 border border-ink-border space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8M9 10v4M15 10v4" /></svg>
              <h3 class="text-base font-bold text-white">Restaurant & Cafe</h3>
            </div>
            <p class="text-zinc-400 text-xs leading-relaxed">
              Dining is an experience. We recommend the <strong class="text-amber-400">Premium Tier</strong> for flagship eateries wishing to show atmospheric parallax galleries, multi-category digital menu switchers, and customized table booking widgets.
            </p>
          </div>
          
          <!-- Item 4: Coaching -->
          <div class="demo-card p-6 rounded-3xl bg-ink-900/40 border border-ink-border space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <h3 class="text-base font-bold text-white">Coaching & Training</h3>
            </div>
            <p class="text-zinc-400 text-xs leading-relaxed">
              Coaching depends on proof of outcomes. We recommend the <strong class="text-indigo-400">Standard Tier</strong>, which provides the framework to lay out problem/solution timelines, courses outlines, FAQs, and a robust registration form.
            </p>
          </div>
        </div>
      </div>
      
      <!-- FAQ Section -->
      <div class="max-w-3xl mx-auto mt-28">
        <h2 class="text-2xl font-bold text-center text-white mb-12 font-display">Frequently Asked Questions</h2>
        
        <div class="space-y-6 font-sans">
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border">
            <h3 class="text-base font-semibold text-brand-primary mb-2">Are there any hidden monthly templates fees?</h3>
            <p class="text-zinc-400 text-xs leading-relaxed">No. Standard website agencies charge monthly fees to use their proprietary platforms. Because we engineer static websites deployed to Cloudflare Pages or Netlify, there are zero monthly platform or database hosting costs for static pages.</p>
          </div>
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border">
            <h3 class="text-base font-semibold text-brand-primary mb-2">What is your turnaround speed?</h3>
            <p class="text-zinc-400 text-xs leading-relaxed">Basic single-page sites take 2-4 days. Standard multi-section pages are ready in 4-7 days. Premium customized systems take 1-2 weeks depending on complex reservation forms or multi-page routing integration.</p>
          </div>
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border">
            <h3 class="text-base font-semibold text-brand-primary mb-2">Do you assist with domain registration?</h3>
            <p class="text-zinc-400 text-xs leading-relaxed">Yes. We walk you through purchasing your domain name under your own name (so you keep complete ownership). Setting up the domain name, configuring DNS, and linking the SSL certificate is covered in all tiers at no extra charge.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
