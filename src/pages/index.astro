---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Hero from '../components/Hero.astro';
import TrustGap from '../components/TrustGap.astro';
import SelectedWork from '../components/SelectedWork.astro';
import PricingTable from '../components/PricingTable.astro';
import AboutTrust from '../components/AboutTrust.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Base title="O M N I   D I G I T A L — Websites for Local Businesses in Noida" description="High-converting, lightning-fast, mobile-friendly websites that turn Google searchers into WhatsApp leads and customer calls. Delivery in under a week.">
  <script>
    import { initAnimations } from '../scripts/motion.js';
  </script>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Showcase Grid -->
  <section id="showcase" class="py-24 border-t border-ink-border bg-ink-950 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          Industry Showcase
        </span>
        <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-white mb-4 tracking-tight font-display">
          Industry-Specific Demo Sites
        </h2>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
          Click below to explore interactive concepts. We build tailored visual systems for each local business niche.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Niche 1: Restaurant (Flagship) -->
        <a href="/demos/restaurant-demo" class="showcase-card group block relative rounded-3xl overflow-hidden border border-ink-border bg-ink-900/30 backdrop-blur-md hover:border-brand-primary/30 hover:-translate-y-1.5 transition-all duration-300 shadow-xl hover:shadow-brand-primary/5">
          <div class="h-44 overflow-hidden relative select-none">
            <Image src="/images/restaurant-hero.jpg" alt="Restaurant Concept Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="250" format="webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent"></div>
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-amber-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8M9 10v4M15 10v4" /></svg>
              <span class="text-sm font-bold text-white tracking-tight group-hover:text-brand-primary transition-colors">Restaurant & Cafe</span>
            </div>
          </div>
          <div class="p-6 border-t border-ink-border">
            <span class="text-xs font-bold text-white block">Bistro 62 Noida</span>
            <p class="text-zinc-500 text-[11px] mt-1.5 leading-relaxed">Featuring tabbed category menus, CSS FAQs, and dynamic slot booking widget previews.</p>
          </div>
        </a>

        <!-- Niche 2: Dentist -->
        <a href="/demos/dentist-demo" class="showcase-card group block relative rounded-3xl overflow-hidden border border-ink-border bg-ink-900/30 backdrop-blur-md hover:border-brand-primary/30 hover:-translate-y-1.5 transition-all duration-300 shadow-xl hover:shadow-brand-primary/5">
          <div class="h-44 overflow-hidden relative select-none">
            <Image src="/images/dentist-hero.jpg" alt="Dentist Concept Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="250" format="webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent"></div>
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
              <span class="text-sm font-bold text-white group-hover:text-brand-primary transition-colors">Dentist / Clinic</span>
            </div>
          </div>
          <div class="p-6 border-t border-ink-border">
            <span class="text-xs font-bold text-white block">Noida Dental Care</span>
            <p class="text-zinc-500 text-[11px] mt-1.5 leading-relaxed">Featuring dental treatment tab switchers and a patient appointment reservation engine.</p>
          </div>
        </a>

        <!-- Niche 3: Salon -->
        <a href="/demos/salon-demo" class="showcase-card group block relative rounded-3xl overflow-hidden border border-ink-border bg-ink-900/30 backdrop-blur-md hover:border-brand-primary/30 hover:-translate-y-1.5 transition-all duration-300 shadow-xl hover:shadow-brand-primary/5">
          <div class="h-44 overflow-hidden relative select-none">
            <Image src="/images/salon-hero.jpg" alt="Salon Concept Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="250" format="webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent"></div>
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-pink-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21m0 0L8.187 15.9M9 21h8.25m-11.25 0H3m12-9a3.75 3.75 0 1 0-7.5 0 3.75 3.75 0 0 0 7.5 0Z" /></svg>
              <span class="text-sm font-bold text-white group-hover:text-brand-primary transition-colors">Salon & Hair Spa</span>
            </div>
          </div>
          <div class="p-6 border-t border-ink-border">
            <span class="text-xs font-bold text-white block">Glow & Style Salon</span>
            <p class="text-zinc-500 text-[11px] mt-1.5 leading-relaxed">Featuring pricing catalogs, beauty/styling tabs, and walk-in pass requests.</p>
          </div>
        </a>

        <!-- Niche 4: Coaching -->
        <a href="/demos/coaching-demo" class="showcase-card group block relative rounded-3xl overflow-hidden border border-ink-border bg-ink-900/30 backdrop-blur-md hover:border-brand-primary/30 hover:-translate-y-1.5 transition-all duration-300 shadow-xl hover:shadow-brand-primary/5">
          <div class="h-44 overflow-hidden relative select-none">
            <Image src="/images/coaching-hero.jpg" alt="Coaching Concept Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="250" format="webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent"></div>
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <span class="text-sm font-bold text-white group-hover:text-brand-primary transition-colors">Coaching Center</span>
            </div>
          </div>
          <div class="p-6 border-t border-ink-border">
            <span class="text-xs font-bold text-white block">Apex Coaching Noida</span>
            <p class="text-zinc-500 text-[11px] mt-1.5 leading-relaxed">Featuring class curriculum tags, parent advisory accordions, and student demo sheets.</p>
          </div>
        </a>

        <!-- Niche 5: Gym -->
        <a href="/demos/gym-demo" class="showcase-card group block relative rounded-3xl overflow-hidden border border-ink-border bg-ink-900/30 backdrop-blur-md hover:border-brand-primary/30 hover:-translate-y-1.5 transition-all duration-300 shadow-xl hover:shadow-brand-primary/5">
          <div class="h-44 overflow-hidden relative select-none">
            <Image src="/images/gym-hero.jpg" alt="Gym Concept Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="250" format="webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent"></div>
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>
              <span class="text-sm font-bold text-white group-hover:text-brand-primary transition-colors">Gym & Fitness</span>
            </div>
          </div>
          <div class="p-6 border-t border-ink-border">
            <span class="text-xs font-bold text-white block">Iron Strong Gym</span>
            <p class="text-zinc-500 text-[11px] mt-1.5 leading-relaxed">Featuring strength/cardio room guides, facility lists, and a free pass generation script.</p>
          </div>
        </a>
      </div>
      
      <!-- CTA for Section -->
      <div class="text-center mt-16 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="/demos" class="btn-magnetic inline-flex items-center gap-2 text-sm font-semibold text-brand-accent hover:text-brand-accent/90 transition-colors">
          View All 5 Demo Niches <span>→</span>
        </a>
        <span class="hidden sm:inline text-zinc-600">·</span>
        <a href="https://wa.me/919999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-white transition-colors">
          or ask for a custom concept on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- 3. The Trust Gap -->
  <TrustGap />
  <!-- CTA for Trust Gap -->
  <div class="text-center bg-ink-950 pb-12">
    <a href="/contact" class="btn-magnetic inline-flex items-center justify-center px-6 py-3 border border-ink-border hover:border-zinc-700 bg-ink-900 text-xs font-semibold text-zinc-300 rounded-xl transition-all">
      Let's Close Your Trust Gap Today ➔
    </a>
  </div>

  <!-- 4. Selected Work -->
  <SelectedWork />
  <!-- CTA for Selected Work -->
  <div class="text-center bg-ink-950 pb-12">
    <a href="https://wa.me/919999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs text-zinc-500 hover:text-white transition-colors">
      <span>Need complex server logic or WebSocket connections?</span>
      <span class="text-brand-accent font-bold">Chat with me on WhatsApp</span>
    </a>
  </div>

  <!-- 5. Tier Comparison (PricingTable) -->
  <section id="pricing-comparison" class="py-24 border-t border-ink-border bg-ink-950 relative z-10">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          Fair Packages
        </span>
        <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-white mb-4 tracking-tight font-display">
          Transparent, Fixed Pricing
        </h2>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
          No hidden fees or recurring subscriptions. Pay once, own your site forever.
        </p>
      </div>

      <PricingTable />
      
      <div class="text-center mt-12">
        <a href="/pricing" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-primary hover:text-brand-primary/80 transition-colors">
          View Detailed Pricing Breakdown <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. About / Trust Section -->
  <AboutTrust />
  <!-- CTA for About / Trust -->
  <div class="text-center bg-ink-950 pb-12">
    <a href="/contact" class="btn-magnetic inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-primary hover:bg-brand-primary/90 text-xs font-bold text-white rounded-xl shadow-lg shadow-brand-primary/15 transition-all">
      <svg class="w-4 h-4 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
      Hire an Engineer, Not a Reseller
    </a>
  </div>

  <!-- 7. Process Section -->
  <section id="process" class="py-24 border-t border-ink-border bg-ink-950 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          How We Work
        </span>
        <h2 class="text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-extrabold text-white mb-4 tracking-tight font-display">
          From Concept to Live Site in 3 Steps
        </h2>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
          We keep the process honest, clean, and collaborative. No weeks of empty delays.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="process-card p-8 rounded-3xl border border-ink-border bg-ink-900/50 space-y-4">
          <span class="text-2xl block text-brand-primary font-bold">01</span>
          <h4 class="text-base font-bold text-white">Understand Niche Needs</h4>
          <p class="text-xs text-zinc-400 leading-relaxed">
            We align on your services, location details, and call goals. I configure the design structures.
          </p>
        </div>
        <div class="process-card p-8 rounded-3xl border border-ink-border bg-ink-900/50 space-y-4">
          <span class="text-2xl block text-brand-primary font-bold">02</span>
          <h4 class="text-base font-bold text-white">Develop & Review</h4>
          <p class="text-xs text-zinc-400 leading-relaxed">
            I build your selected layout tier, link direct action buttons, and review copy options with you.
          </p>
        </div>
        <div class="process-card p-8 rounded-3xl border border-ink-border bg-ink-900/50 space-y-4">
          <span class="text-2xl block text-brand-accent font-bold">03</span>
          <h4 class="text-base font-bold text-white">Edge Distribution</h4>
          <p class="text-xs text-zinc-400 leading-relaxed">
            We hook up your domain, configure HTTPS security layers, and deploy to edge servers for sub-100ms speeds.
          </p>
        </div>
      </div>
      
      <!-- CTA for Process -->
      <div class="text-center mt-16">
        <a href="tel:+919999999999" class="btn-magnetic inline-flex items-center gap-2 text-xs font-semibold text-zinc-400 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
          <span>Got questions about the steps? Call: +91 99999 99999</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 8. Contact Section -->
  <section id="contact-home" class="py-24 border-t border-ink-border bg-ink-950 relative z-10">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-ink-900 border border-ink-border rounded-3xl p-8 lg:p-12 space-y-8 relative overflow-hidden">
        <div class="text-center space-y-2">
          <h3 class="text-2xl font-extrabold text-white tracking-tight font-display">Get a Free Quote today</h3>
          <p class="text-sm text-zinc-400">Let's discuss how we can build your Noida local business trust layer.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center pt-4">
          <!-- Left details -->
          <div class="space-y-6 text-sm text-zinc-300">
            <p>
              I usually reply within 2 hours. We can align over a call or over WhatsApp.
            </p>
            <div class="space-y-3 font-medium text-white">
              <p class="flex items-center gap-3">
                <svg class="w-4 h-4 text-brand-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.502-5.176-3.854-6.68-6.68l1.293-.97a1.242 1.242 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                <span>Call Directly: +91 6268935890</span>
              </p>
              <p class="flex items-center gap-3">
                <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91A2.25 2.25 0 0 1 2.25 6.994V6.75" /></svg>
                <span>Email: rathore.pravesh2002@gmail.com</span>
              </p>
            </div>
            <div>
              <WhatsAppButton phone="6268935890" message="Hi Pravesh, I'd like to get a quote for a local business website." />
            </div>
          </div>

          <!-- Mock Form -->
          <form class="space-y-4 text-xs" onsubmit="event.preventDefault(); alert('Message request submitted! (Demo only)');">
            <div class="space-y-1">
              <label for="contact-name" class="text-zinc-400 block font-medium">Your Name</label>
              <input id="contact-name" type="text" required class="w-full bg-zinc-950 border border-ink-border rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-primary" placeholder="Rahul Sen" />
            </div>
            <div class="space-y-1">
              <label for="contact-niche" class="text-zinc-400 block font-medium">Business Niche</label>
              <input id="contact-niche" type="text" required class="w-full bg-zinc-950 border border-ink-border rounded-lg p-2.5 text-white focus:outline-none" placeholder="Dentist Clinic Noida" />
            </div>
            <button type="submit" class="btn-magnetic w-full py-3 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold transition-all">
              Submit Inquiry
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
