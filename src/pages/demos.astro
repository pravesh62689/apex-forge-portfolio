---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
---

<Base title="Demo Galleries & Tiers — Pravesh Rathore" description="Check out our industry-specific mobile-friendly website templates for Noida dentists, salons, coaching centers, gyms, and cafes. Choose between Basic, Standard, or Premium tiers.">
  <section class="py-24 bg-ink-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Title Section -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          Showcase Matrix
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 font-display">Fully Functional Local Demos</h1>
        <p class="text-zinc-400 text-sm">Experience the real difference between service tiers. Click any industry below to inspect the interactive features, layouts, and responsive flow built for local businesses.</p>
      </div>

      <!-- Showcase Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- 1. Restaurant (Flagship) -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-6 flex flex-col hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
          <div class="h-48 rounded-2xl overflow-hidden mb-6 relative">
            <Image src="/images/restaurant-hero.jpg" alt="Restaurant & Cafe Showcase" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={400} height={250} />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
            <span class="absolute top-4 right-4 text-[9px] font-bold px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase font-sans tracking-wider">
              Standard Tier (Default)
            </span>
          </div>
          <span class="text-xs font-bold text-amber-400 uppercase tracking-wider font-sans">Restaurant & Cafe</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-0.5 font-display">Bistro 62</h3>
          <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold mb-4 block">Artisan Coffee & Gourmet Dining</span>
          <p class="text-zinc-400 text-xs mb-6 flex-grow leading-relaxed font-sans">Features category digital menu cards, ambiance gallery showcases, daily specials, and in-app reservation widget previews.</p>
          <a href="/demos/restaurant-demo" class="btn-magnetic block text-center py-3.5 text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white transition-colors">
            View Live Template
          </a>
        </div>

        <!-- 2. Dentist -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-6 flex flex-col hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
          <div class="h-48 rounded-2xl overflow-hidden mb-6 relative">
            <Image src="/images/dentist-hero.jpg" alt="Dentist & Medical Clinic Showcase" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={400} height={250} />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
            <span class="absolute top-4 right-4 text-[9px] font-bold px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase font-sans tracking-wider">
              Standard Tier (Default)
            </span>
          </div>
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-sans">Medical / Dentist</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-0.5 font-display">Noida Dental Care</h3>
          <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold mb-4 block">Modern Family Dentistry & Smile Designing</span>
          <p class="text-zinc-400 text-xs mb-6 flex-grow leading-relaxed font-sans">Features doctor expertise profiles, verified reviews, clinic timings, common procedure explainers, and interactive appointment forms.</p>
          <a href="/demos/dentist-demo" class="btn-magnetic block text-center py-3.5 text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white transition-colors">
            View Live Template
          </a>
        </div>

        <!-- 3. Salon -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-6 flex flex-col hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
          <div class="h-48 rounded-2xl overflow-hidden mb-6 relative">
            <Image src="/images/salon-hero.jpg" alt="Salon & Hair Spa Showcase" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={400} height={250} />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
            <span class="absolute top-4 right-4 text-[9px] font-bold px-2.5 py-1 rounded bg-pink-500/20 text-pink-300 border border-pink-500/30 uppercase font-sans tracking-wider">
              Standard Tier (Default)
            </span>
          </div>
          <span class="text-xs font-bold text-pink-400 uppercase tracking-wider font-sans">Salon & Styling</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-0.5 font-display">Nirvana Hair Salon</h3>
          <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold mb-4 block">Luxury Hair Styling & Organic Keratin Spa</span>
          <p class="text-zinc-400 text-xs mb-6 flex-grow leading-relaxed font-sans">Features styling service menus, stylist specialization cards, lookbooks, special packages, and direct booking CTA flow links.</p>
          <a href="/demos/salon-demo" class="btn-magnetic block text-center py-3.5 text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white transition-colors">
            View Live Template
          </a>
        </div>

        <!-- 4. Coaching -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-6 flex flex-col hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
          <div class="h-48 rounded-2xl overflow-hidden mb-6 relative">
            <Image src="/images/coaching-hero.jpg" alt="Coaching Center Showcase" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={400} height={250} />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
            <span class="absolute top-4 right-4 text-[9px] font-bold px-2.5 py-1 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 uppercase font-sans tracking-wider">
              Standard Tier (Default)
            </span>
          </div>
          <span class="text-xs font-bold text-indigo-400 uppercase tracking-wider font-sans">Coaching Center</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-0.5 font-display">Target Coaching</h3>
          <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold mb-4 block">Academic Excellence for CBSE & JEE Prep</span>
          <p class="text-zinc-400 text-xs mb-6 flex-grow leading-relaxed font-sans">Features course batch lists, registration layouts, doubt accordion queries, outcome stats, and parent feedback hooks.</p>
          <a href="/demos/coaching-demo" class="btn-magnetic block text-center py-3.5 text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white transition-colors">
            View Live Template
          </a>
        </div>

        <!-- 5. Gym -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-6 flex flex-col hover:border-brand-primary/20 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
          <div class="h-48 rounded-2xl overflow-hidden mb-6 relative">
            <Image src="/images/gym-hero.jpg" alt="Gym & Fitness Showcase" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={400} height={250} />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
            <span class="absolute top-4 right-4 text-[9px] font-bold px-2.5 py-1 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 uppercase font-sans tracking-wider">
              Standard Tier (Default)
            </span>
          </div>
          <span class="text-xs font-bold text-rose-400 uppercase tracking-wider font-sans">Gym & Fitness</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-0.5 font-display">Apex Fitness Club</h3>
          <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold mb-4 block">Elite Strength Training & Cardio Facility</span>
          <p class="text-zinc-400 text-xs mb-6 flex-grow leading-relaxed font-sans">Features gym membership tiers, facility listings, location guides, class schedules, trainer cards, and free trial request states.</p>
          <a href="/demos/gym-demo" class="btn-magnetic block text-center py-3.5 text-xs font-bold rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white transition-colors">
            View Live Template
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>
