---
import Base from '../layouts/Base.astro';
---

<Base title="Start Your Project — Pravesh Rathore" description="Ready to build your local business website? Fill out our form or click to message on WhatsApp. Noida & NCR.">
  <section class="py-24 bg-ink-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary block mb-3 font-sans">
          Get In Touch
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 font-display">Start Your Project</h1>
        <p class="text-zinc-400 text-sm">Have questions about setting up a high-performance website for your local business? Send a message and I'll reply within 2 hours.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Direct Info card -->
        <div class="demo-card bg-ink-900/40 border border-ink-border rounded-3xl p-8 flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold text-white mb-6 font-display">Contact Details</h2>
            
            <div class="space-y-6 text-zinc-300 font-sans">
              <div class="flex items-start gap-4">
                <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                <div>
                  <h4 class="font-semibold text-white text-sm">Location</h4>
                  <p class="text-xs text-zinc-400">Sector 62, Noida, UP (Delhi NCR)</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                <div>
                  <h4 class="font-semibold text-white text-sm">Email</h4>
                  <p class="text-xs text-zinc-400">rathore.pravesh2002@gmail.com</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.58c0-1.017.822-1.84 1.84-1.84h1.24c.469 0 .89.289 1.058.72l1.216 3.1c.148.377.069.801-.205 1.096L6.37 10.98a11.278 11.278 0 0 0 5.65 5.65l.93-1.033c.295-.274.718-.353 1.096-.205l3.1 1.216c.43.169.72.59.72 1.058v1.24c0 1.017-.822 1.84-1.84 1.84h-1.24a15.12 15.12 0 0 1-14.24-14.24V6.58Z" /></svg>
                <div>
                  <h4 class="font-semibold text-white text-sm">WhatsApp / Phone</h4>
                  <p class="text-xs text-zinc-400">+91 6268935890</p>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-8 border-t border-ink-border mt-12">
            <h3 class="text-white font-bold mb-4 text-sm font-display">Quick Interactive Chat</h3>
            <a 
              href="https://wa.me/919999999999?text=Hi%20Pravesh!%20I'm%20interested%20in%20a%20website%20for%20my%20local%20business." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-magnetic inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-xl font-bold bg-[#25D366] hover:bg-[#20ba56] text-white text-xs shadow-lg transition-colors"
            >
              Message on WhatsApp
            </a>
          </div>
        </div>

        <!-- Form Card -->
        <div class="demo-card bg-ink-900/20 border border-ink-border rounded-3xl p-8">
          <h2 class="text-2xl font-bold text-white mb-6 font-display">Inquiry Form</h2>
          
          <form class="space-y-6 text-xs font-sans" onsubmit="event.preventDefault(); alert('Message submitted successfully!');">
            <div>
              <label for="name" class="block text-zinc-400 mb-2 font-medium">Full Name</label>
              <input type="text" id="name" required class="w-full bg-ink-950 border border-ink-border focus:border-brand-primary rounded-xl px-4 py-3 text-white focus:outline-none" placeholder=" राहुल सिंह " />
            </div>
            
            <div>
              <label for="business-name" class="block text-zinc-400 mb-2 font-medium">Business Name & Location</label>
              <input type="text" id="business-name" required class="w-full bg-ink-950 border border-ink-border focus:border-brand-primary rounded-xl px-4 py-3 text-white focus:outline-none" placeholder="Singh Dental Clinic Noida Sector 62" />
            </div>

            <div>
              <label for="phone" class="block text-zinc-400 mb-2 font-medium">Phone Number</label>
              <input type="tel" id="phone" required class="w-full bg-ink-950 border border-ink-border focus:border-brand-primary rounded-xl px-4 py-3 text-white focus:outline-none" placeholder="+91 99999 99999" />
            </div>

            <div>
              <label for="message" class="block text-zinc-400 mb-2 font-medium">Tell me about your business needs</label>
              <textarea id="message" rows="4" class="w-full bg-ink-950 border border-ink-border focus:border-brand-primary rounded-xl px-4 py-3 text-white focus:outline-none" placeholder="I run a salon in Sector 18 and want a Standard tier page with categories and maps details..."></textarea>
            </div>

            <button type="submit" class="btn-magnetic w-full py-3.5 bg-brand-primary hover:bg-brand-primary/90 text-white font-bold rounded-xl shadow-lg transition-all duration-200">
              Submit Website Request
            </button>
          </form>
        </div>
      </div>

      <!-- What Happens Next Step-by-Step -->
      <div class="max-w-5xl mx-auto mt-24">
        <h2 class="text-2xl font-bold text-center text-white mb-12 font-display">What Happens Next?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xs font-sans text-zinc-400">
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border space-y-3">
            <span class="text-2xl font-bold text-brand-primary">01</span>
            <h3 class="font-bold text-white text-sm">Briefing & Strategy Call</h3>
            <p class="leading-relaxed">We schedule a 15-minute phone call to align on your niche, target customer actions, and specific service features.</p>
          </div>
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border space-y-3">
            <span class="text-2xl font-bold text-brand-primary">02</span>
            <h3 class="font-bold text-white text-sm">Custom Live Demo Creation</h3>
            <p class="leading-relaxed">We build a live, interactive draft demo tailored specifically to your branding and reviews to let you inspect before paying anything.</p>
          </div>
          <div class="process-card p-6 rounded-2xl bg-ink-900 border border-ink-border space-y-3">
            <span class="text-2xl font-bold text-brand-primary">03</span>
            <h3 class="font-bold text-white text-sm">Secure Deploy & Zero Hosting</h3>
            <p class="leading-relaxed">We set up your custom domain, hook up SSL security, and host your site forever for ₹0/month on Cloudflare Pages.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
