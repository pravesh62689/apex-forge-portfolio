---
import { ViewTransitions as ClientRouter } from "astro:transitions";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const {
  title = "APEX FORGE Technologies — Premium Web Solutions",
  description = "APEX FORGE Technologies: Building high-performance, futuristic websites and applications to elevate your business.",
  theme = "shell",
} = Astro.props;
---

<html lang="en" class="antialiased text-rendering-optimizeLegibility scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sora:wght@400;650;700;850&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Manrope:wght@400;600;700;800&family=Cormorant:ital,wght@0,300..700;1,300..700&family=Space+Grotesk:wght@400;500;600;700&family=Archivo+Black&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* Six visual identity color systems mapped to CSS variables */
      :root,
      .theme-shell {
        --bg-color: #0a0a0f;
        --card-bg: #12121a;
        --card-bg-hover: #1a1a24;
        --border-color: rgba(255, 255, 255, 0.08);
        --primary-accent: #06b6d4;
        --primary-glow: rgba(6, 182, 212, 0.15);
        --secondary-accent: #0891b2;
        --accent-glow: rgba(8, 145, 178, 0.1);
        --text-color: #f4f4f5;
        --text-muted: #a1a1aa;
        --display-font: "Sora";
        --particle-r: 6;
        --particle-g: 182;
        --particle-b: 212;
      }

      .theme-restaurant {
        --bg-color: #faf3e9;
        --card-bg: #ffffff;
        --card-bg-hover: #fdfbf7;
        --border-color: rgba(43, 33, 24, 0.08);
        --primary-accent: #c1542c;
        --primary-glow: rgba(193, 84, 44, 0.12);
        --secondary-accent: #b8860b;
        --accent-glow: rgba(184, 134, 11, 0.08);
        --text-color: #2b2118;
        --text-muted: #786253;
        --display-font: "Fraunces";
        --particle-r: 193;
        --particle-g: 84;
        --particle-b: 44;
      }

      .theme-dental {
        --bg-color: #f7fafc;
        --card-bg: #ffffff;
        --card-bg-hover: #edf2f7;
        --border-color: rgba(30, 58, 95, 0.08);
        --primary-accent: #0d9488;
        --primary-glow: rgba(13, 148, 136, 0.12);
        --secondary-accent: #1e3a5f;
        --accent-glow: rgba(30, 58, 95, 0.08);
        --text-color: #1f2937;
        --text-muted: #4b5563;
        --display-font: "Manrope";
        --particle-r: 13;
        --particle-g: 148;
        --particle-b: 136;
      }

      .theme-salon {
        --bg-color: #161213;
        --card-bg: #221c1d;
        --card-bg-hover: #2e2527;
        --border-color: rgba(243, 217, 217, 0.06);
        --primary-accent: #b76e79;
        --primary-glow: rgba(183, 110, 121, 0.12);
        --secondary-accent: #f3d9d9;
        --accent-glow: rgba(243, 217, 217, 0.08);
        --text-color: #f3d9d9;
        --text-muted: #c5a5a9;
        --display-font: "Cormorant";
        --particle-r: 183;
        --particle-g: 110;
        --particle-b: 121;
      }

      .theme-coaching {
        --bg-color: #fafafa;
        --card-bg: #ffffff;
        --card-bg-hover: #f3f4f6;
        --border-color: rgba(0, 0, 0, 0.06);
        --primary-accent: #2563eb;
        --primary-glow: rgba(37, 99, 235, 0.12);
        --secondary-accent: #f59e0b;
        --accent-glow: rgba(245, 158, 11, 0.08);
        --text-color: #1f2937;
        --text-muted: #4b5563;
        --display-font: "Space Grotesk";
        --particle-r: 37;
        --particle-g: 99;
        --particle-b: 235;
      }

      .theme-gym {
        --bg-color: #0f0f10;
        --card-bg: #1a1a1c;
        --card-bg-hover: #26262a;
        --border-color: rgba(255, 255, 255, 0.06);
        --primary-accent: #ff5a2d;
        --primary-glow: rgba(255, 90, 45, 0.15);
        --secondary-accent: #2b2b2d;
        --accent-glow: rgba(43, 43, 45, 0.1);
        --text-color: #f4f4f5;
        --text-muted: #a1a1aa;
        --display-font: "Archivo Black";
        --particle-r: 255;
        --particle-g: 90;
        --particle-b: 45;
      }

      :root {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
      }
      
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--display-font), "Inter", system-ui, sans-serif;
      }

      /* Premium custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-color);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--card-bg-hover);
        border: 2px solid var(--bg-color);
        border-radius: 99px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
      }

      /* Accessibility Focus Rings */
      *:focus-visible {
        outline: 2px solid var(--primary-accent);
        outline-offset: 4px;
        transition: outline-offset 0.2s ease;
      }

      /* Backdrop Grid Pattern + Spotlight */
      body {
        position: relative;
      }
      
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        background-size: 50px 50px;
        background-image:
          linear-gradient(to right, rgba(255, 255, 255, 0.012) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
        pointer-events: none;
      }
      
      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(
          800px circle at var(--x, 50%) var(--y, 50%),
          var(--primary-glow),
          transparent 50%
        );
        will-change: background;
      }

      /* GPU Accelerated Cursor Dot styling */
      .cursor-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--primary-accent);
        pointer-events: none;
        z-index: 9999;
        /* Using translate3d forces GPU hardware acceleration */
        transform: translate3d(-50%, -50%, 0); 
        will-change: transform, scale, background-color;
        mix-blend-mode: difference;
      }
      
      @media (hover: none) {
        .cursor-dot {
          display: none;
        }
      }

      /* ─── Cinematic View Transitions (Apple Style) ─── */
      ::view-transition-old(root) {
        animation: fade-out 0.4s cubic-bezier(0.32, 0.72, 0, 1) both;
      }
      ::view-transition-new(root) {
        animation: fade-in 0.4s cubic-bezier(0.32, 0.72, 0, 1) both;
      }
      
      @keyframes fade-out {
        from { opacity: 1; transform: scale(1); filter: blur(0); }
        to { opacity: 0; transform: scale(0.98); filter: blur(4px); }
      }
      
      @keyframes fade-in {
        from { opacity: 0; transform: scale(1.02); filter: blur(4px); }
        to { opacity: 1; transform: scale(1); filter: blur(0); }
      }
      
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }

      /* ─── Animated Hamburger Menu Button ─── */
      #mobile-menu-btn.active .line-1 {
        transform: translateY(7px) rotate(45deg);
      }
      #mobile-menu-btn.active .line-2 {
        opacity: 0;
        transform: translateY(-10px);
      }
      #mobile-menu-btn.active .line-3 {
        transform: translateY(-7px) rotate(-45deg);
      }

      #mobile-menu {
        transform: translateX(100%);
      }
      #mobile-menu.open {
        transform: translateX(0);
      }

      /* ─── Premium Nav Scroll Glass Effect ─── */
      header.sticky.nav-scrolled {
        backdrop-filter: blur(24px) saturate(180%);
        -webkit-backdrop-filter: blur(24px) saturate(180%);
        border-bottom: 1px solid var(--border-color);
        background-color: rgba(var(--bg-color), 0.7);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
      }
      
      header.sticky.nav-scrolled .logo-text {
        font-size: 1.1rem;
        transition: font-size 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* ─── Logo Breathing Glow ─── */
      .logo-glow {
        animation: logoBreath 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      }
      
      @keyframes logoBreath {
        0%, 100% { text-shadow: 0 0 0 transparent; }
        50% { text-shadow: 0 0 15px var(--primary-glow), 0 0 30px var(--accent-glow); }
      }

      /* ─── Interactive Spotlight Card Border ─── */
      .showcase-card,
      .capability-card,
      .pricing-card,
      .demo-card {
        --spotlight-x: 50%;
        --spotlight-y: 50%;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--border-color);
        background-color: var(--card-bg);
        transition: border-color 0.4s ease, background-color 0.4s ease;
      }
      
      .showcase-card::before,
      .capability-card::before,
      .pricing-card::before,
      .demo-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: radial-gradient(
          400px circle at var(--spotlight-x) var(--spotlight-y),
          var(--primary-glow),
          transparent 50%
        );
        opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
        z-index: 0;
      }
      
      .showcase-card:hover,
      .capability-card:hover,
      .pricing-card:hover,
      .demo-card:hover {
        border-color: rgba(255,255,255,0.15);
      }
      
      .showcase-card:hover::before,
      .capability-card:hover::before,
      .pricing-card:hover::before,
      .demo-card:hover::before {
        opacity: 1;
      }
      
      .showcase-card > *,
      .capability-card > *,
      .pricing-card > *,
      .demo-card > * {
        position: relative;
        z-index: 1;
      }

      .trust-gap {
        position: relative;
        z-index: 10;
      }

      /* Premium Floating WhatsApp Button */
      .whatsapp-fab {
        position: fixed;
        bottom: 32px;
        right: 32px;
        width: 56px;
        height: 56px;
        background-color: #25d366;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(37, 211, 102, 0.3);
        z-index: 1000;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
      }

      .whatsapp-fab::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 2px solid #25d366;
        opacity: 0;
        animation: pulsePremium 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      .whatsapp-fab:hover {
        transform: scale(1.08) translateY(-4px);
        box-shadow: 0 12px 32px rgba(37, 211, 102, 0.4);
      }
      
      .whatsapp-fab:hover::after {
        animation-play-state: paused;
        opacity: 0;
      }

      @keyframes pulsePremium {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.5); opacity: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .logo-glow, .whatsapp-fab::after {
          animation: none;
        }
      }
    </style>
  </head>
  <body
    class={`theme-${theme} bg-ink-950 text-themeText min-h-screen flex flex-col selection:bg-brand-primary selection:text-white relative`}
    data-motion-profile={theme}
  >
    <div class="cursor-dot"></div>

    <canvas
      id="particle-canvas"
      class="fixed inset-0 z-[-1] pointer-events-none opacity-60"
      aria-hidden="true"></canvas>

    <header class="sticky top-0 z-50 bg-transparent transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-2 group focus-visible:ring-2 focus-visible:ring-brand-primary rounded-md outline-none">
          <span class="logo-text logo-glow text-xl font-bold tracking-tight text-themeText hover:text-brand-primary transition-colors">
            APEX FORGE Technologies
          </span>
        </a>

        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-themeTextMuted" aria-label="Main Navigation">
          <a href="/" class="hover:text-themeText transition-colors duration-200 relative group py-2">
            Home
            <span class="absolute left-0 bottom-0 w-0 h-[2px] bg-brand-primary transition-all duration-300 group-hover:w-full rounded-full"></span>
          </a>
          <a href="/demos" class="hover:text-themeText transition-colors duration-200 relative group py-2">
            Demos
            <span class="absolute left-0 bottom-0 w-0 h-[2px] bg-brand-primary transition-all duration-300 group-hover:w-full rounded-full"></span>
          </a>
          <a href="/pricing" class="hover:text-themeText transition-colors duration-200 relative group py-2">
            Pricing
            <span class="absolute left-0 bottom-0 w-0 h-[2px] bg-brand-primary transition-all duration-300 group-hover:w-full rounded-full"></span>
          </a>
          <a href="/contact" class="hover:text-themeText transition-colors duration-200 relative group py-2">
            Contact
            <span class="absolute left-0 bottom-0 w-0 h-[2px] bg-brand-primary transition-all duration-300 group-hover:w-full rounded-full"></span>
          </a>
        </nav>

        <div class="flex items-center space-x-4">
          <a
            href="/contact"
            class="btn-magnetic hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-xl text-sm font-semibold bg-brand-primary hover:bg-brand-primary/90 text-white shadow-premium-md transition-all duration-300 relative overflow-hidden group focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-primary"
          >
            <span class="relative z-10">Get Started</span>
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"></span>
          </a>
          
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-lg text-themeTextMuted hover:text-themeText focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary z-50 relative w-10 h-10 flex items-center justify-center transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <div class="w-6 h-4 flex flex-col justify-between relative pointer-events-none">
              <span class="line-1 w-full h-[2px] bg-current rounded-full transition-all duration-300 origin-center"></span>
              <span class="line-2 w-full h-[2px] bg-current rounded-full transition-all duration-300"></span>
              <span class="line-3 w-full h-[2px] bg-current rounded-full transition-all duration-300 origin-center"></span>
            </div>
          </button>
        </div>
      </div>

      <div
        id="mobile-menu"
        class="fixed inset-y-0 right-0 z-40 w-full sm:w-80 bg-ink-950/98 backdrop-blur-2xl border-l border-ink-border md:hidden transition-transform duration-500 cubic-bezier(0.32, 0.72, 0, 1) flex flex-col justify-center px-8 space-y-8 shadow-2xl"
        role="dialog"
        aria-modal="true"
      >
        <a href="/" class="mobile-nav-link text-3xl font-semibold tracking-tight text-themeTextMuted hover:text-themeText transition-colors duration-200">Home</a>
        <a href="/demos" class="mobile-nav-link text-3xl font-semibold tracking-tight text-themeTextMuted hover:text-themeText transition-colors duration-200">Demos</a>
        <a href="/pricing" class="mobile-nav-link text-3xl font-semibold tracking-tight text-themeTextMuted hover:text-themeText transition-colors duration-200">Pricing</a>
        <a href="/contact" class="mobile-nav-link text-3xl font-semibold tracking-tight text-themeTextMuted hover:text-themeText transition-colors duration-200">Contact</a>
        <a href="/contact" class="mobile-nav-link block text-center px-4 py-4 rounded-2xl bg-brand-primary text-white font-bold shadow-premium-md hover:bg-brand-primary/90 transition-all mt-8 transform active:scale-95">
          Get Started
        </a>
      </div>
    </header>

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-ink-950 border-t border-ink-border pt-20 pb-12 text-sm text-themeTextMuted relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-primaryGlow rounded-full blur-[120px] pointer-events-none opacity-30"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
          <div class="space-y-6">
            <span class="text-lg font-bold tracking-tight text-themeText block">APEX FORGE Technologies</span>
            <p class="text-sm leading-relaxed max-w-xs text-zinc-400">
              Websites built with banking-grade engineering discipline. High-performance, secure, and fast loading layouts for local businesses in Noida & Delhi NCR.
            </p>
          </div>
          
          <div class="space-y-6">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-themeText font-display opacity-80">Navigation</h4>
            <ul class="space-y-3 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Home Page</a></li>
              <li><a href="/demos" class="hover:text-white transition-colors">Interactive Demos</a></li>
              <li><a href="/pricing" class="hover:text-white transition-colors">Pricing Packages</a></li>
              <li><a href="/contact" class="hover:text-white transition-colors">Start Project</a></li>
            </ul>
          </div>
          
          <div class="space-y-6">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-themeText font-display opacity-80">Live Templates</h4>
            <ul class="space-y-3 text-sm">
              <li><a href="/demos/dentist-demo" class="hover:text-white transition-colors">Dentist / Medical</a></li>
              <li><a href="/demos/salon-demo" class="hover:text-white transition-colors">Salon & Styling</a></li>
              <li><a href="/demos/restaurant-demo" class="hover:text-white transition-colors">Restaurant / Bistro</a></li>
              <li><a href="/demos/gym-demo" class="hover:text-white transition-colors">Gym & Fitness</a></li>
              <li><a href="/demos/coaching-demo" class="hover:text-white transition-colors">Coaching & Training</a></li>
            </ul>
          </div>
          
          <div class="space-y-6">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-themeText font-display opacity-80">Engineering Trust</h4>
            <p class="text-sm text-zinc-400 leading-relaxed">
              No bloated templates, no security vulnerabilities, and zero monthly software hosting fees. Deploying on modern static architecture.
            </p>
            <div class="pt-4">
              <a href="/contact" class="btn-magnetic inline-flex items-center justify-center px-5 py-2.5 bg-ink-900 border border-ink-border hover:border-brand-primary text-themeText hover:text-white font-medium text-sm rounded-xl shadow-sm transition-all duration-300">
                Book Free Consultation
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-ink-border/50 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-zinc-500">
             &copy; {new Date().getFullYear()} APEX FORGE Technologies. Noida, UP. All rights reserved.
          </p>
          <div class="flex space-x-8 text-sm text-zinc-500">
            <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/motion.js";
    </script>

    <a
      href="https://wa.me/YOUR_PHONE_NUMBER"
      class="whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact us on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="28" height="28" fill="white">
        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 .2c57.1 0 109.7 21.8 148.8 60.8 39.1 39.1 60.8 91.7 60.8 148.8 0 110.9-90.3 201.2-201.2 201.2h-.1c-34.9 0-68.6-9.2-99-26.5l-7.1-4.2-74.5 19.6 19.9-72.6-4.5-7.4c-18.5-30.7-28.2-66.5-28.2-103.3 0-110.9 90.3-201.2 201.2-201.2zM223.9 111.3c-65.5 0-118.5 53-118.5 118.5 0 21.2 5.6 41.5 15.9 59.4l4.4 7.6-12.1 44.1 45.1-11.8 7.3 4.3c17.1 10.1 36.4 15.3 56 15.3 65.5 0 118.5-53 118.5-118.5S289.4 111.3 223.9 111.3z"></path>
      </svg>
    </a>

    <script>
      (function () {
        const canvas = document.getElementById("particle-canvas");
        if (!canvas) return;
        const ctx = canvas.getContext("2d", { alpha: false }); // Opt: disable alpha for performance if bg is drawn, but here we overlay. Changed to default.
        if (!ctx) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          canvas.style.display = "none";
          return;
        }

        let w, h;
        let mouseX = -1000, mouseY = -1000;
        let particles = [];
        const MAX_PARTICLES = 40; // Lowered slightly for buttery INP
        const CONNECTION_DIST = 140;
        const MOUSE_DIST = 200;
        let animId;
        let resizeTimeout;

        function resize() {
          w = canvas.width = window.innerWidth;
          h = canvas.height = window.innerHeight;
        }
        resize();
        
        // Debounced resize to prevent layout thrashing
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(resize, 200);
        });

        window.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        }, { passive: true }); // passive flag for scrolling performance

        window.addEventListener("mouseleave", () => {
          mouseX = -1000;
          mouseY = -1000;
        }, { passive: true });

        // Cache colors to prevent CSS variable lookups in loop
        let cachedColor = null;
        function getThemeColor() {
          if (cachedColor) return cachedColor;
          const style = getComputedStyle(document.body);
          const r = parseInt(style.getPropertyValue("--particle-r").trim() || "6");
          const g = parseInt(style.getPropertyValue("--particle-g").trim() || "182");
          const b = parseInt(style.getPropertyValue("--particle-b").trim() || "212");
          cachedColor = { r, g, b };
          return cachedColor;
        }

        class Particle {
          constructor() {
            this.x = Math.random() * w;
            this.y = Math.random() * h;
            this.vx = (Math.random() - 0.5) * 0.2;
            this.vy = (Math.random() - 0.5) * 0.2;
            this.size = Math.random() * 1.5 + 0.5;
          }
          update() {
            this.x += this.vx;
            this.y += this.vy;
            if (this.x < 0 || this.x > w) this.vx *= -1;
            if (this.y < 0 || this.y > h) this.vy *= -1;
            
            const dx = mouseX - this.x;
            const dy = mouseY - this.y;
            const distSq = dx * dx + dy * dy; // Optimization: avoided Math.sqrt where possible
            
            if (distSq < MOUSE_DIST * MOUSE_DIST && distSq > 0) {
              const dist = Math.sqrt(distSq);
              this.vx += (dx / dist) * 0.015;
              this.vy += (dy / dist) * 0.015;
            }
            this.vx *= 0.99;
            this.vy *= 0.99;
          }
          draw(color) {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${color.r}, ${color.g}, ${color.b}, 0.4)`;
            ctx.fill();
          }
        }

        for (let i = 0; i < MAX_PARTICLES; i++) {
          particles.push(new Particle());
        }

        function animate() {
          ctx.clearRect(0, 0, w, h);
          const color = getThemeColor();

          particles.forEach(p => {
            p.update();
            p.draw(color);
          });

          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const distSq = dx * dx + dy * dy;
              
              if (distSq < CONNECTION_DIST * CONNECTION_DIST) {
                const dist = Math.sqrt(distSq);
                const alpha = (1 - dist / CONNECTION_DIST) * 0.15;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
              }
            }

            const dx2 = particles[i].x - mouseX;
            const dy2 = particles[i].y - mouseY;
            const dist2Sq = dx2 * dx2 + dy2 * dy2;
            
            if (dist2Sq < MOUSE_DIST * MOUSE_DIST) {
              const dist2 = Math.sqrt(dist2Sq);
              const alpha = (1 - dist2 / MOUSE_DIST) * 0.3;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(mouseX, mouseY);
              ctx.strokeStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
          animId = requestAnimationFrame(animate);
        }
        
        animate();

        document.addEventListener("astro:before-swap", () => {
          cancelAnimationFrame(animId);
          cachedColor = null; // Clear cache on theme switch
        });
        
        document.addEventListener("astro:page-load", () => {
          cachedColor = null; 
          resize();
          particles.forEach((p) => {
            p.x = Math.random() * w;
            p.y = Math.random() * h;
          });
          if (!animId) animate();
        });
      })();
    </script>
  </body>
</html>